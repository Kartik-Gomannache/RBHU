@model RBHU_DbServices.ViewModel.CategoryViewModel
@{
    ViewData["Title"] = "Abrasives - Bosch Klingspor Grinding Wheels Sandpaper | RBHU Solutions LLP";
}

<div class="page-content">
    <section class="section-padding" style="margin-top: 10px;">
        <div class="container">
            <!-- Header Section -->
            <div class="row mb-4">
                <div class="col-lg-12 text-center">
                    <h2 class="section-title" data-aos="fade-up">@Model.CategoryName</h2>
                    <p class="lead text-muted" data-aos="fade-up" data-aos-delay="100">
                        Professional-grade abrasive products for precision finishing and surface preparation
                    </p>
                </div>
            </div>

            <!-- Featured Brands Section - Centered at Top -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="brands-section">
                        <h3 class="brands-title">
                            <i class="fas fa-star me-2"></i>Featured Brands
                        </h3>
                        <div class="brands-grid" id="brandShowcase">
                            <!-- Bosch Brand -->
                            <div class="brand-card-modern" data-brand="Bosch" onclick="filterByBrand('Bosch')">
                                <div class="brand-image-wrapper">
                                    <img src="~/images/Product_Brands/Bosch.png"
                                         alt="Bosch Abrasives - Grinding Wheels, Cutting Discs by RBHU Solutions Goa"
                                         loading="lazy">
                                </div>
                                <div class="brand-label">Bosch</div>
                                <div class="brand-overlay">
                                    <i class="fas fa-search-plus"></i>
                                </div>
                            </div>

                            <!-- Klingspor Brand -->
                            <div class="brand-card-modern" data-brand="Klingspor" onclick="filterByBrand('Klingspor')">
                                <div class="brand-image-wrapper">
                                    <img src="~/images/Product_Brands/klingspor.jpg"
                                         alt="Klingspor Abrasives - Sandpaper, Sanding Belts, Polishing Products Goa"
                                         loading="lazy">
                                </div>
                                <div class="brand-label">Klingspor</div>
                                <div class="brand-overlay">
                                    <i class="fas fa-search-plus"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modern Filter Section - Sidebar Layout -->
            <div class="row">
                <!-- Sidebar Filter Section -->
                <div class="col-lg-3 col-md-4 mb-4">
                    <div class="filter-sidebar">
                        <div class="filter-header">
                            <h5 class="filter-title-sidebar">
                                <i class="fas fa-filter me-2"></i>Filter Products
                            </h5>
                            <button class="btn-reset-sidebar" onclick="clearFilters()">
                                <i class="fas fa-redo"></i> Reset
                            </button>
                        </div>

                        <!-- Quick Actions -->
                        <div class="filter-section">
                            <button class="filter-btn-full" onclick="showAllProducts()">
                                <i class="fas fa-th me-2"></i>All Products
                            </button>
                            <a class="filter-btn-full filter-btn-outline" asp-action="Products" asp-controller="Home">
                                <i class="fas fa-arrow-left me-2"></i>Go back to category page
                            </a>
                        </div>

                        <!-- Brand Filter Section -->
                        <div class="filter-section" id="brandShowcase">
                            <div class="filter-section-header">
                                <i class="fas fa-star me-2"></i>Brands
                            </div>
                            @if (Model.SubCategories1 != null && Model.SubCategories1.Any())
                            {
                                @foreach (var subCat1 in Model.SubCategories1)
                                {
                                    var subCat1Id = $"subcat1-{subCat1.Id}";
                                    var subCategories2 = Model.SubCategories2Map.ContainsKey(subCat1.Id)
                                    ? Model.SubCategories2Map[subCat1.Id]
                                    : new List<RBHU_DbServices.Models.SubCategory2>();

                                    <div class="brand-filter-item">
                                        <button class="brand-filter-btn"
                                                data-subcategory1-id="@subCat1.Id"
                                                data-brand-name="@subCat1.Name"
                                                data-has-subcat2="@(subCategories2.Any() ? "true" : "false")"
                                                onclick="toggleSubCategory1(@subCat1.Id, '@subCat1.Name')">
                                            <i class="fas fa-folder me-2"></i>
                                            <span>@subCat1.Name</span>
                                            @if (subCategories2 != null && subCategories2.Any())
                                            {
                                                <i class="fas fa-chevron-down ms-auto brand-arrow"></i>
                                            }
                                        </button>

                                        @if (subCategories2 != null && subCategories2.Any())
                                        {
                                            <div class="brand-subcategory-list" id="@subCat1Id" style="display: none;">
                                                @foreach (var subCat2 in subCategories2)
                                                {
                                                    <div class="brand-subcategory-item"
                                                         data-subcategory2-id="@subCat2.Id"
                                                         onclick="filterBySubCategory2(@subCat1.Id, @subCat2.Id, '@subCat1.Name', '@subCat2.Name')">
                                                        <i class="fas fa-caret-right me-2"></i>
                                                        <span>@subCat2.Name</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="no-categories-sidebar">
                                    <i class="fas fa-info-circle me-2"></i>No filters available
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Products Section -->
                <div class="col-lg-9 col-md-8">
                    <!-- Active Filter Badge -->
                    <div id="activeFilters" class="mb-3" style="display: @(Model.SelectedSubCategory1Id.HasValue || Model.SelectedSubCategory2Id.HasValue ? "block" : "none")">
                        <div class="active-filter-badge">
                            <i class="fas fa-filter me-2"></i>
                            <strong>Active Filter:</strong>
                            <span id="filterText" class="filter-value">
                                @if (Model.SelectedSubCategory2Id.HasValue)
                                {
                                    var subCat1 = Model.SubCategories1.FirstOrDefault(s => s.Id == Model.SelectedSubCategory1Id);
                                    var subCat2 = Model.SubCategories2Map.ContainsKey(Model.SelectedSubCategory1Id.Value)
                                    ? Model.SubCategories2Map[Model.SelectedSubCategory1Id.Value].FirstOrDefault(s => s.Id == Model.SelectedSubCategory2Id)
                                    : null;
                                    @($"{subCat1?.Name} → {subCat2?.Name}")
                                }
                                else if (Model.SelectedSubCategory1Id.HasValue)
                                {
                                    var subCat1 = Model.SubCategories1.FirstOrDefault(s => s.Id == Model.SelectedSubCategory1Id);
                                    @subCat1?.Name
                                }
                            </span>
                            <button class="filter-close" onclick="clearFilters()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Products Count -->
                    <div class="mb-3">
                        <div class="product-count-badge" id="productCount">
                            <i class="fas fa-box me-1"></i>
                            @Model.Products.Count Product@(Model.Products.Count != 1 ? "s" : "") Found
                        </div>
                    </div>

                    <!-- Loading Indicator -->
                    <div id="loadingIndicator" class="text-center py-5" style="display: none;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 text-muted">Loading products...</p>
                    </div>

                    <!-- Sample Products Grid (Shows 1 product per SubCategory2) -->
                    <div id="sampleProductsContainer" style="display: none;">
                        <h5 class="mb-4" id="sampleProductsTitle">
                            <i class="fas fa-th me-2"></i>Select a Collection
                        </h5>
                        <div id="sampleProductsGrid" class="row">
                            <!-- Sample products will be dynamically inserted here -->
                        </div>
                    </div>

                    <!-- Products Grid -->
                    <div id="productsGrid" class="row">
                        @if (Model.Products != null && Model.Products.Any())
                        {
                            @foreach (var product in Model.Products)
                            {
                                <div class="col-lg-4 col-md-6 col-sm-6 mb-4">
                                    <div class="product-card-modern">
                                        <div class="product-image-box">
                                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                                            {
                                                <img src="@product.ImageUrl"
                                                     alt="@product.Name - Abrasive Product by RBHU Solutions Goa"
                                                     onclick="GoToContact()"
                                                     loading="lazy">
                                            }
                                            else
                                            {
                                                <div class="no-image">
                                                    <i class="fas fa-image"></i>
                                                </div>
                                            }
                                    </div>

                                    <div class="product-info">
                                        <h6 class="product-name">@product.Name</h6>
                                        <p class="product-desc">
                                            @(string.IsNullOrEmpty(product.Description) ? "High-quality abrasive product." :
                                                                                    (product.Description.Length > 60 ? product.Description.Substring(0, 60) + "..." : product.Description))
                                    </p>
                                    <a asp-controller="Home" asp-action="Contact" class="product-btn">
                                        <i class="fas fa-phone me-1"></i>Enquire Now
                                    </a>
                                </div>
                            </div>
                        </div>
                                                }
                        }
                        else
                        {
                            <div class="col-12">
                                <div class="empty-state">
                                    <i class="fas fa-inbox"></i>
                                    <h4>No Products Available</h4>
                                    <p>No products found in this category.</p>
                                    <a asp-controller="Home" asp-action="Contact" class="btn-contact-us">
                                        <i class="fas fa-envelope me-2"></i>Contact Us
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Why Choose Section -->
            <div class="row mt-5 pt-4 border-top">
                <div class="col-lg-12">
                    <h4 class="text-center mb-4">Why Choose Our Abrasives?</h4>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="text-center feature-box">
                        <i class="fas fa-gem fa-2x text-secondary mb-3"></i>
                        <h6>Premium Quality</h6>
                        <p class="small text-muted">High-grade materials for superior cutting and finishing performance.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="text-center feature-box">
                        <i class="fas fa-clock fa-2x text-secondary mb-3"></i>
                        <h6>Long Lasting</h6>
                        <p class="small text-muted">Extended service life reduces downtime and replacement costs.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="text-center feature-box">
                        <i class="fas fa-chart-line fa-2x text-secondary mb-3"></i>
                        <h6>Consistent Results</h6>
                        <p class="small text-muted">Uniform grain distribution ensures predictable finishing quality.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="text-center feature-box">
                        <i class="fas fa-layer-group fa-2x text-secondary mb-3"></i>
                        <h6>Wide Range</h6>
                        <p class="small text-muted">Extensive selection of grits and types for every application.</p>
                    </div>
                </div>
            </div>

            <!-- CTA Section -->
            <div class="row mt-4">
                <div class="col-lg-12 text-center">
                    <div class="cta-box">
                        <h5>Need the Right Abrasive Solution?</h5>
                        <p class="text-muted mb-3">Our team can help you select the perfect abrasive for your application.</p>
                        <a asp-controller="Home" asp-action="Contact" class="btn btn-secondary me-2">
                            <i class="fas fa-phone me-2"></i>Contact Us
                        </a>
                        <a asp-controller="Home" asp-action="Products" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Go Back
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<link href="~/css/product-cards.css" rel="stylesheet" />

@section Scripts
{
    <script>
        const categoryId = @Model.CategoryId;
        let currentSubCategory1Id = @(Model.SelectedSubCategory1Id ?? 0);
        let currentSubCategory2Id = @(Model.SelectedSubCategory2Id ?? 0);
        let currentBrand = '';
        let showingSampleProducts = false;

        function GoToContact() {
            window.location.href = '/Home/Contact';
        }

        // ===== AUTO-DETECT AND HIGHLIGHT LOGIC =====
        $(document).ready(function () {
            console.log('=== Page Load - Auto-Detection ===');
            console.log('Current SubCat1 ID from Model:', currentSubCategory1Id);
            console.log('Current SubCat2 ID from Model:', currentSubCategory2Id);

            // Auto-expand and highlight if selected
            if (currentSubCategory1Id > 0) {
                const filterItem = $('[data-subcategory1-id="' + currentSubCategory1Id + '"]').closest('.brand-filter-item');

                if (filterItem.length > 0) {
                    const filterBtn = filterItem.find('.brand-filter-btn');
                    const arrow = filterItem.find('.brand-arrow');
                    const subcategoryList = filterItem.find('.brand-subcategory-list');

                    let brandName = filterBtn.data('brand-name');

                    // Expand dropdown and activate button
                    arrow.addClass('rotated');
                    subcategoryList.slideDown(300);
                    filterBtn.addClass('active');

                    currentBrand = brandName;

                    // Highlight brand card and show only selected brand
                    highlightBrand(brandName);
                    showOnlyBrand(brandName);

                    // Check if has SubCategory2
                    const hasSubCat2 = filterBtn.data('has-subcat2') === 'true' || filterBtn.data('has-subcat2') === true;

                    // Show sample products or all products based on hasSubCat2
                    if (hasSubCat2) {
                        if (currentSubCategory2Id > 0) {
                            // If SubCategory2 is selected, show all products for that SubCategory2
                            $('#sampleProductsContainer').hide();
                            $('#productsGrid').show();
                            loadProducts(categoryId, currentSubCategory1Id, currentSubCategory2Id);

                            // Highlight the selected SubCategory2
                            $('[data-subcategory2-id="' + currentSubCategory2Id + '"]').addClass('active');
                            const subCat2Text = $('[data-subcategory2-id="' + currentSubCategory2Id + '"] span').text().trim();
                            updateActiveFilter(brandName, subCat2Text);
                        } else {
                            // If only SubCategory1 is selected, show sample products
                            showSampleProducts(currentSubCategory1Id, brandName);
                        }
                    } else {
                        // No SubCategory2, show all products for SubCategory1
                        $('#sampleProductsContainer').hide();
                        $('#productsGrid').show();
                        loadProducts(categoryId, currentSubCategory1Id, null);
                        updateActiveFilter(brandName, null);
                    }

                    $('#activeFilters').show();

                    setTimeout(() => {
                        $('html, body').animate({
                            scrollTop: $('#brandShowcase').offset().top - 100
                        }, 500);
                    }, 300);
                }
            }
        });

        function highlightBrand(brandName) {
            $('.brand-card-modern').removeClass('active');
            if (brandName) {
                $('.brand-card-modern[data-brand="' + brandName + '"]').addClass('active');
            }
        }

        function showOnlyBrand(brandName) {
            const $brandCards = $('.brand-card-modern');

            if (!brandName || brandName === '') {
                // Show all brands
                $brandCards.show();
                $('.brand-card-modern').removeClass('active');
            } else {
                // Show only selected brand, hide others
                $brandCards.each(function () {
                    const cardBrand = $(this).data('brand');
                    if (cardBrand === brandName) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }
        }

        // Filter by brand button - Updated to handle sample products
        function filterByBrand(brandName) {
            console.log('=== Brand Button Clicked:', brandName);

            const filterBtn = $('[data-brand-name="' + brandName + '"]');

            if (filterBtn.length) {
                const subCat1Id = filterBtn.data('subcategory1-id');
                const hasSubCat2Data = filterBtn.data('has-subcat2');
                const hasSubCat2 = hasSubCat2Data === 'true' || hasSubCat2Data === true;
                const filterItem = filterBtn.closest('.brand-filter-item');
                const arrow = filterItem.find('.brand-arrow');
                const subcategoryList = filterItem.find('.brand-subcategory-list');

                console.log('SubCat1 ID:', subCat1Id, 'Has SubCat2:', hasSubCat2);

                // Close all other filters
                $('.brand-filter-item').not(filterItem).each(function () {
                    $(this).find('.brand-filter-btn').removeClass('active');
                    $(this).find('.brand-arrow').removeClass('rotated');
                    $(this).find('.brand-subcategory-list').hide();
                });

                // Open selected filter
                arrow.addClass('rotated');
                subcategoryList.slideDown(300);
                filterBtn.addClass('active');

                currentSubCategory1Id = subCat1Id;
                currentSubCategory2Id = 0;
                currentBrand = brandName;

                $('.brand-subcategory-item').removeClass('active');

                // Highlight brand card and show only selected brand
                highlightBrand(brandName);
                showOnlyBrand(brandName);

                // Show sample products or all products based on hasSubCat2
                if (hasSubCat2) {
                    console.log('Has SubCategory2 - showing sample products');
                    showingSampleProducts = true;
                    showSampleProducts(subCat1Id, brandName);
                } else {
                    console.log('No SubCategory2 - loading ALL products');
                    showingSampleProducts = false;
                    $('#sampleProductsContainer').hide();
                    $('#productsGrid').show();
                    updateActiveFilter(brandName, null);
                    loadProducts(categoryId, subCat1Id, null);
                }

                $('#activeFilters').show();
            }
        }

        function toggleSubCategory1(subCat1Id, subCat1Name) {
            console.log('=== toggleSubCategory1:', subCat1Id, subCat1Name);

            const filterItem = $(event.currentTarget).closest('.brand-filter-item');
            const filterBtn = filterItem.find('.brand-filter-btn');
            const arrow = filterItem.find('.brand-arrow');
            const subcategoryList = filterItem.find('.brand-subcategory-list');
            const hasSubCat2Data = filterBtn.data('has-subcat2');
            const hasSubCat2 = hasSubCat2Data === 'true' || hasSubCat2Data === true;
            const isExpanded = filterBtn.hasClass('active');

            console.log('Has SubCat2:', hasSubCat2, 'Is Expanded:', isExpanded);

            // Close all others
            $('.brand-filter-item').not(filterItem).each(function () {
                $(this).find('.brand-filter-btn').removeClass('active');
                $(this).find('.brand-arrow').removeClass('rotated');
                $(this).find('.brand-subcategory-list').slideUp(300);
            });

            $('.brand-subcategory-item').removeClass('active');

            if (!isExpanded) {
                // EXPAND
                arrow.addClass('rotated');
                subcategoryList.slideDown(300);
                filterBtn.addClass('active');

                currentSubCategory1Id = subCat1Id;
                currentSubCategory2Id = 0;
                currentBrand = subCat1Name;

                // Highlight brand card and show only selected brand
                highlightBrand(subCat1Name);
                showOnlyBrand(subCat1Name);

                $('#activeFilters').show();

                // Show sample products or all products based on hasSubCat2
                if (hasSubCat2) {
                    console.log('Has SubCategory2 - showing sample products');
                    showingSampleProducts = true;
                    showSampleProducts(subCat1Id, subCat1Name);
                } else {
                    console.log('No SubCategory2 - loading ALL products');
                    showingSampleProducts = false;
                    updateActiveFilter(subCat1Name, null);
                    $('#sampleProductsContainer').hide();
                    $('#productsGrid').show();
                    loadProducts(categoryId, subCat1Id, null);
                }
            } else {
                // COLLAPSE
                arrow.removeClass('rotated');
                subcategoryList.slideUp(300);
                filterBtn.removeClass('active');

                currentSubCategory1Id = 0;
                currentSubCategory2Id = 0;
                currentBrand = '';
                showingSampleProducts = false;

                // Remove brand card highlighting and show all brands
                highlightBrand('');
                showOnlyBrand('');

                $('#activeFilters').hide();
                $('#sampleProductsContainer').hide();
                $('#productsGrid').show();
                loadProducts(categoryId, null, null);
            }
        }

        // Show sample products (1 per SubCategory2) - EXPLORE MORE FUNCTIONALITY
        function showSampleProducts(subCat1Id, subCat1Name) {
            console.log('=== Loading Sample Products ===');
            console.log('SubCat1 ID:', subCat1Id, 'SubCat1 Name:', subCat1Name);

            // IMMEDIATELY hide products grid and show sample container
            $('#productsGrid').hide();
            $('#sampleProductsContainer').show();
            $('#sampleProductsTitle').html('<i class="fas fa-th me-2"></i>' + subCat1Name + ' Collections');

            // Show loading state in sample products grid
            const $grid = $('#sampleProductsGrid');
            $grid.html(`
                <div class="col-12 text-center py-5">
                    <div class="spinner-border text-secondary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 text-muted">Loading collections...</p>
                </div>
            `);

            $.ajax({
                url: '/Product/GetSampleProductsForSubCategories2',
                type: 'GET',
                data: { subCategory1Id: subCat1Id },
                success: function (response) {
                    console.log('Sample Products Response:', response);

                    $grid.empty();

                    if (response && response.length > 0) {
                        response.forEach(function (item) {
                            if (!item.product) {
                                console.warn('No product for SubCategory2:', item.subCategory2Name);
                                return;
                            }

                            const productImageHtml = item.product.imageUrl
                                ? `<img src="${item.product.imageUrl}"
                                       alt="${item.product.name} - ${item.subCategory2Name} Abrasive by RBHU Solutions Goa"
                                       loading="lazy">`
                                : `<div class="no-image"><i class="fas fa-image"></i></div>`;

                            const productDescription = item.product.description
                                ? (item.product.description.length > 60
                                    ? item.product.description.substring(0, 60) + '...'
                                    : item.product.description)
                                : 'Professional power tool for demanding applications.';

                            const cardHtml = `
                                <div class="col-lg-4 col-md-6 col-sm-6 mb-4">
                                    <div class="product-card-modern sample-product-card h-100">
                                        <div class="product-image-box">
                                            ${productImageHtml}
                                        </div>
                                        <div class="product-info">
                                            <div class="category-badge mb-2">
                                                <span class="badge bg-info">${item.subCategory2Name}</span>
                                            </div>
                                            <h6 class="product-name">${item.product.name}</h6>
                                            <p class="product-desc">
                                                ${productDescription}
                                            </p>
                                            <button class="product-btn w-100" onclick="exploreSubCategory(${subCat1Id}, ${item.subCategory2Id}, '${subCat1Name.replace(/'/g, "\\'")}', '${item.subCategory2Name.replace(/'/g, "\\'")}')">
                                                <i class="fas fa-arrow-right me-2"></i>Explore More
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            `;
                            $grid.append(cardHtml);
                        });

                        updateActiveFilter(subCat1Name, null);
                        updateProductCount(response.length);
                    } else {
                        $grid.html(`
                            <div class="col-12">
                                <div class="empty-state">
                                    <i class="fas fa-inbox"></i>
                                    <h4>No Collections Available</h4>
                                    <p>No product collections found for this category.</p>
                                </div>
                            </div>
                        `);
                        updateProductCount(0);
                    }

                    showingSampleProducts = true;
                },
                error: function (error) {
                    console.error('Error loading sample products:', error);
                    $grid.html(`
                        <div class="col-12">
                            <div class="empty-state">
                                <i class="fas fa-exclamation-triangle" style="color: #f56565;"></i>
                                <h4>Error Loading Collections</h4>
                                <p>Please try again later.</p>
                            </div>
                        </div>
                    `);
                }
            });
        }

        // Explore SubCategory - Show all products for that SubCategory2 - CORE EXPLORE MORE FUNCTION
        function exploreSubCategory(subCat1Id, subCat2Id, subCat1Name, subCat2Name) {
            console.log('=== Exploring SubCategory ===');
            console.log('SubCat1 ID:', subCat1Id, 'SubCat2 ID:', subCat2Id);
            console.log('SubCat1 Name:', subCat1Name, 'SubCat2 Name:', subCat2Name);

            currentSubCategory1Id = subCat1Id;
            currentSubCategory2Id = subCat2Id;
            currentBrand = subCat1Name;
            showingSampleProducts = false;

            // Hide sample products and show main products grid
            $('#sampleProductsContainer').hide();
            $('#productsGrid').show();

            // Update active filter display
            updateActiveFilter(subCat1Name, subCat2Name);

            // Load products for this SubCategory2
            loadProducts(categoryId, subCat1Id, subCat2Id);

            // Highlight the selected SubCategory2 option in dropdown
            $('.brand-subcategory-item').removeClass('active');
            $('[data-subcategory2-id="' + subCat2Id + '"]').addClass('active');

            // Keep brand highlighted and show only selected brand
            highlightBrand(subCat1Name);
            showOnlyBrand(subCat1Name);

            // Scroll to products
            setTimeout(() => {
                $('html, body').animate({
                    scrollTop: $('#productsGrid').offset().top - 100
                }, 500);
            }, 300);
        }

        function filterBySubCategory2(subCat1Id, subCat2Id, subCat1Name, subCat2Name) {
            console.log('=== filterBySubCategory2:', subCat2Id);

            currentSubCategory1Id = subCat1Id;
            currentSubCategory2Id = subCat2Id;
            currentBrand = subCat1Name;
            showingSampleProducts = false;

            $('.brand-subcategory-item').removeClass('active');
            $(event.currentTarget).addClass('active');

            $('#sampleProductsContainer').hide();
            $('#productsGrid').show();

            updateActiveFilter(subCat1Name, subCat2Name);
            loadProducts(categoryId, subCat1Id, subCat2Id);

            // Keep brand highlighted and show only selected brand
            highlightBrand(subCat1Name);
            showOnlyBrand(subCat1Name);
        }

        function showAllProducts() {
            console.log('=== Show All Products ===');

            currentSubCategory1Id = 0;
            currentSubCategory2Id = 0;
            currentBrand = '';
            showingSampleProducts = false;

            $('.brand-filter-item').each(function () {
                $(this).find('.brand-filter-btn').removeClass('active');
                $(this).find('.brand-arrow').removeClass('rotated');
                $(this).find('.brand-subcategory-list').slideUp(300);
            });

            $('.brand-subcategory-item').removeClass('active');

            // Remove brand card highlighting and show all brands
            highlightBrand('');
            showOnlyBrand('');

            $('#activeFilters').hide();
            $('#sampleProductsContainer').hide();
            $('#productsGrid').show();

            loadProducts(categoryId, null, null);
        }

        function loadProducts(catId, subCat1Id, subCat2Id) {
            console.log('=== Loading Products ===');
            console.log('Category ID:', catId, 'SubCat1:', subCat1Id, 'SubCat2:', subCat2Id);

            const $productsGrid = $('#productsGrid');
            const $loadingIndicator = $('#loadingIndicator');

            $productsGrid.hide();
            $loadingIndicator.show();

            $.ajax({
                url: '/Product/GetProductsByFilter',
                type: 'POST',
                data: {
                    categoryId: catId,
                    subCategory1Id: subCat1Id,
                    subCategory2Id: subCat2Id
                },
                success: function (response) {
                    console.log('Products loaded:', response.data ? response.data.length : 0);

                    $loadingIndicator.hide();
                    $('#sampleProductsContainer').hide();
                    $productsGrid.show();

                    if (response.success && response.data && response.data.length > 0) {
                        renderProducts(response.data);
                        updateProductCount(response.data.length);
                    } else {
                        $productsGrid.html(`
                            <div class="col-12">
                                <div class="empty-state">
                                    <i class="fas fa-inbox"></i>
                                    <h4>No Products Found</h4>
                                    <p>No products available for the selected filter.</p>
                                    <button class="btn-contact-us" onclick="clearFilters()">
                                        <i class="fas fa-redo me-2"></i>Show All Products
                                    </button>
                                </div>
                            </div>
                        `);
                        updateProductCount(0);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error loading products:', error);
                    $loadingIndicator.hide();
                    $productsGrid.show();
                    $productsGrid.html(`
                        <div class="col-12">
                            <div class="empty-state">
                                <i class="fas fa-exclamation-triangle" style="color: #f56565;"></i>
                                <h4>Error Loading Products</h4>
                                <p>Please try again later.</p>
                                <button class="btn-contact-us" onclick="loadProducts(${catId}, ${subCat1Id}, ${subCat2Id})">
                                    <i class="fas fa-redo me-2"></i>Retry
                                </button>
                            </div>
                        </div>
                    `);
                }
            });
        }

        function renderProducts(products) {
            const $grid = $('#productsGrid');
            $grid.empty();

            products.forEach(function (product) {
                const hasImage = product.imageUrl && product.imageUrl.trim() !== '';

                let imageHtml = hasImage
                    ? `<img src="${product.imageUrl}"
                           alt="${product.name} - Professional Abrasive Product Goa"
                           onclick="GoToContact()"
                           loading="lazy">`
                    : `<div class="no-image"><i class="fas fa-image"></i></div>`;

                const productHtml = `
                    <div class="col-lg-4 col-md-6 col-sm-6 mb-4">
                        <div class="product-card-modern">
                            <div class="product-image-box">
                                ${imageHtml}
                            </div>
                            <div class="product-info">
                                <h6 class="product-name">${product.name}</h6>
                                <p class="product-desc">${product.description ? (product.description.length > 60 ? product.description.substring(0, 60) + '...' : product.description) : 'Professional power tool for demanding applications.'}</p>
                                <a href="/Home/Contact" class="product-btn">
                                    <i class="fas fa-phone me-1"></i>Enquire Now
                                </a>
                            </div>
                        </div>
                    </div>
                `;

                $grid.append(productHtml);
            });
        }

        function updateProductCount(count) {
            $('#productCount').html(`<i class="fas fa-box me-1"></i>${count} Product${count !== 1 ? 's' : ''} Found`);
        }

        function updateActiveFilter(subCat1Name, subCat2Name) {
            let filterText = subCat1Name;
            if (subCat2Name) {
                filterText += ' → ' + subCat2Name;
            }
            $('#filterText').text(filterText);
            $('#activeFilters').show();
        }

        function clearFilters() {
            showAllProducts();
        }
    </script>

