@model RBHU_DbServices.ViewModel.CategoryViewModel
@{
    ViewData["Title"] = "Power Tools";
}

<div class="page-content">
    <section class="section-padding" style="margin-top: 80px;">
        <div class="container-fluid">
            <!-- Header Section -->
            <div class="row mb-4">
                <div class="col-lg-12 text-center">
                    <h2 class="section-title" data-aos="fade-up">@Model.CategoryName</h2>
                    <p class="lead text-muted" data-aos="fade-up" data-aos-delay="100">
                        Professional power tools for heavy-duty industrial applications
                    </p>
                </div>
            </div>

            <div class="row">
                <!-- Left Sidebar - Subcategory Tree -->
                <div class="col-lg-3 col-md-4 mb-4">
                    <div class="category-sidebar">
                        <div class="sidebar-header">
                            <h6 class="mb-0"><i class="fas fa-filter me-2"></i>Filter Products</h6>
                            <button class="btn btn-sm btn-link text-decoration-none" onclick="clearFilters()">
                                <i class="fas fa-redo"></i> Reset
                            </button>
                        </div>

                        <!-- Show All Products Button -->
                        <button class="btn btn-outline-secondary w-100 mb-3 btn-sm" onclick="showAllProducts()">
                            <i class="fas fa-th-large me-2"></i>All Products
                        </button>
                        <a class="btn btn-outline-secondary w-100 mb-3 btn-sm" asp-action="Products" asp-controller="Home">
                            <i class='fas fa-angle-left'></i> Go back to category page
                        </a>

                        <div class="subcategory-tree">
                            @if (Model.SubCategories1 != null && Model.SubCategories1.Any())
                            {
                                @foreach (var subCat1 in Model.SubCategories1)
                                {
                                    var subCat1Id = $"subcat1-{subCat1.Id}";
                                    var subCategories2 = Model.SubCategories2Map.ContainsKey(subCat1.Id)
                                    ? Model.SubCategories2Map[subCat1.Id]
                                    : new List<RBHU_DbServices.Models.SubCategory2>();

                                    <div class="category-level-1 mb-2">
                                        <!-- SubCategory1 Header -->
                                        <div class="category-header"
                                             data-subcategory1-id="@subCat1.Id"
                                             data-brand-name="@subCat1.Name"
                                             onclick="toggleSubCategory1(@subCat1.Id, '@Html.Raw(subCat1.Name.Replace("'", "\\'"))'); event.stopPropagation();">
                                            <div class="category-info">
                                                <i class="fas fa-folder me-2"></i>
                                                <span class="category-name">@subCat1.Name</span>
                                            </div>
                                            @if (subCategories2 != null && subCategories2.Any())
                                            {
                                                <i class="fas fa-chevron-down toggle-icon"></i>
                                            }
                                        </div>

                                        <!-- SubCategory2 Container (Collapsible) -->
                                        @if (subCategories2 != null && subCategories2.Any())
                                        {
                                            <div class="category-level-2" id="@subCat1Id" style="display: none;">
                                                @foreach (var subCat2 in subCategories2)
                                                {
                                                    <div class="subcategory2-item"
                                                         data-subcategory2-id="@subCat2.Id"
                                                         onclick="filterBySubCategory2(@subCat1.Id, @subCat2.Id, '@Html.Raw(subCat1.Name.Replace("'", "\\'"))', '@Html.Raw(subCat2.Name.Replace("'", "\\'"))'); event.stopPropagation();">
                                                        <i class="fas fa-circle me-2"></i>
                                                        <span>@subCat2.Name</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-light border">
                                    <small class="text-muted"><i class="fas fa-info-circle me-2"></i>No subcategories available</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Right Side - Products Grid -->
                <div class="col-lg-9 col-md-8">
                    <!-- Brand Images Section - CLICKABLE BUTTONS -->
                    <div class="brand-showcase mb-4" id="brandShowcase">
                        <h5 class="brand-showcase-title text-center mb-3">
                            <i class="fas fa-award me-2"></i>Featured Brands
                        </h5>
                        <div class="brand-container" id="brandContainer">
                            @using System.Text.Encodings.Web

                            @if (Model.SubCategories1 != null && Model.SubCategories1.Any())
                            {
                                foreach (var brand in Model.SubCategories1)
                                {
                                    var brandLower = brand.Name.ToLowerInvariant().Trim();

                                    var imageFileName = brandLower switch
                                    {
                                        "makita" => "Makita.jpg",
                                        "bosch" => "Bosch.jpg",
                                        _ => brand.Name.Replace(" ", "_") + ".jpg"
                                    };

                                    var brandImagePath = Url.Content($"~/images/Product_Brands/{imageFileName}");
                                    var safeBrandName = JavaScriptEncoder.Default.Encode(brand.Name);

                                    <div class="brand-item"
                                         data-brand="@brand.Name"
                                         data-brand-id="@brand.Id">

                                        <div class="brand-card"
                                             onclick="filterByBrand('@safeBrandName', @brand.Id)">

                                            <img src="@brandImagePath"
                                                 alt="@brand.Name Brand"
                                                 class="brand-logo" />

                                            <div class="brand-name">@brand.Name</div>
                                        </div>
                                    </div>
                                }
                            }

                            else
                            {
                                <div class="col-12 text-center">
                                    <p class="text-white-50">No brands available</p>
                                </div>
                            }`
                        </div>
                    </div>

                    <!-- Active Filter Display -->
                    <div id="activeFilters" class="mb-3" style="display: @(Model.SelectedSubCategory1Id.HasValue || Model.SelectedSubCategory2Id.HasValue ? "block" : "none")">
                        <div class="alert alert-light border d-flex justify-content-between align-items-center">
                            <small>
                                <i class="fas fa-filter me-2"></i>
                                <strong>Filtered by:</strong> <span id="filterText">
                                    @if (Model.SelectedSubCategory2Id.HasValue)
                                    {
                                        var subCat1 = Model.SubCategories1.FirstOrDefault(s => s.Id == Model.SelectedSubCategory1Id);
                                        var subCat2 = Model.SubCategories2Map.ContainsKey(Model.SelectedSubCategory1Id.Value)
                                        ? Model.SubCategories2Map[Model.SelectedSubCategory1Id.Value].FirstOrDefault(s => s.Id == Model.SelectedSubCategory2Id)
                                        : null;
                                        @($"{subCat1?.Name} → {subCat2?.Name}")
                                    }
                                    else if (Model.SelectedSubCategory1Id.HasValue)
                                    {
                                        var subCat1 = Model.SubCategories1.FirstOrDefault(s => s.Id == Model.SelectedSubCategory1Id);
                                        @subCat1?.Name
                                    }
                                </span>
                            </small>
                            <button class="btn btn-sm btn-link text-decoration-none" onclick="clearFilters()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Products Count -->
                    <div class="mb-3">
                        <small class="text-muted" id="productCount">
                            <i class="fas fa-box me-1"></i>
                            @Model.Products.Count Product@(Model.Products.Count != 1 ? "s" : "")
                        </small>
                    </div>

                    <!-- Loading Indicator -->
                    <div id="loadingIndicator" class="text-center py-5" style="display: none;">
                        <div class="spinner-border spinner-border-sm text-secondary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 text-muted small">Loading products...</p>
                    </div>

                    <!-- Products Grid -->
                    <div id="productsGrid" class="row">
                        @if (Model.Products != null && Model.Products.Any())
                        {
                            @foreach (var product in Model.Products)
                            {
                                <div class="col-lg-4 col-md-6 col-sm-6 mb-3">
                                    <div class="card product-card h-100">
                                        <div class="product-image-container">
                                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                                            {
                                                <img src="@product.ImageUrl" alt="@product.Name" class="card-img-top product-image" onclick="GoToContact()">
                                            }
                                            else
                                            {
                                                <div class="no-image-placeholder">
                                                    <i class="fas fa-tools fa-2x text-muted"></i>
                                                </div>
                                            }
                                        </div>

                                        <div class="card-body p-3">
                                            <h6 class="product-title">@product.Name</h6>
                                            <p class="product-description small text-muted mb-2">
                                                @(string.IsNullOrEmpty(product.Description) ? "Professional power tool for demanding applications." :
                                                    (product.Description.Length > 60 ? product.Description.Substring(0, 60) + "..." : product.Description))
                                            </p>

                                            <div class="d-flex justify-content-between align-items-center">
                                               
                                                <a asp-controller="Home" asp-action="Contact" class="btn btn-sm btn-outline-secondary">
                                                    <i class="fas fa-phone"></i> Enquire
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center py-5">
                                <i class="fas fa-tools fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">No Products Available</h5>
                                <p class="text-muted">No products found in this category.</p>
                                <a asp-controller="Home" asp-action="Contact" class="btn btn-secondary">
                                    <i class="fas fa-envelope me-2"></i>Contact Us
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Features Section -->
            <div class="row mt-5 pt-4 border-top">
                <div class="col-lg-12">
                    <h4 class="text-center mb-4">Why Choose Our Power Tools?</h4>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="text-center">
                        <i class="fas fa-battery-full fa-2x text-secondary mb-3"></i>
                        <h6>Long Battery Life</h6>
                        <p class="small text-muted">Extended runtime with advanced lithium-ion technology.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="text-center">
                        <i class="fas fa-tachometer-alt fa-2x text-secondary mb-3"></i>
                        <h6>High Performance</h6>
                        <p class="small text-muted">Powerful motors deliver exceptional cutting and drilling performance.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="text-center">
                        <i class="fas fa-shield-alt fa-2x text-secondary mb-3"></i>
                        <h6>Built to Last</h6>
                        <p class="small text-muted">Rugged construction withstands demanding jobsite conditions.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="text-center">
                        <i class="fas fa-wrench fa-2x text-secondary mb-3"></i>
                        <h6>Easy Maintenance</h6>
                        <p class="small text-muted">User-serviceable parts and readily available accessories.</p>
                    </div>
                </div>
            </div>

            <!-- CTA Section -->
            <div class="row mt-4">
                <div class="col-lg-12 text-center">
                    <div class="bg-light p-4 rounded border">
                        <h5>Looking for the Right Power Tool?</h5>
                        <p class="text-muted mb-3">Our team can help you select the best tool for your specific needs.</p>
                        <a asp-controller="Home" asp-action="Contact" class="btn btn-secondary me-2">
                            <i class="fas fa-phone me-2"></i>Contact Us
                        </a>
                        <a asp-controller="Home" asp-action="Products" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Go Back
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<link href="~/css/product-cards.css" rel="stylesheet" />

@section Scripts {
<script>
    const categoryId = @Model.CategoryId;
    let currentSubCategory1Id = @(Model.SelectedSubCategory1Id ?? 0);
    let currentSubCategory2Id = @(Model.SelectedSubCategory2Id ?? 0);
    let currentBrand = '';

    // Brand to SubCategory1 mapping (Update ID according to your database)
    const brandToSubCategoryMap = {
        'Makita': { name: 'Makita', displayName: 'Makita', id: 4 }
    };

        function GoToContact() {
            window.location.href = '/Home/Contact';
        }

    // ===== AUTO-DETECT AND HIGHLIGHT LOGIC =====
    $(document).ready(function () {
        console.log('=== Page Load - Auto-Detection ===');
        console.log('Current SubCat1 ID from Model:', currentSubCategory1Id);
        console.log('Current SubCat2 ID from Model:', currentSubCategory2Id);
        console.log('Category ID:', categoryId);

        // Auto-expand and highlight brand if selected
        if (currentSubCategory1Id > 0) {
            console.log('Attempting to auto-expand SubCategory1 ID:', currentSubCategory1Id);

            const element = $('[data-subcategory1-id="' + currentSubCategory1Id + '"]');
            console.log('Found elements:', element.length);

            if (element.length > 0) {
                const parent = element.closest('.category-level-1');
                const toggleIcon = parent.find('.toggle-icon');
                const subCat2Container = parent.find('.category-level-2');

                let brandName = element.data('brand-name');
                if (!brandName) {
                    brandName = element.find('.category-name').text().trim();
                }

                console.log('Brand Name:', brandName);

                // Expand the subcategory
                toggleIcon.addClass('rotated');
                subCat2Container.slideDown(300);
                parent.addClass('active');

                // Update state
                currentBrand = brandName;

                // Highlight and show only this brand
                highlightBrand(brandName);
                showOnlyBrand(brandName);

                // Show filter info
                if (currentSubCategory2Id > 0) {
                    const subCat2Element = $('[data-subcategory2-id="' + currentSubCategory2Id + '"]');
                    if (subCat2Element.length > 0) {
                        const subCat2Name = subCat2Element.find('span').text().trim();
                        updateActiveFilter(brandName, subCat2Name);
                    } else {
                        updateActiveFilter(brandName, null);
                    }
                } else {
                    updateActiveFilter(brandName, null);
                }

                $('#activeFilters').show();

                // Scroll to products section
                setTimeout(() => {
                    $('html, body').animate({
                        scrollTop: $('#brandShowcase').offset().top - 100
                    }, 500);
                }, 300);

                console.log('Auto-expansion completed successfully');
            }
        }

        // Highlight SubCategory2 if selected
        if (currentSubCategory2Id > 0) {
            console.log('Highlighting SubCategory2 ID:', currentSubCategory2Id);
            $('[data-subcategory2-id="' + currentSubCategory2Id + '"]').addClass('active');
        }
    });

        // Filter by brand button - shows products/samples immediately
        function filterByBrand(brandName) {
            console.log('=== Brand Button Clicked ===');
            console.log('Brand clicked:', brandName);

        const subCat1Element = $('[data-brand-name="' + brandName + '"]');
        console.log('SubCat1 Element found:', subCat1Element.length);

        if (subCat1Element.length) {
            const subCat1Id = subCat1Element.data('subcategory1-id');
            console.log('SubCategory1 ID:', subCat1Id);

            // Close all other subcategories first
            $('.category-level-1').each(function () {
                const $this = $(this);
                if ($this.find('[data-subcategory1-id="' + subCat1Id + '"]').length === 0) {
                    $this.find('.toggle-icon').removeClass('rotated');
                    $this.find('.category-level-2').hide();
                    $this.removeClass('active');
                }
            });

            // Open the selected subcategory
            const parent = subCat1Element.closest('.category-level-1');
            const toggleIcon = parent.find('.toggle-icon');
            const subCat2Container = parent.find('.category-level-2');

            toggleIcon.addClass('rotated');
            subCat2Container.slideDown(300);
            parent.addClass('active');

            // Update state
            currentSubCategory1Id = subCat1Id;
            currentSubCategory2Id = 0;
            currentBrand = brandName;

            // Clear subcategory2 selections
            $('.subcategory2-item').removeClass('active');

            // Highlight only this brand
            highlightBrand(brandName);
            showOnlyBrand(brandName);

            // Update filter text
            updateActiveFilter(brandInfo.displayName, null);

            // Load products
            loadProducts(categoryId, subCat1Id, null);

            console.log('Brand filter applied successfully');
        }
    }

    // Highlight selected brand button
    function highlightBrand(brandName) {
        console.log('Highlighting brand:', brandName);
        $('.brand-card').removeClass('active');
        if (brandName) {
            $('.brand-item[data-brand="' + brandName + '"] .brand-card').addClass('active');
        }
    }

    // Show only selected brand
    function showOnlyBrand(brandName) {
        console.log('Showing brand(s):', brandName || 'ALL');
        const $brandItems = $('.brand-item');

        if (!brandName || brandName === '') {
            $brandItems.show();
            $('.brand-card').removeClass('active');
        } else {
            $brandItems.each(function () {
                const $item = $(this);
                const itemBrand = $item.data('brand');
                if (itemBrand === brandName) {
                    $item.show();
                } else {
                    $item.hide();
                }
            });
        }
    }

    // Toggle SubCategory1
    function toggleSubCategory1(subCat1Id, subCat1Name) {
        console.log('=== toggleSubCategory1 Called ===');
        console.log('SubCat1 ID:', subCat1Id);
        console.log('SubCat1 Name:', subCat1Name);

        const element = $(event.currentTarget);
        const parent = element.closest('.category-level-1');
        const toggleIcon = parent.find('.toggle-icon');
        const subCat2Container = parent.find('.category-level-2');

        const isCurrentlyExpanded = parent.hasClass('active');
        console.log('Is currently expanded?', isCurrentlyExpanded);

        // Close all other subcategories
        $('.category-level-1').not(parent).each(function () {
            $(this).find('.toggle-icon').removeClass('rotated');
            $(this).find('.category-level-2').slideUp(300);
            $(this).removeClass('active');
        });

        // Clear all subcategory2 active states
        $('.subcategory2-item').removeClass('active');

        if (!isCurrentlyExpanded) {
            // EXPAND: Open this subcategory
            console.log('EXPANDING subcategory');

            toggleIcon.addClass('rotated');
            subCat2Container.slideDown(300);
            parent.addClass('active');

            currentSubCategory1Id = subCat1Id;
            currentSubCategory2Id = 0;
            currentBrand = subCat1Name;

            updateActiveFilter(subCat1Name, null);
            loadProducts(categoryId, subCat1Id, null);

            highlightBrand(subCat1Name);
            showOnlyBrand(subCat1Name);
        } else {
            // COLLAPSE: Close this subcategory
            console.log('COLLAPSING subcategory');

            toggleIcon.removeClass('rotated');
            subCat2Container.slideUp(300);
            parent.removeClass('active');

            currentSubCategory1Id = 0;
            currentSubCategory2Id = 0;
            currentBrand = '';
            $('#activeFilters').hide();
            loadProducts(categoryId, null, null);

            showOnlyBrand('');
        }
    }

    function filterBySubCategory2(subCat1Id, subCat2Id, subCat1Name, subCat2Name) {
        console.log('=== filterBySubCategory2 Called ===');
        console.log('SubCat2 ID:', subCat2Id);

        currentSubCategory1Id = subCat1Id;
        currentSubCategory2Id = subCat2Id;
        currentBrand = subCat1Name;

        $('.subcategory2-item').removeClass('active');
        $(event.currentTarget).addClass('active');

        updateActiveFilter(subCat1Name, subCat2Name);
        loadProducts(categoryId, subCat1Id, subCat2Id);

        highlightBrand(subCat1Name);
        showOnlyBrand(subCat1Name);
    }

    function showAllProducts() {
        console.log('=== Show All Products ===');

        currentSubCategory1Id = 0;
        currentSubCategory2Id = 0;
        currentBrand = '';

        $('.category-level-1').each(function () {
            $(this).find('.toggle-icon').removeClass('rotated');
            $(this).find('.category-level-2').slideUp(300);
            $(this).removeClass('active');
        });

        $('.subcategory2-item').removeClass('active');
        $('#activeFilters').hide();

        loadProducts(categoryId, null, null);
        showOnlyBrand('');
    }

    function loadProducts(catId, subCat1Id, subCat2Id) {
        console.log('=== Loading Products ===');
        console.log('Category ID:', catId);
        console.log('SubCategory1 ID:', subCat1Id);
        console.log('SubCategory2 ID:', subCat2Id);

        const $productsGrid = $('#productsGrid');
        const $loadingIndicator = $('#loadingIndicator');

        $productsGrid.hide();
        $loadingIndicator.show();

        $.ajax({
            url: '/Product/GetProductsByFilter',
            type: 'POST',
            data: {
                categoryId: catId,
                subCategory1Id: subCat1Id,
                subCategory2Id: subCat2Id
            },
            success: function (response) {
                console.log('Products loaded successfully:', response.data ? response.data.length : 0);

                $loadingIndicator.hide();
                $productsGrid.show();

                if (response.success && response.data && response.data.length > 0) {
                    renderProducts(response.data);
                    updateProductCount(response.data.length);
                } else {
                    $productsGrid.html(`
                        <div class="col-12 text-center py-5">
                            <i class="fas fa-tools fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No Products Found</h5>
                            <p class="text-muted">No products available for the selected filter.</p>
                            <button class="btn btn-secondary" onclick="clearFilters()">
                                <i class="fas fa-redo me-2"></i>Show All Products
                            </button>
                        </div>
                    `);
                    updateProductCount(0);
                }
            },
            error: function (xhr, status, error) {
                console.error('Error loading products:', error);
                $loadingIndicator.hide();
                $productsGrid.show();
                $productsGrid.html(`
                    <div class="col-12 text-center py-5">
                        <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                        <h5 class="text-danger">Error Loading Products</h5>
                        <p class="text-muted">Please try again later.</p>
                        <button class="btn btn-secondary" onclick="loadProducts(${catId}, ${subCat1Id}, ${subCat2Id})">
                            <i class="fas fa-redo me-2"></i>Retry
                        </button>
                    </div>
                `);
            }
        });
    }

    function renderProducts(products) {
        const $grid = $('#productsGrid');
        $grid.empty();

        products.forEach(function (product) {
            const hasOffer = product.offerPrice && product.offerPrice > 0 && product.offerPrice < product.price;
            const displayPrice = hasOffer ? product.offerPrice : product.price;
            const hasImage = product.imageUrl && product.imageUrl.trim() !== '';

            let imageHtml = '';
            if (hasImage) {
                    imageHtml = `<img src="${product.imageUrl}" alt="${product.name}" class="product-image" onclick="GoToContact()">`;
            } else {
                imageHtml = `
                    <div class="no-image-placeholder">
                        <i class="fas fa-tools fa-2x text-muted"></i>
                    </div>
                `;
            }

            const productHtml = `
                <div class="col-lg-4 col-md-6 col-sm-6 mb-3">
                    <div class="card product-card h-100">
                        <div class="product-image-container">
                            ${imageHtml}
                        </div>
                        <div class="card-body p-3">
                            <h6 class="product-title">${product.name}</h6>
                            ${product.description ? `<p class="product-description small text-muted mb-2">${product.description.length > 60 ? product.description.substring(0, 60) + '...' : product.description}</p>` : '<p class="product-description small text-muted mb-2">Professional power tool for demanding applications.</p>'}
                           
                            <div class="d-flex justify-content-between align-items-center">
                                <a href="/Home/Contact" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-phone"></i> Enquire
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            $grid.append(productHtml);
        });
    }

    function updateProductCount(count) {
        $('#productCount').html(`<i class="fas fa-box me-1"></i>${count} Product${count !== 1 ? 's' : ''}`);
    }

    function updateActiveFilter(subCat1Name, subCat2Name) {
        let filterText = subCat1Name;
        if (subCat2Name) {
            filterText += ' → ' + subCat2Name;
        }
        $('#filterText').text(filterText);
        $('#activeFilters').show();
    }

    function clearFilters() {
        showAllProducts();
    }
</script>
<style>
    /* ==========================================
       OFFERS PAGE - ENHANCED FLAT THEME
       Modern, Bold, Industrial
       ========================================== */

    * {
        box-sizing: border-box;
    }

    .page-content {
        background: #f8fafc;
        font-family: 'DM Sans', sans-serif;
    }

    .section-padding {
        padding: 40px 0 60px;
    }

    /* ========== ENHANCED HERO BANNER ========== */
    .offers-hero-banner {
        background: #1a1a1a;
        border-radius: 0;
        padding: 50px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        border: 4px solid #e00420;
        border-left: 12px solid #e00420;
        border-bottom: 8px solid #e00420;
    }

    /* Geometric shapes in background */
    .offers-hero-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 500px;
        height: 500px;
        background: #e00420;
        opacity: 0.1;
        clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
        z-index: 1;
    }

    .offers-hero-banner::after {
        content: '';
        position: absolute;
        bottom: -30%;
        left: -5%;
        width: 400px;
        height: 400px;
        background: #ffc107;
        opacity: 0.08;
        clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%);
        z-index: 1;
    }

    .banner-pattern {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image:
            repeating-linear-gradient(
                0deg,
                transparent,
                transparent 2px,
                rgba(224, 4, 32, 0.04) 2px,
                rgba(224, 4, 32, 0.04) 4px
            ),
            repeating-linear-gradient(
                90deg,
                transparent,
                transparent 2px,
                rgba(224, 4, 32, 0.04) 2px,
                rgba(224, 4, 32, 0.04) 4px
            );
        pointer-events: none;
        z-index: 1;
    }

    .banner-content {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 40px;
    }

    .banner-left {
        flex: 1;
        color: white;
    }

    .offer-badge-large {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #e00420;
        padding: 14px 28px;
        border-radius: 0;
        margin-bottom: 20px;
        border: 3px solid #fff;
        box-shadow: 0 4px 16px rgba(224, 4, 32, 0.4);
        position: relative;
    }

    .offer-badge-large::before {
        content: '';
        position: absolute;
        top: -3px;
        left: -3px;
        right: -3px;
        bottom: -3px;
        border: 2px solid #ffc107;
        z-index: -1;
    }

    .badge-icon {
        font-size: 28px;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
    }

    .badge-text {
        font-weight: 700;
        font-size: 16px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .banner-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 48px;
        font-weight: 800;
        margin-bottom: 15px;
        line-height: 1.2;
        text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.3);
    }

    .banner-subtitle {
        font-size: 18px;
        margin-bottom: 30px;
        opacity: 0.95;
        line-height: 1.6;
    }

    .banner-features {
        display: flex;
        gap: 25px;
        flex-wrap: wrap;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 15px;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.1);
        padding: 10px 18px;
        border-left: 3px solid #ffc107;
    }

    .feature-item i {
        font-size: 20px;
        color: #ffc107;
    }

    .banner-right {
        flex-shrink: 0;
    }

    .discount-showcase {
        position: relative;
        width: 250px;
        height: 250px;
    }

    .discount-circle {
        width: 100%;
        height: 100%;
        background: #e00420;
        border-radius: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 32px rgba(224, 4, 32, 0.6);
        border: 6px solid #fff;
        position: relative;
    }

    .discount-circle::before {
        content: '';
        position: absolute;
        top: -6px;
        left: -6px;
        right: -6px;
        bottom: -6px;
        border: 3px solid #ffc107;
    }

    .discount-inner {
        background: white;
        width: 85%;
        height: 85%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    }

    .discount-text {
        font-size: 14px;
        font-weight: 700;
        color: #666;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .discount-number {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 64px;
        font-weight: 900;
        color: #e00420;
        line-height: 1;
        margin: 5px 0;
        text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.1);
    }

    .discount-off {
        font-size: 18px;
        font-weight: 700;
        color: #333;
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    .floating-badge {
        position: absolute;
        background: white;
        padding: 12px 20px;
        border-radius: 0;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        font-size: 13px;
        color: #333;
        border: 3px solid #e00420;
        text-transform: uppercase;
    }

    .badge-1 {
        top: -10px;
        right: 20px;
    }

    .badge-1 i {
        color: #e00420;
    }

    .badge-2 {
        bottom: -10px;
        left: -20px;
    }

    .badge-2 i {
        color: #ffc107;
    }

    /* ========== FILTER & SORT BAR ========== */
    .filter-sort-bar {
        background: white;
        padding: 20px 25px;
        border-radius: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        flex-wrap: wrap;
        gap: 15px;
        border-left: 4px solid #e00420;
    }

    .filter-left, .filter-right {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .filter-toggle-btn {
        background: #e00420;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 0;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        border: 2px solid #e00420;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .filter-toggle-btn:hover {
        background: #fff;
        color: #e00420;
    }

    .results-count {
        color: #666;
        font-size: 15px;
    }

    .results-count strong {
        color: #333;
        font-weight: 700;
    }

    .view-toggle {
        display: flex;
        gap: 0;
        background: #f8f9fa;
        border-radius: 0;
        padding: 0;
    }

    .view-btn {
        background: transparent;
        border: 2px solid #e5e5e5;
        padding: 10px 14px;
        cursor: pointer;
        border-radius: 0;
        color: #666;
        transition: all 0.3s;
    }

    .view-btn.active {
        background: #e00420;
        color: white;
        border-color: #e00420;
    }

    .view-btn:hover:not(.active) {
        background: #f0f0f0;
    }

    .sort-select {
        padding: 12px 18px;
        border: 2px solid #e5e5e5;
        border-radius: 0;
        font-size: 14px;
        cursor: pointer;
        background: white;
        transition: all 0.3s;
        font-weight: 500;
    }

    .sort-select:focus {
        outline: none;
        border-color: #FFA500;
    }

    /* ========== FILTERS SIDEBAR ========== */
    .filters-sidebar {
        background: white;
        border-radius: 0;
        padding: 25px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        position: sticky;
        top: 100px;
        max-height: calc(100vh - 120px);
        overflow-y: auto;
        border-left: 4px solid #e00420;
    }

    .filters-sidebar::-webkit-scrollbar {
        width: 6px;
    }

    .filters-sidebar::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .filters-sidebar::-webkit-scrollbar-thumb {
        background: #e00420;
    }

    .filters-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 3px solid #f0f0f0;
    }

    .filters-header h5 {
        margin: 0;
        font-weight: 700;
        color: #333;
        font-size: 18px;
        text-transform: uppercase;
        letter-spacing: -0.5px;
    }

    .filters-header h5 i {
        color: #e00420;
        margin-right: 8px;
    }

    .clear-filters-btn {
        background: none;
        border: none;
        color: #e00420;
        font-size: 13px;
        cursor: pointer;
        font-weight: 600;
        transition: color 0.3s;
        text-transform: uppercase;
    }

    .clear-filters-btn:hover {
        color: #c00318;
        text-decoration: underline;
    }

    .filter-section {
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 2px solid #f0f0f0;
    }

    .filter-section:last-of-type {
        border-bottom: none;
    }

    .filter-title {
        font-size: 15px;
        font-weight: 600;
        color: #333;
        margin-bottom: 15px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        user-select: none;
    }

    .filter-title i {
        font-size: 12px;
        transition: transform 0.3s;
        color: #999;
    }

    .filter-title:hover {
        color: #e00420;
    }

    .filter-options {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .filter-option {
        display: flex;
        align-items: center;
        cursor: pointer;
        padding: 5px 0;
        transition: all 0.2s;
    }

    .filter-option:hover {
        padding-left: 5px;
    }

    .filter-checkbox {
        margin-right: 12px;
        cursor: pointer;
        width: 18px;
        height: 18px;
        accent-color: #e00420;
    }

    .filter-option span {
        font-size: 14px;
        color: #666;
        transition: color 0.2s;
    }

    .filter-option:hover span {
        color: #e00420;
    }

    .sidebar-promo {
        background: #1a1a1a;
        color: white;
        padding: 30px;
        border-radius: 0;
        text-align: center;
        margin-top: 25px;
        border: 3px solid #e00420;
    }

    .promo-icon {
        font-size: 48px;
        margin-bottom: 15px;
    }

    .sidebar-promo h6 {
        font-weight: 700;
        margin-bottom: 12px;
        font-size: 17px;
        text-transform: uppercase;
    }

    .sidebar-promo p {
        font-size: 14px;
        margin-bottom: 18px;
        opacity: 0.95;
        line-height: 1.5;
    }

    .promo-link {
        color: white;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.3s;
        text-transform: uppercase;
    }

    .promo-link:hover {
        color: #ffc107;
    }

    /* ========== PRODUCTS GRID ========== */
    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
    }

    .products-grid.products-list {
        grid-template-columns: 1fr;
    }

    .products-list .product-card {
        display: flex;
        flex-direction: row;
        align-items: stretch;
    }

    .products-list .product-image-wrapper {
        max-width: 280px;
        flex-shrink: 0;
    }

    .products-list .product-details {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .products-list .product-actions {
        margin-top: auto;
    }

    /* ========== PRODUCT CARD ========== */
    .product-card {
        background: white;
        border-radius: 0;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        position: relative;
    }

    .product-card::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        width: 4px;
        height: 100%;
        background: #e00420;
        transform: scaleY(0);
        transform-origin: bottom;
        transition: transform 0.3s ease;
    }

    .product-card:hover::before {
        transform: scaleY(1);
    }

    .product-card:hover {
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

    .product-badges {
        position: absolute;
        top: 15px;
        left: 15px;
        z-index: 10;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .badge-discount {
        background: #e00420;
        color: white;
        padding: 7px 14px;
        border-radius: 0;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        letter-spacing: 0.5px;
        border: 2px solid #fff;
    }

    .badge-hot {
        background: #ffc107;
        color: #1a1a1a;
        padding: 5px 12px;
        border-radius: 0;
        font-size: 11px;
        font-weight: 700;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        border: 2px solid #fff;
    }

    .quick-actions {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 10;
        display: flex;
        flex-direction: column;
        gap: 10px;
        opacity: 0;
        transform: translateX(15px);
        transition: all 0.3s;
    }

    .product-card:hover .quick-actions {
        opacity: 1;
        transform: translateX(0);
    }

    .action-btn {
        width: 42px;
        height: 42px;
        border-radius: 0;
        background: white;
        border: 2px solid #e5e5e5;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: all 0.3s;
        color: #666;
    }

    .action-btn:hover {
        background: #e00420;
        color: white;
        border-color: #e00420;
    }

    /* ========== PRODUCT IMAGE ========== */
    .product-image-wrapper {
        position: relative;
        overflow: hidden;
        background: #f8f9fa;
        height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        filter: grayscale(10%);
        transition: filter 0.3s ease;
    }

    .product-card:hover .product-image {
        filter: grayscale(0%);
    }

    .product-details {
        padding: 20px;
    }

    .category-tags-inline {
        margin-bottom: 8px;
    }

    .tag-category {
        display: inline-block;
        background: #f8f9fa;
        color: #e00420;
        padding: 4px 10px;
        border-radius: 0;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.5px;
        border-left: 3px solid #e00420;
        text-transform: uppercase;
    }

    .product-title {
        margin: 10px 0;
        font-size: 16px;
        font-weight: 600;
        line-height: 1.4;
    }

    .product-link {
        color: #333;
        text-decoration: none;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.3s;
    }

    .product-link:hover {
        color: #e00420;
    }

    .product-description {
        font-size: 13px;
        color: #666;
        margin-bottom: 15px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.5;
    }

    .price-section {
        margin-bottom: 15px;
        padding: 12px 0;
        border-top: 2px solid #f0f0f0;
        border-bottom: 2px solid #f0f0f0;
    }

    .prices {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 6px;
    }

    .price-current {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 24px;
        font-weight: 700;
        color: #28a745;
    }

    .price-original {
        font-size: 16px;
        color: #999;
        text-decoration: line-through;
    }

    .savings-info {
        font-size: 13px;
    }

    .savings-amount {
        color: #28a745;
        font-weight: 600;
    }

    .product-actions {
        display: flex;
        gap: 10px;
    }

    .btn-enquire {
        width: 100%;
        background: #e00420;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 0;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        border: 2px solid #e00420;
        text-transform: uppercase;
    }

    .btn-enquire:hover {
        background: #fff;
        color: #e00420;
    }

    /* ========== NO RESULTS ========== */
    .no-results {
        text-align: center;
        padding: 80px 20px;
        color: #666;
    }

    .no-results i {
        color: #ddd;
    }

    .no-results h4 {
        margin-top: 20px;
        color: #333;
        font-weight: 600;
    }

    /* ========== BULK ORDER SECTION ========== */
    .bulk-order-section {
        background: white;
        border-radius: 0;
        padding: 50px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        border-left: 4px solid #e00420;
    }

    .bulk-header {
        text-align: center;
        margin-bottom: 45px;
    }

    .bulk-header h3 {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        color: #333;
        margin-bottom: 12px;
        font-size: 32px;
        text-transform: uppercase;
    }

    .bulk-header h3 i {
        color: #e00420;
        margin-right: 10px;
    }

    .bulk-header p {
        color: #666;
        font-size: 16px;
    }

    .bulk-tiers {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 30px;
        margin-bottom: 40px;
    }

    .bulk-tier {
        background: #1a1a1a;
        border: 3px solid #e00420;
        border-radius: 0;
        padding: 35px;
        text-align: center;
        transition: all 0.3s ease;
        color: white;
    }

    .bulk-tier:hover {
        background: #e00420;
        border-color: #1a1a1a;
    }

    .tier-icon {
        font-size: 52px;
        margin-bottom: 18px;
        color: white;
    }

    .tier-details h5 {
        color: white;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        margin-bottom: 12px;
        font-size: 20px;
        text-transform: uppercase;
    }

    .tier-discount {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 32px;
        font-weight: 800;
        color: #ffc107;
        margin: 18px 0;
    }

    .tier-badge {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        padding: 6px 18px;
        border-radius: 0;
        font-size: 15px;
        font-weight: 600;
        border: 2px solid white;
        display: inline-block;
    }

    .bulk-cta {
        text-align: center;
    }

    .btn-bulk-inquiry {
        display: inline-block;
        background: #e00420;
        color: white;
        padding: 18px 45px;
        border-radius: 0;
        border: 2px solid #e00420;
        text-decoration: none;
        font-weight: 600;
        font-size: 16px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
    }

    .btn-bulk-inquiry:hover {
        background: #fff;
        color: #e00420;
    }

    /* ========== EMPTY STATE ========== */
    .empty-state {
        text-align: center;
        padding: 100px 20px;
        color: #666;
    }

    .empty-state i {
        color: #ddd;
    }

    .empty-state h3 {
        margin-top: 25px;
        color: #333;
        font-weight: 600;
    }

    /* ========== RESPONSIVE ========== */

    @@media (max-width: 1199px) {
        .offers-hero-banner {
            padding: 40px;
        }

        .banner-content {
            flex-direction: column;
            text-align: center;
        }

        .banner-features {
            justify-content: center;
        }

        .discount-showcase {
            width: 200px;
            height: 200px;
            margin-top: 30px;
        }

        .discount-number {
            font-size: 48px;
        }

        .products-grid {
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }

        .product-image-wrapper {
            height: 230px;
            padding: 18px;
        }
    }

    @@media (max-width: 991px) {
        .filters-sidebar {
            position: fixed;
            left: -100%;
            top: 0;
            height: 100vh;
            z-index: 1050;
            transition: left 0.3s;
            overflow-y: auto;
            width: 320px;
            max-height: 100vh;
            border-radius: 0;
        }

        .filters-sidebar.show-mobile {
            left: 0;
            box-shadow: 5px 0 25px rgba(0, 0, 0, 0.3);
        }

        .offers-hero-banner {
            padding: 35px 30px;
        }

        .banner-title {
            font-size: 36px;
        }

        .banner-subtitle {
            font-size: 16px;
        }

        .bulk-order-section {
            padding: 40px 30px;
        }

        .bulk-header h3 {
            font-size: 28px;
        }

        .bulk-tiers {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .product-image-wrapper {
            height: 220px;
            padding: 16px;
        }
    }

    @@media (max-width: 767px) {
        .section-padding {
            padding: 30px 0 50px;
        }

        .offers-hero-banner {
            padding: 30px 25px;
            border-left: 6px solid #e00420;
            border-bottom: 4px solid #e00420;
        }

        .banner-title {
            font-size: 28px;
        }

