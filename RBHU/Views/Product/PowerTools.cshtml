@model RBHU_DbServices.ViewModel.CategoryViewModel
@{
    ViewData["Title"] = "Power Tools in Goa | Authorised Bosch & Makita Dealer | RBHU Solutions LLP";
    ViewData["Description"] = "Authorised dealer of Bosch and Makita power tools in Goa. Electric drills, angle grinders, circular saws, impact drivers, and accessories for industrial and construction use. Serving industries across South Goa and North Goa.";
}

<!-- BreadcrumbList schema -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://rbhu.co.in"
    },
    {
      "@@type": "ListItem",
      "position": 2,
      "name": "Products",
      "item": "https://rbhu.co.in/Home/Products"
    },
    {
      "@@type": "ListItem",
      "position": 3,
      "name": "Power Tools and Accessories",
      "item": "https://rbhu.co.in/Product/Category/PowerTools"
    }
  ]
}
</script>

<div class="page-content">
    <section class="section-padding" style="margin-top: 80px;">
        <div class="container">
            <!-- Header Section -->
            <div class="row mb-4">
                <div class="col-lg-12 text-center">
                    <!-- CHANGE: H1 with geo-targeted keyword -->
                    <h1 class="section-title" data-aos="fade-up">Power Tools &amp; Accessories Supplier in Goa</h1>
                    <!-- CHANGE: One-line intro paragraph -->
                    <p class="lead text-muted" data-aos="fade-up" data-aos-delay="100">
                        RBHU Solutions LLP is the authorised dealer of Bosch and Makita power tools in Goa, supplying professional-grade equipment to industries and contractors across Goa.
                    </p>
                </div>
            </div>

            <!-- Featured Brands Section -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="brands-section">
                        <h3 class="brands-title">
                            <i class="fas fa-star me-2"></i>Featured Brands
                        </h3>
                        <div class="brands-grid" id="brandShowcase">
                            <!-- Bosch Brand -->
                            <div class="brand-card-modern" data-brand="Bosch" onclick="filterByBrand('Bosch')">
                                <div class="brand-image-wrapper">
                                    <img src="~/images/Product_Brands/Bosch.png"
                                         alt="Bosch Power Tools - Authorised Dealer in Goa, Drills and Angle Grinders"
                                         loading="lazy">
                                </div>
                                <div class="brand-label">Bosch</div>
                                <div class="brand-overlay">
                                    <i class="fas fa-search-plus"></i>
                                </div>
                            </div>

                            <!-- Makita Brand -->
                            <div class="brand-card-modern" data-brand="Makita" onclick="filterByBrand('Makita')">
                                <div class="brand-image-wrapper">
                                    <img src="~/images/Product_Brands/Makita.png"
                                         alt="Makita Power Tools - Authorised Dealer in Goa, Cordless Drills and Impact Drivers"
                                         loading="lazy">
                                </div>
                                <div class="brand-label">Makita</div>
                                <div class="brand-overlay">
                                    <i class="fas fa-search-plus"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filter + Products Layout -->
            <div class="row">
                <!-- Sidebar Filter -->
                <div class="col-lg-3 col-md-4 mb-4">
                    <div class="filter-sidebar">
                        <div class="filter-header">
                            <h5 class="filter-title-sidebar">
                                <i class="fas fa-filter me-2"></i>Filter Products
                            </h5>
                            <button class="btn-reset-sidebar" onclick="clearFilters()">
                                <i class="fas fa-redo"></i> Reset
                            </button>
                        </div>

                        <div class="filter-section">
                            <button class="filter-btn-full" onclick="showAllProducts()">
                                <i class="fas fa-th me-2"></i>All Products
                            </button>
                            <a class="filter-btn-full filter-btn-outline" asp-action="Products" asp-controller="Home">
                                <i class="fas fa-arrow-left me-2"></i>Go back to category page
                            </a>
                        </div>

                        <div class="filter-section" id="brandFilterSection">
                            <div class="filter-section-header">
                                <i class="fas fa-star me-2"></i>Brands
                            </div>
                            @if (Model.SubCategories1 != null && Model.SubCategories1.Any())
                            {
                                @foreach (var subCat1 in Model.SubCategories1)
                                {
                                    var subCat1Id = $"subcat1-{subCat1.Id}";
                                    var subCategories2 = Model.SubCategories2Map.ContainsKey(subCat1.Id)
                                    ? Model.SubCategories2Map[subCat1.Id]
                                    : new List<RBHU_DbServices.Models.SubCategory2>();

                                    <div class="brand-filter-item">
                                        <button class="brand-filter-btn"
                                                data-subcategory1-id="@subCat1.Id"
                                                data-brand-name="@subCat1.Name"
                                                data-has-subcat2="@(subCategories2.Any() ? "true" : "false")"
                                                onclick="toggleSubCategory1(@subCat1.Id, '@subCat1.Name')">
                                            <i class="fas fa-folder me-2"></i>
                                            <span>@subCat1.Name</span>
                                            @if (subCategories2 != null && subCategories2.Any())
                                            {
                                                <i class="fas fa-chevron-down ms-auto brand-arrow"></i>
                                            }
                                        </button>

                                        @if (subCategories2 != null && subCategories2.Any())
                                        {
                                            <div class="brand-subcategory-list" id="@subCat1Id" style="display: none;">
                                                @foreach (var subCat2 in subCategories2)
                                                {
                                                    <div class="brand-subcategory-item"
                                                         data-subcategory2-id="@subCat2.Id"
                                                         onclick="filterBySubCategory2(@subCat1.Id, @subCat2.Id, '@subCat1.Name', '@subCat2.Name')">
                                                        <i class="fas fa-caret-right me-2"></i>
                                                        <span>@subCat2.Name</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="no-categories-sidebar">
                                    <i class="fas fa-info-circle me-2"></i>No filters available
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Products Section -->
                <div class="col-lg-9 col-md-8">
                    <div id="activeFilters" class="mb-3" style="display: @(Model.SelectedSubCategory1Id.HasValue || Model.SelectedSubCategory2Id.HasValue ? "block" : "none")">
                        <div class="active-filter-badge">
                            <i class="fas fa-filter me-2"></i>
                            <strong>Active Filter:</strong>
                            <span id="filterText" class="filter-value">
                                @if (Model.SelectedSubCategory2Id.HasValue)
                                {
                                    var subCat1 = Model.SubCategories1.FirstOrDefault(s => s.Id == Model.SelectedSubCategory1Id);
                                    var subCat2 = Model.SubCategories2Map.ContainsKey(Model.SelectedSubCategory1Id.Value)
                                    ? Model.SubCategories2Map[Model.SelectedSubCategory1Id.Value].FirstOrDefault(s => s.Id == Model.SelectedSubCategory2Id)
                                    : null;
                                    @($"{subCat1?.Name} → {subCat2?.Name}")
                                }
                                else if (Model.SelectedSubCategory1Id.HasValue)
                                {
                                    var subCat1 = Model.SubCategories1.FirstOrDefault(s => s.Id == Model.SelectedSubCategory1Id);
                                    @subCat1?.Name
                                }
                            </span>
                            <button class="filter-close" onclick="clearFilters()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="product-count-badge" id="productCount">
                            <i class="fas fa-box me-1"></i>
                            @Model.Products.Count Product@(Model.Products.Count != 1 ? "s" : "") Found
                        </div>
                    </div>

                    <div id="loadingIndicator" class="text-center py-5" style="display: none;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 text-muted">Loading products...</p>
                    </div>

                    <div id="sampleProductsContainer" style="display: none;">
                        <h5 class="mb-4 section-title" id="sampleProductsTitle">
                            <i class="fas fa-th me-2"></i>Select a Collection
                        </h5>
                        <div id="sampleProductsGrid" class="row"></div>
                    </div>

                    <div id="productsGrid" class="row">
                        @if (Model.Products != null && Model.Products.Any())
                        {
                            @foreach (var product in Model.Products)
                            {
                                <div class="col-lg-4 col-md-6 col-sm-6 mb-4">
                                    <div class="product-card-modern">
                                        <div class="product-image-box">
                                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                                            {
                                                <img src="@product.ImageUrl"
                                                     alt="@product.Name - Power Tool by RBHU Solutions Goa"
                                                     onclick="GoToContact()"
                                                     loading="lazy">
                                            }
                                            else
                                            {
                                                <div class="no-image">
                                                    <i class="fas fa-image"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="product-info">
                                            <h6 class="product-name">@product.Name</h6>
                                            <p class="product-desc">
                                                @(string.IsNullOrEmpty(product.Description) ? "Professional power tool for demanding applications." :
                                                    (product.Description.Length > 60 ? product.Description.Substring(0, 60) + "..." : product.Description))
                                            </p>
                                            <a asp-controller="Home" asp-action="Contact" class="product-btn">
                                                <i class="fas fa-phone me-1"></i>Enquire Now
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12">
                                <div class="empty-state">
                                    <i class="fas fa-inbox"></i>
                                    <h4>No Products Available</h4>
                                    <p>No products found in this category.</p>
                                    <a asp-controller="Home" asp-action="Contact" class="btn-contact-us">
                                        <i class="fas fa-envelope me-2"></i>Contact Us
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- CHANGE: Why Choose section with H3 + geo sentence -->
            <div class="row mt-5 pt-4 border-top">
                <div class="col-lg-12">
                    <h3 class="text-center mb-2 powertools-faq-heading">Why Choose Our Power Tools?</h3>
                    <p class="text-center text-muted mb-4 powertools-faq-sub">RBHU Solutions LLP is the authorised dealer of Bosch and Makita power tools in Goa, serving construction, manufacturing, and maintenance industries across the state.</p>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="text-center powertools-feature">
                        <i class="fas fa-battery-full fa-2x mb-3"></i>
                        <h6>Long Battery Life</h6>
                        <p class="small text-muted">Extended runtime with advanced lithium-ion technology.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="text-center powertools-feature">
                        <i class="fas fa-tachometer-alt fa-2x mb-3"></i>
                        <h6>High Performance</h6>
                        <p class="small text-muted">Powerful motors deliver exceptional cutting and drilling performance.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="text-center powertools-feature">
                        <i class="fas fa-shield-alt fa-2x mb-3"></i>
                        <h6>Built to Last</h6>
                        <p class="small text-muted">Rugged construction withstands demanding jobsite conditions.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="text-center powertools-feature">
                        <i class="fas fa-wrench fa-2x mb-3"></i>
                        <h6>Easy Maintenance</h6>
                        <p class="small text-muted">User-serviceable parts and readily available accessories.</p>
                    </div>
                </div>
            </div>

            <!-- CHANGE: FAQ accordion replacing CTA box -->
            <div class="row mt-2 mb-5">
                <div class="col-lg-10 mx-auto">
                    <div class="powertools-faq-accordion">

                        <div class="powertools-faq-item">
                            <button class="powertools-faq-question" aria-expanded="false" aria-controls="ptfaq1">
                                <span>Is RBHU Solutions the authorised Bosch power tools dealer in Goa?</span>
                                <i class="fas fa-chevron-down powertools-faq-icon"></i>
                            </button>
                            <div class="powertools-faq-answer" id="ptfaq1" hidden>
                                <p>Yes, RBHU Solutions LLP is an authorised dealer of Bosch power tools in Goa. We supply Bosch electric drills, angle grinders, circular saws, rotary hammers, and accessories to industries, contractors, and fabrication units across South Goa and North Goa.</p>
                            </div>
                        </div>

                        <div class="powertools-faq-item">
                            <button class="powertools-faq-question" aria-expanded="false" aria-controls="ptfaq2">
                                <span>Do you supply Makita cordless tools and accessories in Goa?</span>
                                <i class="fas fa-chevron-down powertools-faq-icon"></i>
                            </button>
                            <div class="powertools-faq-answer" id="ptfaq2" hidden>
                                <p>Yes, RBHU Solutions LLP is an authorised Makita dealer in Goa. We stock Makita cordless drills, impact drivers, reciprocating saws, and the full range of Makita accessories and replacement batteries. Contact us at <a href="tel:+919968068454">+91 9968068454</a> for availability.</p>
                            </div>
                        </div>

                        <div class="powertools-faq-item">
                            <button class="powertools-faq-question" aria-expanded="false" aria-controls="ptfaq3">
                                <span>What industries in Goa use Bosch and Makita power tools?</span>
                                <i class="fas fa-chevron-down powertools-faq-icon"></i>
                            </button>
                            <div class="powertools-faq-answer" id="ptfaq3" hidden>
                                <p>Our power tools are used across Goa's shipbuilding, aerospace, furniture manufacturing, pharma, and construction sectors. We supply to clients including Goa Shipyard, IFB Industries, Kineco, and Chowgule Shipbuilding, as well as contractors and maintenance teams across the state.</p>
                            </div>
                        </div>

                        <div class="powertools-faq-item">
                            <button class="powertools-faq-question" aria-expanded="false" aria-controls="ptfaq4">
                                <span>How can I get a quotation for Bosch or Makita tools in Goa?</span>
                                <i class="fas fa-chevron-down powertools-faq-icon"></i>
                            </button>
                            <div class="powertools-faq-answer" id="ptfaq4" hidden>
                                <p>Call or WhatsApp RBHU Solutions LLP at <a href="tel:+919968068454">+91 9968068454</a> or email <a href="mailto:rbhugoa@gmail.com">rbhugoa@gmail.com</a>. We are based in Margao, South Goa, and serve clients for both individual purchases and bulk industrial orders across Goa.</p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </section>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<link href="~/css/product-cards.css" rel="stylesheet" />

@section Scripts
{
    <script>
        const categoryId = @Model.CategoryId;
        let currentSubCategory1Id = @(Model.SelectedSubCategory1Id ?? 0);
        let currentSubCategory2Id = @(Model.SelectedSubCategory2Id ?? 0);
        let currentBrand = '';
        let showingSampleProducts = false;

        function GoToContact() { window.location.href = '/Home/Contact'; }

        $(document).ready(function () {
            if (currentSubCategory1Id > 0) {
                const filterItem = $('[data-subcategory1-id="' + currentSubCategory1Id + '"]').closest('.brand-filter-item');
                if (filterItem.length > 0) {
                    const filterBtn = filterItem.find('.brand-filter-btn');
                    const arrow = filterItem.find('.brand-arrow');
                    const subcategoryList = filterItem.find('.brand-subcategory-list');
                    let brandName = filterBtn.data('brand-name');
                    arrow.addClass('rotated');
                    subcategoryList.slideDown(300);
                    filterBtn.addClass('active');
                    currentBrand = brandName;
                    highlightBrand(brandName);
                    showOnlyBrand(brandName);
                    const hasSubCat2 = filterBtn.data('has-subcat2') === 'true' || filterBtn.data('has-subcat2') === true;
                    if (hasSubCat2) {
                        if (currentSubCategory2Id > 0) {
                            $('#sampleProductsContainer').hide();
                            $('#productsGrid').show();
                            loadProducts(categoryId, currentSubCategory1Id, currentSubCategory2Id);
                            $('[data-subcategory2-id="' + currentSubCategory2Id + '"]').addClass('active');
                            const subCat2Text = $('[data-subcategory2-id="' + currentSubCategory2Id + '"] span').text().trim();
                            updateActiveFilter(brandName, subCat2Text);
                        } else {
                            showSampleProducts(currentSubCategory1Id, brandName);
                        }
                    } else {
                        $('#sampleProductsContainer').hide();
                        $('#productsGrid').show();
                        loadProducts(categoryId, currentSubCategory1Id, null);
                        updateActiveFilter(brandName, null);
                    }
                    $('#activeFilters').show();
                    setTimeout(() => { $('html, body').animate({ scrollTop: $('#brandShowcase').offset().top - 100 }, 500); }, 300);
                }
            }

            // FAQ accordion
            document.querySelectorAll('.powertools-faq-question').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    const expanded = this.getAttribute('aria-expanded') === 'true';
                    const answerId = this.getAttribute('aria-controls');
                    const answer = document.getElementById(answerId);
                    document.querySelectorAll('.powertools-faq-question').forEach(function(other) {
                        other.setAttribute('aria-expanded', 'false');
                        const icon = other.querySelector('.powertools-faq-icon');
                        if (icon) icon.style.transform = 'rotate(0deg)';
                        const otherAnswer = document.getElementById(other.getAttribute('aria-controls'));
                        if (otherAnswer) otherAnswer.hidden = true;
                    });
                    if (!expanded) {
                        this.setAttribute('aria-expanded', 'true');
                        const icon = this.querySelector('.powertools-faq-icon');
                        if (icon) icon.style.transform = 'rotate(180deg)';
                        answer.hidden = false;
                    }
                });
            });
        });

        function filterByBrand(brandName) {
            const filterBtn = $('[data-brand-name="' + brandName + '"]');
            if (filterBtn.length) {
                const subCat1Id = filterBtn.data('subcategory1-id');
                const hasSubCat2Data = filterBtn.data('has-subcat2');
                const hasSubCat2 = hasSubCat2Data === 'true' || hasSubCat2Data === true;
                const filterItem = filterBtn.closest('.brand-filter-item');
                const arrow = filterItem.find('.brand-arrow');
                const subcategoryList = filterItem.find('.brand-subcategory-list');
                $('.brand-filter-item').not(filterItem).each(function () {
                    $(this).find('.brand-filter-btn').removeClass('active');
                    $(this).find('.brand-arrow').removeClass('rotated');
                    $(this).find('.brand-subcategory-list').hide();
                });
                arrow.addClass('rotated');
                subcategoryList.slideDown(300);
                filterBtn.addClass('active');
                currentSubCategory1Id = subCat1Id;
                currentSubCategory2Id = 0;
                currentBrand = brandName;
                $('.brand-subcategory-item').removeClass('active');
                highlightBrand(brandName);
                showOnlyBrand(brandName);
                if (hasSubCat2) {
                    showingSampleProducts = true;
                    showSampleProducts(subCat1Id, brandName);
                } else {
                    showingSampleProducts = false;
                    $('#sampleProductsContainer').hide();
                    $('#productsGrid').show();
                    updateActiveFilter(brandName, null);
                    loadProducts(categoryId, subCat1Id, null);
                }
                $('#activeFilters').show();
            }
        }

        function highlightBrand(brandName) {
            $('.brand-card-modern').removeClass('active');
            if (brandName) { $('.brand-card-modern[data-brand="' + brandName + '"]').addClass('active'); }
        }

        function showOnlyBrand(brandName) {
            const $brandCards = $('.brand-card-modern');
            if (!brandName || brandName === '') {
                $brandCards.show();
                $('.brand-card-modern').removeClass('active');
            } else {
                $brandCards.each(function () {
                    const cardBrand = $(this).data('brand');
                    if (cardBrand === brandName) { $(this).show(); } else { $(this).hide(); }
                });
            }
        }

        function toggleSubCategory1(subCat1Id, subCat1Name) {
            const filterItem = $(event.currentTarget).closest('.brand-filter-item');
            const filterBtn = filterItem.find('.brand-filter-btn');
            const arrow = filterItem.find('.brand-arrow');
            const subcategoryList = filterItem.find('.brand-subcategory-list');
            const hasSubCat2Data = filterBtn.data('has-subcat2');
            const hasSubCat2 = hasSubCat2Data === 'true' || hasSubCat2Data === true;
            const isExpanded = filterBtn.hasClass('active');
            $('.brand-filter-item').not(filterItem).each(function () {
                $(this).find('.brand-filter-btn').removeClass('active');
                $(this).find('.brand-arrow').removeClass('rotated');
                $(this).find('.brand-subcategory-list').slideUp(300);
            });
            $('.brand-subcategory-item').removeClass('active');
            if (!isExpanded) {
                arrow.addClass('rotated');
                subcategoryList.slideDown(300);
                filterBtn.addClass('active');
                currentSubCategory1Id = subCat1Id;
                currentSubCategory2Id = 0;
                currentBrand = subCat1Name;
                highlightBrand(subCat1Name);
                showOnlyBrand(subCat1Name);
                $('#activeFilters').show();
                if (hasSubCat2) {
                    showingSampleProducts = true;
                    showSampleProducts(subCat1Id, subCat1Name);
                } else {
                    showingSampleProducts = false;
                    updateActiveFilter(subCat1Name, null);
                    $('#sampleProductsContainer').hide();
                    $('#productsGrid').show();
                    loadProducts(categoryId, subCat1Id, null);
                }
            } else {
                arrow.removeClass('rotated');
                subcategoryList.slideUp(300);
                filterBtn.removeClass('active');
                currentSubCategory1Id = 0;
                currentSubCategory2Id = 0;
                currentBrand = '';
                showingSampleProducts = false;
                highlightBrand('');
                showOnlyBrand('');
                $('#activeFilters').hide();
                $('#sampleProductsContainer').hide();
                $('#productsGrid').show();
                loadProducts(categoryId, null, null);
            }
        }

        function showSampleProducts(subCat1Id, subCat1Name) {
            $('#productsGrid').hide();
            $('#sampleProductsContainer').show();
            $('#sampleProductsTitle').html('<i class="fas fa-th me-2"></i>' + subCat1Name + ' Collections');
            const $grid = $('#sampleProductsGrid');
            $grid.html('<div class="col-12 text-center py-5"><div class="spinner-border text-secondary" role="status"><span class="visually-hidden">Loading...</span></div><p class="mt-3 text-muted">Loading collections...</p></div>');
            $.ajax({
                url: '/Product/GetSampleProductsForSubCategories2',
                type: 'GET',
                data: { subCategory1Id: subCat1Id },
                success: function (response) {
                    $grid.empty();
                    if (response && response.length > 0) {
                        response.forEach(function (item) {
                            if (!item.product) return;
                            const productImageHtml = item.product.imageUrl
                                ? `<img src="${item.product.imageUrl}" alt="${item.product.name} - ${item.subCategory2Name} Power Tool by RBHU Solutions Goa" loading="lazy">`
                                : `<div class="no-image"><i class="fas fa-image"></i></div>`;
                            const productDescription = item.product.description
                                ? (item.product.description.length > 60 ? item.product.description.substring(0, 60) + '...' : item.product.description)
                                : 'Professional power tool for demanding applications.';
                            const cardHtml = `<div class="col-lg-4 col-md-6 col-sm-6 mb-4"><div class="product-card-modern sample-product-card h-100"><div class="product-image-box">${productImageHtml}</div><div class="product-info"><div class="category-badge mb-2"><span class="badge bg-info">${item.subCategory2Name}</span></div><h6 class="product-name">${item.product.name}</h6><p class="product-desc">${productDescription}</p><button class="product-btn w-100" onclick="exploreSubCategory(${subCat1Id}, ${item.subCategory2Id}, '${subCat1Name.replace(/'/g, "\\'")}', '${item.subCategory2Name.replace(/'/g, "\\'")}')"><i class="fas fa-arrow-right me-2"></i>Explore More</button></div></div></div>`;
                            $grid.append(cardHtml);
                        });
                        updateActiveFilter(subCat1Name, null);
                        updateProductCount(response.length);
                    } else {
                        $grid.html('<div class="col-12"><div class="empty-state"><i class="fas fa-inbox"></i><h4>No Collections Available</h4><p>No product collections found for this category.</p></div></div>');
                        updateProductCount(0);
                    }
                    showingSampleProducts = true;
                },
                error: function () {
                    $grid.html('<div class="col-12"><div class="empty-state"><i class="fas fa-exclamation-triangle" style="color:#f56565;"></i><h4>Error Loading Collections</h4><p>Please try again later.</p></div></div>');
                }
            });
        }

        function exploreSubCategory(subCat1Id, subCat2Id, subCat1Name, subCat2Name) {
            currentSubCategory1Id = subCat1Id;
            currentSubCategory2Id = subCat2Id;
            currentBrand = subCat1Name;
            showingSampleProducts = false;
            $('#sampleProductsContainer').hide();
            $('#productsGrid').show();
            updateActiveFilter(subCat1Name, subCat2Name);
            loadProducts(categoryId, subCat1Id, subCat2Id);
            $('.brand-subcategory-item').removeClass('active');
            $('[data-subcategory2-id="' + subCat2Id + '"]').addClass('active');
            highlightBrand(subCat1Name);
            showOnlyBrand(subCat1Name);
            setTimeout(() => { $('html, body').animate({ scrollTop: $('#productsGrid').offset().top - 100 }, 500); }, 300);
        }

        function filterBySubCategory2(subCat1Id, subCat2Id, subCat1Name, subCat2Name) {
            currentSubCategory1Id = subCat1Id;
            currentSubCategory2Id = subCat2Id;
            currentBrand = subCat1Name;
            showingSampleProducts = false;
            $('.brand-subcategory-item').removeClass('active');
            $(event.currentTarget).addClass('active');
            $('#sampleProductsContainer').hide();
            $('#productsGrid').show();
            updateActiveFilter(subCat1Name, subCat2Name);
            loadProducts(categoryId, subCat1Id, subCat2Id);
            highlightBrand(subCat1Name);
            showOnlyBrand(subCat1Name);
        }

        function showAllProducts() {
            currentSubCategory1Id = 0;
            currentSubCategory2Id = 0;
            currentBrand = '';
            showingSampleProducts = false;
            $('.brand-filter-item').each(function () {
                $(this).find('.brand-filter-btn').removeClass('active');
                $(this).find('.brand-arrow').removeClass('rotated');
                $(this).find('.brand-subcategory-list').slideUp(300);
            });
            $('.brand-subcategory-item').removeClass('active');
            highlightBrand('');
            showOnlyBrand('');
            $('#activeFilters').hide();
            $('#sampleProductsContainer').hide();
            $('#productsGrid').show();
            loadProducts(categoryId, null, null);
        }

        function loadProducts(catId, subCat1Id, subCat2Id) {
            const $productsGrid = $('#productsGrid');
            const $loadingIndicator = $('#loadingIndicator');
            $productsGrid.hide();
            $loadingIndicator.show();
            $.ajax({
                url: '/Product/GetProductsByFilter',
                type: 'POST',
                data: { categoryId: catId, subCategory1Id: subCat1Id, subCategory2Id: subCat2Id },
                success: function (response) {
                    $loadingIndicator.hide();
                    $('#sampleProductsContainer').hide();
                    $productsGrid.show();
                    if (response.success && response.data && response.data.length > 0) {
                        renderProducts(response.data);
                        updateProductCount(response.data.length);
                    } else {
                        $productsGrid.html('<div class="col-12"><div class="empty-state"><i class="fas fa-inbox"></i><h4>No Products Found</h4><p>No products available for the selected filter.</p><button class="btn-contact-us" onclick="clearFilters()"><i class="fas fa-redo me-2"></i>Show All Products</button></div></div>');
                        updateProductCount(0);
                    }
                },
                error: function () {
                    $loadingIndicator.hide();
                    $productsGrid.show();
                    $productsGrid.html('<div class="col-12"><div class="empty-state"><i class="fas fa-exclamation-triangle" style="color:#f56565;"></i><h4>Error Loading Products</h4><p>Please try again later.</p></div></div>');
                }
            });
        }

        function renderProducts(products) {
            const $grid = $('#productsGrid');
            $grid.empty();
            products.forEach(function (product) {
                const hasImage = product.imageUrl && product.imageUrl.trim() !== '';
                let imageHtml = hasImage
                    ? `<img src="${product.imageUrl}" alt="${product.name} - ${product.subCategory1Name || 'Power'} Tool by RBHU Solutions Goa" onclick="GoToContact()" loading="lazy">`
                    : `<div class="no-image"><i class="fas fa-image"></i></div>`;
                const productHtml = `<div class="col-lg-4 col-md-6 col-sm-6 mb-4"><div class="product-card-modern"><div class="product-image-box">${imageHtml}</div><div class="product-info"><h6 class="product-name">${product.name}</h6><p class="product-desc">${product.description ? (product.description.length > 60 ? product.description.substring(0, 60) + '...' : product.description) : 'Professional power tool for demanding applications.'}</p><a href="/Home/Contact" class="product-btn"><i class="fas fa-phone me-1"></i>Enquire Now</a></div></div></div>`;
                $grid.append(productHtml);
            });
        }

        function updateProductCount(count) {
            $('#productCount').html(`<i class="fas fa-box me-1"></i>${count} Product${count !== 1 ? 's' : ''} Found`);
        }

        function updateActiveFilter(subCat1Name, subCat2Name) {
            let filterText = subCat1Name;
            if (subCat2Name) { filterText += ' → ' + subCat2Name; }
            $('#filterText').text(filterText);
            $('#activeFilters').show();
        }

        function clearFilters() { showAllProducts(); }
    </script>

