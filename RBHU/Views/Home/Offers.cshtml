            top: 16px;
            right: 16px;
            z-index: 10;
            opacity: 0;
            transform: translateX(10px);
            transition: var(--transition);
        }

        .product-card:hover .quick-actions {
            opacity: 1;
            transform: translateX(0);
        }

        .action-btn {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            background: var(--white);
            border: 2px solid var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--primary-color);
            transition: var(--transition);
            box-shadow: var(--shadow-md);
            font-size: 18px;
        }

            .action-btn:hover {
                background: var(--primary-color);
                color: var(--white);
                transform: scale(1.1) rotate(5deg);
            }

        /* Product Image */
        .product-image-wrapper {
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, var(--bg-light) 0%, var(--white) 100%);
            border-bottom: 1px solid var(--border-color);
        }

        .image-container {
            height: 280px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: contain;
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .product-card:hover .product-image {
            transform: scale(1.08);
        }

        /* Product Details */
        .product-details {
            padding: 24px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .category-tags {
            margin-bottom: 14px;
        }

        .category-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(0, 79, 140, 0.08);
            color: var(--primary-color);
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .product-title {
            margin: 0 0 12px;
            font-size: 17px;
            font-weight: 700;
            line-height: 1.4;
            min-height: 48px;
        }

        .product-link {
            color: var(--dark-text);
            text-decoration: none;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: var(--transition);
        }

            .product-link:hover {
                color: var(--primary-color);
            }

        .product-description {
            font-size: 14px;
            color: var(--light-text);
            margin-bottom: 16px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.6;
            min-height: 44px;
            flex-grow: 1;
        }

        /* Price Section */
        .price-section {
            margin-bottom: 20px;
            padding: 18px 0;
            border-top: 2px solid var(--border-color);
            border-bottom: 2px solid var(--border-color);
        }

        .price-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .prices {
            display: flex;
            align-items: baseline;
            gap: 12px;
            flex-wrap: wrap;
        }

        .price-current {
            font-size: 28px;
            font-weight: 800;
            color: var(--success-color);
            font-family: 'Segoe UI', sans-serif;
        }

        .price-original {
            font-size: 17px;
            color: #999;
            text-decoration: line-through;
            font-weight: 500;
        }

        .savings-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(40, 167, 69, 0.1);
            color: var(--success-color);
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 700;
        }

        .gst-info {
            font-size: 12px;
            color: var(--light-text);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* Product Actions */
        .product-actions {
            display: flex;
            gap: 10px;
            margin-top: auto;
        }

        .btn-enquire {
            width: 100%;
            background: linear-gradient(0deg, #004F8C 0%, #0066B3 50%, #004F8C 90%);
            color: var(--white);
            border: none;
            padding: 14px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 4px 12px rgba(51, 133, 195, 0.25);
        }

            .btn-enquire:hover {
                background: linear-gradient(135deg, #2875B3 0%, #005A9C 100%);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(51, 133, 195, 0.35);
            }

            .btn-enquire i {
                font-size: 16px;
            }

        /* No Results */
        .no-results {
            display: none;
            align-items: center;
            justify-content: center;
            padding: 100px 20px;
            text-align: center;
        }

        .no-results-content {
            max-width: 500px;
        }

        .no-results i {
            font-size: 80px;
            color: rgba(0, 79, 140, 0.15);
            margin-bottom: 24px;
        }

        .no-results h4 {
            color: var(--dark-text);
            font-weight: 700;
            margin-bottom: 12px;
            font-size: 24px;
        }

        .no-results p {
            color: var(--light-text);
            font-size: 16px;
            margin-bottom: 24px;
        }

        .btn-reset {
            background: linear-gradient(0deg, #004F8C 0%, #0066B3 50%, #004F8C 90%);
            color: var(--white);
            border: none;
            padding: 14px 32px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 4px 12px rgba(51, 133, 195, 0.25);
        }

            .btn-reset:hover {
                background: linear-gradient(135deg, #2875B3 0%, #005A9C 100%);
                transform: translateY(-2px);
            }

        /* ========== BULK ORDER SECTION ========== */
        .bulk-order-section {
            background: linear-gradient(135deg, var(--bg-light) 0%, var(--white) 100%);
            padding: 60px;
            border-radius: 16px;
            margin-top: 60px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-color);
            position: relative;
            overflow: hidden;
        }

            .bulk-order-section::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 6px;
                background: linear-gradient(90deg, #3385C3 0%, var(--secondary-color) 100%);
            }

        .bulk-content {
            position: relative;
            z-index: 1;
        }

        .bulk-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .bulk-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 80px;
            height: 80px;
            background: linear-gradient(0deg, #004F8C 0%, #0066B3 50%, #004F8C 90%);
            color: var(--white);
            border-radius: 20px;
            font-size: 36px;
            margin-bottom: 24px;
            box-shadow: var(--shadow-md);
        }

        .bulk-header h3 {
            font-weight: 800;
            color: var(--dark-text);
            margin-bottom: 12px;
            font-size: 36px;
        }

        .bulk-header p {
            color: var(--light-text);
            font-size: 18px;
            max-width: 600px;
            margin: 0 auto;
        }

        /* Bulk Tiers */
        .bulk-tiers {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 28px;
            margin-bottom: 48px;
        }

        .bulk-tier {
            background: var(--white);
            border: 2px solid var(--border-color);
            padding: 40px 32px;
            text-align: center;
            border-radius: 16px;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

            .bulk-tier::before {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 6px;
                background: linear-gradient(90deg, #3385C3 0%, var(--secondary-color) 100%);
                transform: scaleX(0);
                transition: var(--transition);
            }

            .bulk-tier:hover::before {
                transform: scaleX(1);
            }

            .bulk-tier:hover {
                border-color: var(--primary-color);
                transform: translateY(-10px);
                box-shadow: var(--shadow-lg);
            }

            .bulk-tier.featured {
                border-color: var(--secondary-color);
                box-shadow: var(--shadow-md);
            }

        .popular-tag {
            position: absolute;
            top: -12px;
            right: 30px;
            background: linear-gradient(135deg, var(--secondary-color) 0%, var(--secondary-dark) 100%);
            color: var(--white);
            padding: 8px 20px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            box-shadow: 0 4px 12px rgba(255, 165, 0, 0.4);
        }

        .tier-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 20px;
        }

        .tier-icon {
            font-size: 48px;
            color: var(--primary-color);
            margin-bottom: 16px;
            transition: var(--transition);
        }

        .bulk-tier:hover .tier-icon {
            transform: scale(1.15) rotate(5deg);
        }

        .tier-badge {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

            .tier-badge.starter {
                background: rgba(108, 117, 125, 0.1);
                color: var(--light-text);
            }

            .tier-badge.popular {
                background: rgba(255, 165, 0, 0.15);
                color: var(--secondary-dark);
            }

            .tier-badge.enterprise {
                background: rgba(0, 79, 140, 0.15);
                color: var(--primary-color);
            }

        .bulk-tier h5 {
            color: var(--dark-text);
            font-weight: 700;
            margin-bottom: 20px;
            font-size: 20px;
        }

        .tier-discount {
            font-size: 48px;
            font-weight: 900;
            color: var(--success-color);
            margin: 20px 0;
            font-family: 'Segoe UI', sans-serif;
            line-height: 1;
        }

        .tier-features {
            list-style: none;
            padding: 0;
            margin: 24px 0 0;
            text-align: left;
        }

            .tier-features li {
                padding: 10px 0;
                color: var(--dark-text);
                font-size: 14px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .tier-features i {
                color: var(--success-color);
                font-size: 16px;
            }

        /* Bulk CTA */
        .bulk-cta {
            text-align: center;
            padding-top: 32px;
            border-top: 2px solid var(--border-color);
        }

        .btn-bulk-inquiry {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: linear-gradient(0deg, #004F8C 0%, #0066B3 50%, #004F8C 90%);
            color: var(--white);
            padding: 18px 48px;
            border-radius: 50px;
            border: none;
            text-decoration: none;
            font-weight: 700;
            font-size: 17px;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 8px 24px rgba(51, 133, 195, 0.3);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

            .btn-bulk-inquiry:hover {
                background: linear-gradient(135deg, #2875B3 0%, #005A9C 100%);
                transform: translateY(-4px);
                box-shadow: 0 12px 32px rgba(51, 133, 195, 0.4);
                color: var(--white);
            }

            .btn-bulk-inquiry i {
                font-size: 20px;
                transition: var(--transition);
            }

            .btn-bulk-inquiry:hover i {
                transform: rotate(15deg) scale(1.1);
            }

        /* Empty State */
        .empty-state {
            padding: 100px 20px;
            text-align: center;
        }

        .empty-content {
            max-width: 500px;
            margin: 0 auto;
        }

        .empty-state i {
            font-size: 100px;
            color: rgba(0, 79, 140, 0.15);
            margin-bottom: 32px;
        }

        .empty-state h3 {
            color: var(--dark-text);
            font-weight: 700;
            margin-bottom: 16px;
            font-size: 28px;
        }

        .empty-state p {
            color: var(--light-text);
            font-size: 16px;
            max-width: 500px;
            margin: 0 auto 32px;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: linear-gradient(0deg, #004F8C 0%, #0066B3 50%, #004F8C 90%);
            color: var(--white);
            padding: 16px 32px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 16px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 4px 12px rgba(51, 133, 195, 0.25);
        }

            .btn-primary:hover {
                background: linear-gradient(135deg, #2875B3 0%, #005A9C 100%);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(51, 133, 195, 0.35);
                color: var(--white);
                text-decoration: none;
            }

        /* ========== MODAL STYLES ========== */
        .modal-content {
            border: none;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .modal-header {
            border-bottom: 2px solid var(--border-color);
            padding: 24px 32px;
            background: linear-gradient(135deg, var(--bg-light) 0%, var(--white) 100%);
            border-radius: 16px 16px 0 0;
        }

            .modal-header .modal-title {
                font-weight: 700;
                color: var(--dark-text);
                font-size: 22px;
                display: flex;
                align-items: center;
            }

            .modal-header .btn-close {
                opacity: 0.6;
                transition: var(--transition);
            }

                .modal-header .btn-close:hover {
                    opacity: 1;
                    transform: rotate(90deg);
                }

        .modal-body {
            padding: 32px;
        }

        .modal-image-wrapper {
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            background: var(--bg-light);
            padding: 20px;
        }

            .modal-image-wrapper img {
                border-radius: 8px;
            }

        .modal-product-details {
            padding-left: 10px;
        }

            .modal-product-details h4 {
                font-size: 24px;
                font-weight: 700;
                color: var(--dark-text);
                margin-bottom: 16px;
            }

        .modal-rating {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

            .modal-rating .stars {
                display: flex;
                gap: 4px;
                color: var(--secondary-color);
                font-size: 16px;
            }

            .modal-rating .rating-count {
                color: var(--light-text);
                font-size: 14px;
            }

        .modal-description {
            color: var(--light-text);
            font-size: 15px;
            line-height: 1.7;
            margin-bottom: 24px;
        }

        .modal-price-section {
            background: var(--bg-light);
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 24px;
        }

        .modal-prices {
            display: flex;
            align-items: baseline;
            gap: 16px;
            margin-bottom: 8px;
        }

        .modal-price-current {
            font-size: 36px;
            font-weight: 800;
            color: var(--success-color);
        }

        .modal-price-original {
            font-size: 20px;
            color: #999;
            text-decoration: line-through;
        }

        .modal-gst {
            font-size: 13px;
            color: var(--light-text);
        }

        .modal-actions {
            display: flex;
            gap: 12px;
        }

        .btn-modal-enquire {
            width: 100%;
            background: linear-gradient(0deg, #004F8C 0%, #0066B3 50%, #004F8C 90%);
            color: var(--white);
            border: none;
            padding: 16px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 4px 12px rgba(51, 133, 195, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

            .btn-modal-enquire:hover {
                background: linear-gradient(135deg, #2875B3 0%, #005A9C 100%);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(51, 133, 195, 0.35);
            }

        /* ========== RESPONSIVE DESIGN ========== */

        /* Tablet */
        @@media (max-width: 991px) {
            .hero-content

        {
            padding: 0 20px;
        }

        .hero-main-title {
            font-size: 36px;
        }

        .hero-visual {
            height: 300px;
            margin-top: 40px;
        }

        .special-badge-container {
            width: 280px;
        }

        .special-badge-main {
            padding: 32px;
            flex-direction: column;
            text-align: center;
        }

        .badge-icon {
            width: 70px;
            height: 70px;
            font-size: 36px;
        }

        .badge-title {
            font-size: 24px;
        }

        .badge-subtitle {
            font-size: 30px;
        }

        .filters-sidebar {
            position: fixed;
            left: -100%;
            top: 0;
            height: 100vh;
            z-index: 1050;
            width: 320px;
            max-height: 100vh;
            transition: left 0.3s ease;
            border-radius: 0;
            max-width: 85vw;
        }

            .filters-sidebar.show-mobile {
                left: 0;
                box-shadow: 5px 0 25px rgba(0, 0, 0, 0.3);
            }

        body.filter-open {
            overflow: hidden;
        }

            body.filter-open::before {
                content: '';
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.5);
                z-index: 1040;
            }

        .bulk-order-section {
            padding: 40px;
        }

        .bulk-header h3 {
            font-size: 28px;
        }

        .products-list .product-card {
            flex-direction: column;
        }

        .products-list .product-image-wrapper {
            max-width: 100%;
        }

        }

        /* Mobile */
        @@media (max-width: 767px) {
            .offers-hero-banner

        {
            padding: 60px 0;
            border-radius: 12px;
        }

        .hero-content {
            padding: 0 16px;
        }

        .hero-main-title {
            font-size: 28px;
        }

        .hero-description {
            font-size: 16px;
        }

        .hero-stats {
            gap: 12px;
        }

        .stat-item {
            flex: 1;
            min-width: 100%;
            padding: 14px 18px;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            font-size: 20px;
        }

        .float-card {
            display: none;
        }

        .filter-sort-bar {
            padding: 16px 20px;
            flex-direction: column;
            align-items: stretch;
        }

        .filter-left,
        .filter-right {
            width: 100%;
            justify-content: space-between;
        }

        .filter-toggle-btn .btn-text {
            display: none;
        }

        .sort-select {
            min-width: 100%;
            width: 100%;
        }

        .products-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .product-card {
            border-radius: 12px;
        }

        .image-container {
            height: 240px;
        }

        .product-details {
            padding: 20px;
        }

        .bulk-order-section {
            padding: 32px 20px;
            border-radius: 12px;
        }

        .bulk-header {
            margin-bottom: 32px;
        }

        .bulk-icon {
            width: 64px;
            height: 64px;
            font-size: 28px;
        }

        .bulk-header h3 {
            font-size: 24px;
        }

        .bulk-header p {
            font-size: 16px;
        }

        .bulk-tiers {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .bulk-tier {
            padding: 32px 24px;
        }

        .tier-discount {
            font-size: 40px;
        }

        .btn-bulk-inquiry {
            padding: 16px 32px;
            font-size: 15px;
            width: 100%;
        }

        .modal-body {
            padding: 24px 20px;
        }

        .modal-header {
            padding: 20px 24px;
        }

        .modal-product-details {
            padding-left: 0;
            margin-top: 20px;
        }

        .modal-price-current {
            font-size: 28px;
        }

        }

        /* Small Mobile */
        @@media (max-width: 575px) {
            .hero-label

        {
            font-size: 12px;
            padding: 10px 18px;
        }

        .hero-main-title {
            font-size: 24px;
        }

        .hero-description {
            font-size: 15px;
        }

        .results-count {
            font-size: 13px;
        }

        .view-toggle {
            flex: 1;
        }

        .sort-select {
            font-size: 13px;
            padding: 10px 32px 10px 14px;
        }

        .product-title {
            font-size: 16px;
        }

        .price-current {
            font-size: 24px;
        }

        .price-original {
            font-size: 15px;
        }

        }

        /* ========== UTILITY CLASSES ========== */
        .text-primary-custom {
            color: var(--primary-color) !important;
        }

        .bg-primary-custom {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%) !important;
        }

        .border-primary-custom {
            border-color: var(--primary-color) !important;
        }

        /* ========== FOCUS STYLES ========== */
        a:focus-visible,
        button:focus-visible,
        input:focus-visible,
        select:focus-visible {
            outline: 3px solid var(--primary-color);
            outline-offset: 3px;
            box-shadow: 0 0 0 4px rgba(0, 79, 140, 0.1);
        }

        /* ========== SCROLLBAR STYLING ========== */
        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-light);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--primary-color);
            border-radius: 5px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: var(--primary-dark);
            }

        /* ========== LOADING ANIMATION ========== */
        @@keyframes shimmer {
            0%

        {
            background-position: -468px 0;
        }

        100% {
            background-position: 468px 0;
        }

        }

        .loading {
