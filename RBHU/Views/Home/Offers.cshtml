@model List<RBHU_DbServices.Models.Product>
@{
    ViewData["Title"] = "Special Offers";
}

<link href="~/css/offers.css" rel="stylesheet" />

<div class="page-content">
    <section class="section-padding offers-section">
        <div class="container">
            <!-- Enhanced Hero Banner -->
            <div class="row mb-4">
                <div class="col-lg-12">
                    <div class="offers-hero-banner">
                        <div class="hero-background-pattern"></div>
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-7">
                                    <div class="hero-content-left">
                                        <span class="hero-label">
                                            <i class="fas fa-bolt"></i> Limited Time Offers
                                        </span>
                                        <h1 class="hero-main-title">
                                            Exclusive Deals on
                                            <span class="title-highlight">Premium Tools</span>
                                        </h1>
                                        <p class="hero-description">
                                            Discover unbeatable prices on industrial-grade equipment and tools.
                                            Professional quality guaranteed with every purchase.
                                        </p>
                                        <div class="hero-stats">
                                            <div class="stat-item">
                                                <div class="stat-icon">
                                                    <i class="fas fa-tag"></i>
                                                </div>
                                                <div class="stat-content">
                                                    <h4>Get more discount by enquiring through</h4>
                                                    <p>Website</p>
                                                </div>
                                            </div>
                                            <div class="stat-item">
                                                <div class="stat-icon">
                                                    <i class="fas fa-truck"></i>
                                                </div>
                                                <div class="stat-content">
                                                    <h4>Fast Delivery</h4>
                                                    <p>On All Orders</p>
                                                </div>
                                            </div>
                                            <div class="stat-item">
                                                <div class="stat-icon">
                                                    <i class="fas fa-shield-alt"></i>
                                                </div>
                                                <div class="stat-content">
                                                    <h4>Warranty</h4>
                                                    <p>Quality Assured</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-5">
                                    <div class="hero-visual">
                                        <div class="discount-badge-large">
                                            <div class="badge-inner">
                                                <span class="discount-percent">Offer</span>
                                                <span class="discount-label"></span>
                                            </div>
                                            <div class="badge-accent"></div>
                                        </div>
                                        <div class="floating-elements">
                                            <div class="float-card card-1">
                                                <i class="fas fa-star"></i>
                                                <span>Top Rated</span>
                                            </div>
                                            <div class="float-card card-2">
                                                <i class="fas fa-fire"></i>
                                                <span>Hot Deals</span>
                                            </div>
                                            <div class="float-card card-3">
                                                <i class="fas fa-bolt"></i>
                                                <span>Flash Sale</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <!-- Filters & Sorting Bar -->
                <div class="row mb-4">
                    <div class="col-lg-12">
                        <div class="filter-sort-bar">
                            <div class="filter-left">
                                <button class="filter-toggle-btn" id="filterToggleBtn">
                                    <i class="fas fa-filter"></i> Filters
                                </button>
                                <span class="results-count">Showing <strong>@Model.Count</strong> products</span>
                            </div>

                            <div class="filter-right">
                                <div class="view-toggle">
                                    <button class="view-btn active" data-view="grid" title="Grid View">
                                        <i class="fas fa-th"></i>
                                    </button>
                                    <button class="view-btn" data-view="list" title="List View">
                                        <i class="fas fa-list"></i>
                                    </button>
                                </div>

                                <select class="sort-select" id="sortSelect">
                                    <option value="featured">Featured</option>
                                    <option value="price-low">Price: Low to High</option>
                                    <option value="price-high">Price: High to Low</option>
                                    <option value="discount">Discount: High to Low</option>
                                    <option value="name">Name: A to Z</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Sidebar Filters -->
                    <div class="col-lg-3 col-md-4 mb-4">
                        <div class="filters-sidebar" id="filtersSidebar">
                            <div class="filters-header">
                                <h5><i class="fas fa-sliders-h"></i> Filters</h5>
                                <button class="clear-filters-btn" id="clearFiltersBtn">Clear All</button>
                            </div>

                            <!-- Category Filter -->
                            <div class="filter-section">
                                <h6 class="filter-title" data-bs-toggle="collapse" data-bs-target="#categoryFilter">
                                    Category <i class="fas fa-chevron-down"></i>
                                </h6>
                                <div class="collapse show" id="categoryFilter">
                                    <div class="filter-options">
                                        @foreach (var category in Model.Select(p => p.Category?.Name).Distinct().Where(c => !string.IsNullOrEmpty(c)))
                                        {
                                            <label class="filter-option">
                                                <input type="checkbox" class="filter-checkbox" name="category" value="@category">
                                                <span>@category</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Price Range Filter -->
                            <div class="filter-section">
                                <h6 class="filter-title" data-bs-toggle="collapse" data-bs-target="#priceFilter">
                                    Price Range <i class="fas fa-chevron-down"></i>
                                </h6>
                                <div class="collapse show" id="priceFilter">
                                    <div class="filter-options">
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="price" value="0-5000">
                                            <span>Under ₹5,000</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="price" value="5000-10000">
                                            <span>₹5,000 - ₹10,000</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="price" value="10000-25000">
                                            <span>₹10,000 - ₹25,000</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="price" value="25000-50000">
                                            <span>₹25,000 - ₹50,000</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="price" value="50000-999999">
                                            <span>Over ₹50,000</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Discount Filter -->
                            <div class="filter-section">
                                <h6 class="filter-title" data-bs-toggle="collapse" data-bs-target="#discountFilter">
                                    Discount <i class="fas fa-chevron-down"></i>
                                </h6>
                                <div class="collapse show" id="discountFilter">
                                    <div class="filter-options">
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="discount" value="50">
                                            <span>50% or more</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="discount" value="40">
                                            <span>40% or more</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="discount" value="30">
                                            <span>30% or more</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="discount" value="20">
                                            <span>20% or more</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="discount" value="10">
                                            <span>10% or more</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Special Offers Banner in Sidebar -->
                            <div class="sidebar-promo">
                                <div class="promo-icon">🎁</div>
                                <h6>Bulk Order Discounts</h6>
                                <p>Get up to 15% extra off on bulk orders!</p>
                                <a href="#" class="promo-link" data-bs-toggle="modal" data-bs-target="#contactModal">Learn More →</a>
                            </div>
                        </div>
                    </div>

                    <!-- Products Grid -->
                    <div class="col-lg-9 col-md-8">
                        <div id="productsContainer" class="products-grid">
                            @foreach (var product in Model)
                            {
                                var discountPercentage = Math.Round(((product.Price - product.OfferPrice) / product.Price) * 100);
                                var savings = product.Price - product.OfferPrice;
                                var rating = 3.5 + (new Random().NextDouble() * 1.5);
                                var reviewCount = new Random().Next(50, 500);

                                <div class="product-card"
                                     data-category="@(product.Category?.Name ?? "Uncategorized")"
                                     data-price="@product.OfferPrice"
                                     data-discount="@discountPercentage"
                                     data-name="@product.Name"
                                     data-aos="fade-up">

                                    <!-- Badges -->
                                    <div class="product-badges">
                                        <span class="badge-discount">@discountPercentage% OFF</span>
                                        @if (discountPercentage >= 50)
                                        {
                                            <span class="badge-hot">🔥 HOT DEAL</span>
                                        }
                                    </div>

                                    <!-- Quick View Button Only -->
                                    <div class="quick-actions">
                                        <button class="action-btn quickview-btn" title="Quick View" data-product-id="@product.Id">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>

                                    <!-- Product Image -->
                                    <div class="product-image-wrapper">
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl" alt="@product.Name" class="product-image card-img-top">
                                        }
                                        else
                                        {
                                            <img src="https://via.placeholder.com/400x400?text=No+Image" alt="@product.Name" class="product-image card-img-top">
                                        }
                                    </div>

                                    <!-- Product Details -->
                                    <div class="product-details">
                                        <!-- Category Tags -->
                                        <div class="category-tags-inline">
                                            @if (product.Category != null)
                                            {
                                                <span class="tag-category">@product.Category.Name</span>
                                            }
                                        </div>

                                        <!-- Product Title -->
                                        <h5 class="product-title">
                                            <a href="#" class="product-link">@product.Name</a>
                                        </h5>

                                        <!-- Description -->
                                        <p class="product-description">@product.Description</p>

                                        <!-- Price Section -->
                                        <div class="price-section">
                                            <div class="prices">
                                                <span class="price-current">₹@product.OfferPrice.ToString("N0")</span>
                                                <span class="price-original">₹@product.Price.ToString("N0")</span>
                                                <span> + GST</span>
                                            </div>
                                            <div class="savings-info">
                                                <span class="savings-amount">Save ₹@savings.ToString("N0")</span>
                                            </div>
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="product-actions">
                                            <button class="btn-enquire" data-bs-toggle="modal" data-bs-target="#contactModal">
                                                <i class="fas fa-envelope"></i> Enquire Now
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- No Results Message -->
                        <div id="noResults" class="no-results" style="display: none;">
                            <i class="fas fa-search fa-3x mb-3"></i>
                            <h4>No products found</h4>
                            <p>Try adjusting your filters or search criteria</p>
                        </div>
                    </div>
                </div>

                <!-- Bulk Order Section -->
                <div class="row mt-5">
                    <div class="col-lg-12">
                        <div class="bulk-order-section" data-aos="fade-up">
                            <div class="bulk-header">
                                <h3><i class="fas fa-boxes"></i> Bulk Order Discounts</h3>
                                <p>Get additional discounts on bulk purchases</p>
                            </div>
                            <div class="bulk-tiers">
                                <div class="bulk-tier">
                                    <div class="tier-icon">
                                        <i class="fas fa-box"></i>
                                    </div>
                                    <div class="tier-details">
                                        <h5>10-50 Items</h5>
                                        <p class="tier-discount">+5% OFF</p>
                                        <span class="tier-badge">Starter Pack</span>
                                    </div>
                                </div>
                                <div class="bulk-tier">
                                    <div class="tier-icon">
                                        <i class="fas fa-boxes"></i>
                                    </div>
                                    <div class="tier-details">
                                        <h5>51-100 Items</h5>
                                        <p class="tier-discount">+10% OFF</p>
                                        <span class="tier-badge">Popular</span>
                                    </div>
                                </div>
                                <div class="bulk-tier">
                                    <div class="tier-icon">
                                        <i class="fas fa-warehouse"></i>
                                    </div>
                                    <div class="tier-details">
                                        <h5>100+ Items</h5>
                                        <p class="tier-discount">+15% OFF</p>
                                        <span class="tier-badge">Best Value</span>
                                    </div>
                                </div>
                            </div>
                            <div class="bulk-cta">
                                <button type="button" class="btn-bulk-inquiry" data-bs-toggle="modal" data-bs-target="#contactModal">
                                    <i class="fas fa-phone"></i> Contact for Bulk Orders
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-12">
                        <div class="empty-state">
                            <i class="fas fa-tag fa-4x mb-4"></i>
                            <h3>No Special Offers Available</h3>
                            <p>Check back later for exciting deals on our products!</p>
                            <a asp-controller="Home" asp-action="Products" class="btn btn-primary btn-lg mt-3">
                                <i class="fas fa-shopping-bag"></i> Browse All Products
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<!-- Quick View Modal -->
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Quick View</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <img src="https://via.placeholder.com/400x400" alt="Product" class="img-fluid rounded" id="quickViewImage">
                    </div>
                    <div class="col-md-6">
                        <h4 id="quickViewName">Product Name</h4>
                        <p id="quickViewDescription">Product description goes here...</p>
                        <div class="price-section mb-4">
                            <div class="prices">
                                <span class="price-current" id="quickViewOfferPrice">₹0</span>
                                <span class="price-original" id="quickViewPrice">₹0</span>
                            </div>
                        </div>
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#contactModal" data-bs-dismiss="modal">
                                <i class="fas fa-envelope"></i> Enquire Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts 
{
    <script>
        // View Toggle (Grid/List)
        document.querySelectorAll('.view-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                const view = this.getAttribute('data-view');
                const container = document.getElementById('productsContainer');

                if (view === 'list') {
                    container.classList.add('products-list');
                } else {
                    container.classList.remove('products-list');
                }
            });
        });

        // Sorting Functionality
        document.getElementById('sortSelect').addEventListener('change', function () {
            const sortValue = this.value;
            const container = document.getElementById('productsContainer');
            const products = Array.from(container.querySelectorAll('.product-card'));

            products.sort((a, b) => {
                switch (sortValue) {
                    case 'price-low':
                        return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
                    case 'price-high':
                        return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
                    case 'discount':
                        return parseFloat(b.dataset.discount) - parseFloat(a.dataset.discount);
                    case 'name':
                        return a.dataset.name.localeCompare(b.dataset.name);
                    default:
                        return 0;
                }
            });

            products.forEach(product => container.appendChild(product));
        });

        // Filter Functionality
        function applyFilters() {
            const categoryFilters = Array.from(document.querySelectorAll('input[name="category"]:checked')).map(el => el.value);
            const priceFilters = Array.from(document.querySelectorAll('input[name="price"]:checked')).map(el => el.value);
            const discountFilters = Array.from(document.querySelectorAll('input[name="discount"]:checked')).map(el => el.value);

            const products = document.querySelectorAll('.product-card');
            let visibleCount = 0;

            products.forEach(product => {
                let show = true;

                // Category filter
                if (categoryFilters.length > 0 && !categoryFilters.includes(product.dataset.category)) {
                    show = false;
                }

                // Price filter
                if (priceFilters.length > 0) {
                    const price = parseFloat(product.dataset.price);
                    const matchesPrice = priceFilters.some(range => {
                        const [min, max] = range.split('-').map(Number);
                        return price >= min && price <= max;
                    });
                    if (!matchesPrice) show = false;
                }

                // Discount filter
                if (discountFilters.length > 0) {
                    const discount = parseFloat(product.dataset.discount);
                    const matchesDiscount = discountFilters.some(minDiscount => discount >= parseFloat(minDiscount));
                    if (!matchesDiscount) show = false;
                }

                product.style.display = show ? '' : 'none';
                if (show) visibleCount++;
            });

            // Update results count
            document.querySelector('.results-count strong').textContent = visibleCount;

            // Show no results message
            document.getElementById('noResults').style.display = visibleCount === 0 ? 'block' : 'none';
        }

        // Attach filter listeners
        document.querySelectorAll('.filter-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', applyFilters);
        });

        // Clear filters
        document.getElementById('clearFiltersBtn').addEventListener('click', function () {
            document.querySelectorAll('.filter-checkbox').forEach(checkbox => {
                checkbox.checked = false;
            });
            applyFilters();
        });

        // Mobile filter toggle
        document.getElementById('filterToggleBtn').addEventListener('click', function () {
            document.getElementById('filtersSidebar').classList.toggle('show-mobile');
        });

        // Quick View functionality
        document.querySelectorAll('.quickview-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const productCard = this.closest('.product-card');
                const name = productCard.querySelector('.product-title a').textContent;
                const image = productCard.querySelector('.product-image').src;
                const description = productCard.querySelector('.product-description').textContent;
                const offerPrice = productCard.querySelector('.price-current').textContent;
                const originalPrice = productCard.querySelector('.price-original').textContent;

                document.getElementById('quickViewName').textContent = name;
                document.getElementById('quickViewImage').src = image;
                document.getElementById('quickViewDescription').textContent = description;
                document.getElementById('quickViewOfferPrice').textContent = offerPrice;
                document.getElementById('quickViewPrice').textContent = originalPrice;

                const modal = new bootstrap.Modal(document.getElementById('quickViewModal'));
                modal.show();
            });
        });

        // Close mobile sidebar when clicking outside
        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('filtersSidebar');
            const toggleBtn = document.getElementById('filterToggleBtn');

            if (sidebar.classList.contains('show-mobile') &&
                !sidebar.contains(event.target) &&
                !toggleBtn.contains(event.target)) {
                sidebar.classList.remove('show-mobile');
            }
        });
    </script>

<style>
    /* ==========================================
       OFFERS PAGE - MODERN FLAT THEME
       Clean, Industrial, Functional
       ========================================== */

    .offers-wrapper {
        background: #fff;
        width: 100%;
        overflow-x: hidden;
    }

    /* ========== HERO SECTION ========== */
        /* Professional Hero Banner Styles */
        .offers-hero-banner {
            position: relative;
            background: linear-gradient(135deg, #004F8C 0%, #003D6E 100%);
            padding: 100px 0 80px;
            overflow: hidden;
            margin-bottom: 0;
        }

        .hero-background-pattern {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            opacity: 0.05;
            background-image: repeating-linear-gradient(90deg, transparent, transparent 50px, rgba(255,255,255,0.1) 50px, rgba(255,255,255,0.1) 51px), repeating-linear-gradient(0deg, transparent, transparent 50px, rgba(255,255,255,0.1) 50px, rgba(255,255,255,0.1) 51px);
        }

        .hero-content-left {
            position: relative;
            z-index: 2;
        }

        .hero-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            color: #fff;
            padding: 10px 20px;
            border-radius: 50px;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 24px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

            .hero-label i {
                color: #FFA500;
            }

        .hero-main-title {
            font-size: clamp(36px, 5vw, 52px);
            font-weight: 700;
            line-height: 1.2;
            color: #fff;
            margin-bottom: 20px;
        }

        .title-highlight {
            display: block;
            background: linear-gradient(90deg, #FFA500 0%, #FFD700 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-top: 8px;
        }

        .hero-description {
            font-size: 18px;
            line-height: 1.7;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 40px;
            max-width: 540px;
        }

        .hero-stats {
            display: flex;
            gap: 30px;
            flex-wrap: wrap;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 16px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 16px 24px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #FFA500 0%, #FF8C00 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: #fff;
        }

        .stat-content h4 {
            font-size: 18px;
            font-weight: 700;
            color: #fff;
            margin: 0 0 4px 0;
        }

        .stat-content p {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.8);
            margin: 0;
        }

        /* Hero Visual Section */
        .hero-visual {
            position: relative;
            height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .discount-badge-large {
            position: relative;
            width: 280px;
            height: 280px;
            background: linear-gradient(135deg, #FFA500 0%, #FF8C00 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 20px 60px rgba(255, 165, 0, 0.4);
            animation: pulse 3s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        }

        .badge-inner {
            text-align: center;
        }

        .discount-percent {
            display: block;
            font-size: 72px;
            font-weight: 900;
            color: #fff;
            line-height: 1;
        }

        .discount-label {
            display: block;
            font-size: 28px;
