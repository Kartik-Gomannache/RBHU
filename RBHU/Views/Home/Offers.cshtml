@model List<RBHU_DbServices.Models.Product>
@{
    ViewData["Title"] = "Special Offers | Exclusive Deals on Industrial Tools Goa";
    ViewData["Description"] = "Save big on premium industrial tools! Limited time offers on Makita, Bosch, Chicago Pneumatic equipment in Goa. PPE safety gear, power tools, pneumatic systems at unbeatable prices. Bulk discounts available.";
}

<link href="~/css/offers.css" rel="stylesheet" />

<div class="page-content">
    <section class="section-padding offers-section" style="margin-top: 80px;">
        <div class="container">
            <!-- Enhanced Hero Banner -->
            <div class="row mb-5">
                <div class="col-12">
                    <div class="offers-hero-banner">
                        <div class="hero-background-pattern"></div>
                        <div class="hero-content">
                            <div class="row align-items-center g-4">
                                <div class="col-lg-7">
                                    <div class="hero-content-left">
                                        <span class="hero-label">
                                            <i class="fas fa-bolt"></i> Limited Time Offers
                                        </span>
                                        <h1 class="hero-main-title">
                                            Exclusive Deals on
                                            <span class="title-highlight">Premium Industrial Tools</span>
                                        </h1>
                                        <p class="hero-description">
                                            Discover unbeatable prices on professional-grade industrial equipment.
                                            Quality guaranteed with manufacturer warranty on every purchase.
                                        </p>
                                        <div class="hero-stats">
                                            <div class="stat-item">
                                                <div class="stat-icon">
                                                    <i class="fas fa-percentage"></i>
                                                </div>
                                                <div class="stat-content">
                                                    <h4>Extra Discounts</h4>
                                                    <p>Order via Website</p>
                                                </div>
                                            </div>
                                            <div class="stat-item">
                                                <div class="stat-icon">
                                                    <i class="fas fa-truck-fast"></i>
                                                </div>
                                                <div class="stat-content">
                                                    <h4>Fast Delivery</h4>
                                                    <p>Pan India Delivery</p>
                                                </div>
                                            </div>
                                            <div class="stat-item">
                                                <div class="stat-icon">
                                                    <i class="fas fa-shield-check"></i>
                                                </div>
                                                <div class="stat-content">
                                                    <h4>Genuine Products</h4>
                                                    <p>100% Authentic</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-5">
                                    <div class="hero-visual">
                                        <div class="special-badge-container">
                                            <div class="special-badge-main">
                                                <div class="badge-icon">
                                                    <i class="fas fa-bolt"></i>
                                                </div>
                                                <div class="badge-content">
                                                    <span class="badge-title">SPECIAL</span>
                                                    <span class="badge-subtitle">OFFERS</span>
                                                </div>
                                            </div>
                                            <div class="badge-features">
                                                <div class="feature-item">
                                                    <i class="fas fa-check-circle"></i>
                                                    <span>Best Prices</span>
                                                </div>
                                                <div class="feature-item">
                                                    <i class="fas fa-check-circle"></i>
                                                    <span>Genuine Products</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="floating-elements">
                                            <div class="float-card card-1">
                                                <i class="fas fa-star"></i>
                                                <span>Top Rated</span>
                                            </div>
                                            <div class="float-card card-2">
                                                <i class="fas fa-fire"></i>
                                                <span>Hot Deals</span>
                                            </div>
                                            <div class="float-card card-3">
                                                <i class="fas fa-clock"></i>
                                                <span>Limited Time</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <!-- Filters & Sorting Bar -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="filter-sort-bar">
                            <div class="filter-left">
                                <button class="filter-toggle-btn" id="filterToggleBtn">
                                    <i class="fas fa-filter"></i>
                                    <span class="btn-text">Filters</span>
                                </button>
                                <span class="results-count">
                                    <strong>@Model.Count</strong> Products Available
                                </span>
                            </div>

                            <div class="filter-right">
                                <div class="view-toggle">
                                    <button class="view-btn active" data-view="grid" title="Grid View">
                                        <i class="fas fa-th-large"></i>
                                    </button>
                                    <button class="view-btn" data-view="list" title="List View">
                                        <i class="fas fa-list-ul"></i>
                                    </button>
                                </div>

                                <div class="sort-dropdown">
                                    <select class="sort-select" id="sortSelect">
                                        <option value="featured">Sort by: Featured</option>
                                        <option value="price-low">Price: Low to High</option>
                                        <option value="price-high">Price: High to Low</option>
                                        <option value="discount">Discount: High to Low</option>
                                        <option value="name">Name: A to Z</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Sidebar Filters -->
                    <div class="col-lg-3 col-md-4 mb-4">
                        <div class="filters-sidebar" id="filtersSidebar">
                            <div class="filters-header">
                                <h5><i class="fas fa-sliders-h me-2"></i>Filter Products</h5>
                                <button class="clear-filters-btn" id="clearFiltersBtn">
                                    <i class="fas fa-times-circle me-1"></i>Clear All
                                </button>
                            </div>

                            <!-- Category Filter -->
                            <div class="filter-section">
                                <h6 class="filter-title" data-bs-toggle="collapse" data-bs-target="#categoryFilter">
                                    <span><i class="fas fa-tags me-2"></i>Category</span>
                                    <i class="fas fa-chevron-down"></i>
                                </h6>
                                <div class="collapse show" id="categoryFilter">
                                    <div class="filter-options">
                                        @foreach (var category in Model.Select(p => p.Category?.Name).Distinct().Where(c => !string.IsNullOrEmpty(c)))
                                        {
                                            <label class="filter-option">
                                                <input type="checkbox" class="filter-checkbox" name="category" value="@category">
                                                <span class="checkmark"></span>
                                                <span class="filter-label">@category</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Price Range Filter -->
                            <div class="filter-section">
                                <h6 class="filter-title" data-bs-toggle="collapse" data-bs-target="#priceFilter">
                                    <span><i class="fas fa-rupee-sign me-2"></i>Price Range</span>
                                    <i class="fas fa-chevron-down"></i>
                                </h6>
                                <div class="collapse show" id="priceFilter">
                                    <div class="filter-options">
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="price" value="0-5000">
                                            <span class="checkmark"></span>
                                            <span class="filter-label">Under ₹5,000</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="price" value="5000-10000">
                                            <span class="checkmark"></span>
                                            <span class="filter-label">₹5,000 - ₹10,000</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="price" value="10000-25000">
                                            <span class="checkmark"></span>
                                            <span class="filter-label">₹10,000 - ₹25,000</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="price" value="25000-50000">
                                            <span class="checkmark"></span>
                                            <span class="filter-label">₹25,000 - ₹50,000</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="price" value="50000-999999">
                                            <span class="checkmark"></span>
                                            <span class="filter-label">Above ₹50,000</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Discount Filter -->
                            <div class="filter-section">
                                <h6 class="filter-title" data-bs-toggle="collapse" data-bs-target="#discountFilter">
                                    <span><i class="fas fa-badge-percent me-2"></i>Discount</span>
                                    <i class="fas fa-chevron-down"></i>
                                </h6>
                                <div class="collapse show" id="discountFilter">
                                    <div class="filter-options">
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="discount" value="50">
                                            <span class="checkmark"></span>
                                            <span class="filter-label">50% or more</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="discount" value="40">
                                            <span class="checkmark"></span>
                                            <span class="filter-label">40% or more</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="discount" value="30">
                                            <span class="checkmark"></span>
                                            <span class="filter-label">30% or more</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="discount" value="20">
                                            <span class="checkmark"></span>
                                            <span class="filter-label">20% or more</span>
                                        </label>
                                        <label class="filter-option">
                                            <input type="checkbox" class="filter-checkbox" name="discount" value="10">
                                            <span class="checkmark"></span>
                                            <span class="filter-label">10% or more</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Special Offers Banner in Sidebar -->
                            <div class="sidebar-promo">
                                <div class="promo-icon">
                                    <i class="fas fa-gift"></i>
                                </div>
                                <h6>Bulk Order Benefits</h6>
                                <p>Get additional discounts up to 15% on bulk orders!</p>
                                <button class="promo-link" data-bs-toggle="modal" data-bs-target="#contactModal">
                                    Contact Us <i class="fas fa-arrow-right ms-2"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Products Grid -->
                    <div class="col-lg-9 col-md-8">
                        <div id="productsContainer" class="products-grid">
                            @foreach (var product in Model)
                            {
                                var discountPercentage = Math.Round(((product.Price - product.OfferPrice) / product.Price) * 100);
                                var savings = product.Price - product.OfferPrice;

                                <div class="product-card"
                                     data-category="@(product.Category?.Name ?? "Uncategorized")"
                                     data-price="@product.OfferPrice"
                                     data-discount="@discountPercentage"
                                     data-name="@product.Name">

                                    <!-- Badges -->
                                    <div class="product-badges">
                                        @if (discountPercentage >= 50)
                                        {
                                            <span class="badge-hot"><i class="fas fa-fire"></i> MEGA DEAL</span>
                                        }
                                        <span class="badge-discount">@discountPercentage% OFF</span>
                                    </div>

                                    <!-- Quick View Button -->
                                    <div class="quick-actions">
                                        <button class="action-btn quickview-btn" title="Quick View" data-product-id="@product.Id">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>

                                    <!-- Product Image -->
                                    <div class="product-image-wrapper">
                                        <div class="image-container">
                                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                                            {
                                                <img src="@product.ImageUrl"
                                                     alt="@product.Name - @(product.Category?.Name ?? "Industrial Tool") on special offer at RBHU Solutions Goa"
                                                     class="product-image"
                                                     loading="lazy">
                                            }
                                            else
                                            {
                                                <img src="https://via.placeholder.com/400x400?text=No+Image"
                                                     alt="@product.Name - Product image placeholder"
                                                     class="product-image"
                                                     loading="lazy">
                                            }
                                        </div>
                                    </div>

                                    <!-- Product Details -->
                                    <div class="product-details">
                                        <!-- Category Tag -->
                                        <div class="category-tags">
                                            @if (product.Category != null)
                                            {
                                                <span class="category-tag">
                                                    <i class="fas fa-tag"></i> @product.Category.Name
                                                </span>
                                            }
                                        </div>

                                        <!-- Product Title -->
                                        <h5 class="product-title">
                                            <a href="#" class="product-link">@product.Name</a>
                                        </h5>

                                        <!-- Description -->
                                        <p class="product-description">@product.Description</p>

                                        <!-- Price Section -->
                                        <div class="price-section">
                                            <div class="price-wrapper">
                                                <div class="prices">
                                                    <span class="price-current">₹@product.OfferPrice.ToString("N0")</span>
                                                    <span class="price-original">₹@product.Price.ToString("N0")</span>
                                                </div>
                                                <div class="savings-badge">
                                                    <i class="fas fa-tags"></i> Save ₹@savings.ToString("N0")
                                                </div>
                                            </div>
                                            <div class="gst-info">
                                                <i class="fas fa-info-circle"></i> + GST Extra
                                            </div>
                                        </div>

                                        <!-- Action Button -->
                                        <div class="product-actions">
                                            <button class="btn-enquire" data-bs-toggle="modal" data-bs-target="#contactModal">
                                                <i class="fas fa-envelope"></i>
                                                <span>Enquire Now</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- No Results Message -->
                        <div id="noResults" class="no-results" style="display: none;">
                            <div class="no-results-content">
                                <i class="fas fa-search"></i>
                                <h4>No Products Found</h4>
                                <p>Try adjusting your filters or search criteria to find what you're looking for</p>
                                <button class="btn-reset" id="resetFiltersBtn">
                                    <i class="fas fa-refresh"></i> Reset Filters
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bulk Order Section -->
                <div class="row mt-5">
                    <div class="col-12">
                        <div class="bulk-order-section">
                            <div class="bulk-content">
                                <div class="bulk-header">
                                    <div class="bulk-icon">
                                        <i class="fas fa-boxes-stacked"></i>
                                    </div>
                                    <h3>Bulk Order Discounts</h3>
                                    <p>Save more when you buy in bulk. Perfect for businesses and contractors!</p>
                                </div>

                                <div class="bulk-tiers">
                                    <div class="bulk-tier">
                                        <div class="tier-header">
                                            <div class="tier-icon">
                                                <i class="fas fa-box"></i>
                                            </div>
                                            <span class="tier-badge starter">Starter</span>
                                        </div>
                                        <h5>10-50 Items</h5>
                                        <div class="tier-discount">+5% OFF</div>
                                        <ul class="tier-features">
                                            <li><i class="fas fa-check"></i> Standard Support</li>
                                            <li><i class="fas fa-check"></i> Free Shipping</li>
                                        </ul>
                                    </div>

                                    <div class="bulk-tier featured">
                                        <div class="popular-tag">
                                            <i class="fas fa-star"></i> POPULAR
                                        </div>
                                        <div class="tier-header">
                                            <div class="tier-icon">
                                                <i class="fas fa-boxes"></i>
                                            </div>
                                            <span class="tier-badge popular">Business</span>
                                        </div>
                                        <h5>51-100 Items</h5>
                                        <div class="tier-discount">+10% OFF</div>
                                        <ul class="tier-features">
                                            <li><i class="fas fa-check"></i> Priority Support</li>
                                            <li><i class="fas fa-check"></i> Free Installation Guide</li>
                                            <li><i class="fas fa-check"></i> Extended Warranty</li>
                                        </ul>
                                    </div>

                                    <div class="bulk-tier">
                                        <div class="tier-header">
                                            <div class="tier-icon">
                                                <i class="fas fa-warehouse"></i>
                                            </div>
                                            <span class="tier-badge enterprise">Enterprise</span>
                                        </div>
                                        <h5>100+ Items</h5>
                                        <div class="tier-discount">+15% OFF</div>
                                        <ul class="tier-features">
                                            <li><i class="fas fa-check"></i> Dedicated Account Manager</li>
                                            <li><i class="fas fa-check"></i> Custom Solutions</li>
                                            <li><i class="fas fa-check"></i> Flexible Payment Terms</li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="bulk-cta">
                                    <button class="btn-bulk-inquiry" data-bs-toggle="modal" data-bs-target="#contactModal">
                                        <i class="fas fa-phone-volume"></i>
                                        <span>Request Bulk Quote</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-12">
                        <div class="empty-state">
                            <div class="empty-content">
                                <i class="fas fa-tag"></i>
                                <h3>No Special Offers Available</h3>
                                <p>Check back soon for exciting deals on premium industrial equipment!</p>
                                <a asp-controller="Home" asp-action="Products" class="btn-primary">
                                    <i class="fas fa-shopping-bag"></i>
                                    <span>Browse All Products</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<!-- Quick View Modal -->
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-eye me-2"></i>Quick View</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-5">
                        <div class="modal-image-wrapper">
                            <img src="https://via.placeholder.com/400x400" alt="Product" class="img-fluid" id="quickViewImage">
                        </div>
                    </div>
                    <div class="col-md-7">
                        <div class="modal-product-details">
                            <h4 id="quickViewName">Product Name</h4>
                            @* <div class="modal-rating">
                                <div class="stars">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star-half-alt"></i>
                                </div>
                                <span class="rating-count">(4.5 out of 5)</span>
                            </div> *@
                            <p class="modal-description" id="quickViewDescription">Product description goes here...</p>
                            <div class="modal-price-section">
                                <div class="modal-prices">
                                    <span class="modal-price-current" id="quickViewOfferPrice">₹0</span>
                                    <span class="modal-price-original" id="quickViewPrice">₹0</span>
                                </div>
                                <div class="modal-gst">+ GST Extra</div>
                            </div>
                            <div class="modal-actions">
                                <button class="btn-modal-enquire" data-bs-toggle="modal" data-bs-target="#contactModal" data-bs-dismiss="modal">
                                    <i class="fas fa-envelope"></i>
                                    <span>Send Enquiry</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        // View Toggle (Grid/List)
        document.querySelectorAll('.view-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                const view = this.getAttribute('data-view');
                const container = document.getElementById('productsContainer');

                if (view === 'list') {
                    container.classList.add('products-list');
                } else {
                    container.classList.remove('products-list');
                }
            });
        });

        // Sorting Functionality
        document.getElementById('sortSelect').addEventListener('change', function () {
            const sortValue = this.value;
            const container = document.getElementById('productsContainer');
            const products = Array.from(container.querySelectorAll('.product-card'));

            products.sort((a, b) => {
                switch (sortValue) {
                    case 'price-low':
                        return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
                    case 'price-high':
                        return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
                    case 'discount':
                        return parseFloat(b.dataset.discount) - parseFloat(a.dataset.discount);
                    case 'name':
                        return a.dataset.name.localeCompare(b.dataset.name);
                    default:
                        return 0;
                }
            });

            products.forEach(product => container.appendChild(product));
        });

        // Filter Functionality
        function applyFilters() {
            const categoryFilters = Array.from(document.querySelectorAll('input[name="category"]:checked')).map(el => el.value);
            const priceFilters = Array.from(document.querySelectorAll('input[name="price"]:checked')).map(el => el.value);
            const discountFilters = Array.from(document.querySelectorAll('input[name="discount"]:checked')).map(el => el.value);

            const products = document.querySelectorAll('.product-card');
            let visibleCount = 0;

            products.forEach(product => {
                let show = true;

                // Category filter
                if (categoryFilters.length > 0 && !categoryFilters.includes(product.dataset.category)) {
                    show = false;
                }

                // Price filter
                if (priceFilters.length > 0) {
                    const price = parseFloat(product.dataset.price);
                    const matchesPrice = priceFilters.some(range => {
                        const [min, max] = range.split('-').map(Number);
                        return price >= min && price <= max;
                    });
                    if (!matchesPrice) show = false;
                }

                // Discount filter
                if (discountFilters.length > 0) {
                    const discount = parseFloat(product.dataset.discount);
                    const matchesDiscount = discountFilters.some(minDiscount => discount >= parseFloat(minDiscount));
                    if (!matchesDiscount) show = false;
                }

                product.style.display = show ? '' : 'none';
                if (show) visibleCount++;
            });

            // Update results count
            document.querySelector('.results-count strong').textContent = visibleCount;

            // Show no results message
            document.getElementById('noResults').style.display = visibleCount === 0 ? 'flex' : 'none';
        }

        // Attach filter listeners
        document.querySelectorAll('.filter-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', applyFilters);
        });

        // Clear filters
        document.getElementById('clearFiltersBtn').addEventListener('click', function () {
            document.querySelectorAll('.filter-checkbox').forEach(checkbox => {
                checkbox.checked = false;
            });
            applyFilters();
        });

        // Reset filters from no results
        const resetBtn = document.getElementById('resetFiltersBtn');
        if (resetBtn) {
            resetBtn.addEventListener('click', function() {
                document.querySelectorAll('.filter-checkbox').forEach(checkbox => {
                    checkbox.checked = false;
                });
                applyFilters();
            });
        }

        // Mobile filter toggle
        document.getElementById('filterToggleBtn').addEventListener('click', function () {
            const sidebar = document.getElementById('filtersSidebar');
            sidebar.classList.toggle('show-mobile');
            document.body.classList.toggle('filter-open');
        });

        // Quick View functionality
        document.querySelectorAll('.quickview-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const productCard = this.closest('.product-card');
                const name = productCard.querySelector('.product-title a').textContent;
                const image = productCard.querySelector('.product-image').src;
                const description = productCard.querySelector('.product-description').textContent;
                const offerPrice = productCard.querySelector('.price-current').textContent;
                const originalPrice = productCard.querySelector('.price-original').textContent;

                document.getElementById('quickViewName').textContent = name;
                document.getElementById('quickViewImage').src = image;
                document.getElementById('quickViewDescription').textContent = description;
                document.getElementById('quickViewOfferPrice').textContent = offerPrice;
                document.getElementById('quickViewPrice').textContent = originalPrice;

                const modal = new bootstrap.Modal(document.getElementById('quickViewModal'));
                modal.show();
            });
        });

        // Close mobile sidebar when clicking outside
        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('filtersSidebar');
            const toggleBtn = document.getElementById('filterToggleBtn');

            if (sidebar.classList.contains('show-mobile') &&
                !sidebar.contains(event.target) &&
                !toggleBtn.contains(event.target)) {
                sidebar.classList.remove('show-mobile');
                document.body.classList.remove('filter-open');
            }
        });

        // Smooth scroll animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.product-card').forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            observer.observe(card);
        });
