@{
    ViewData["Title"] = "RBHU Solutions - Industrial Equipment & Tools Provider";
}

<link href="~/css/home.css" rel="stylesheet" />
<div class="rbhu-professional-wrapper">
    <!-- Ultra-Premium Hero Section with Professional Carousel -->
    <section class="rbhu-hero-cinematic">
        <!-- Professional Rotating Background Carousel -->
        <picture class="rbhu-hero-picture">
            <img src="~/images/carousel/bosch.jpg" alt="Industrial Equipment Manufacturing - Bosch" class="rbhu-hero-bg-image active">
            <img src="~/images/carousel/makita.jpg" alt="Industrial Equipment Manufacturing - Makita" class="rbhu-hero-bg-image">
            <img src="~/images/carousel/klingspor.jpg" alt="Industrial Equipment Manufacturing - Klingspor" class="rbhu-hero-bg-image">
        </picture>

        <div class="container">
            <div class="rbhu-hero-content-cinematic">
                <div class="rbhu-hero-eyebrow">
                    <span class="rbhu-badge-premium">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <circle cx="6" cy="6" r="6" fill="currentColor" />
                        </svg>
                        Industry Leading Solutions
                    </span>
                </div>

                <h1 class="rbhu-hero-heading-massive">
                    <span class="rbhu-text-reveal">Empowering Industries</span><br>
                    <span class="rbhu-text-reveal rbhu-text-gradient-premium">With Precision Tools</span>
                </h1>

                <p class="rbhu-hero-subheading-large">
                    Authorized dealer of world-class industrial equipment. Delivering excellence<br class="d-none d-lg-block">
                    across pneumatics, power tools, and safety solutions for 22+ years.
                </p>

                <div class="rbhu-hero-cta-group">
                    <a href="#products" class="rbhu-btn-premium-primary">
                        <span>Explore Products</span>
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="rbhu-btn-premium-secondary">
                        <span>Get in Touch</span>
                    </a>
                </div>

                <div class="rbhu-hero-stats-inline">
                    <div class="rbhu-stat-inline">
                        <div class="rbhu-stat-value">22+</div>
                        <div class="rbhu-stat-label">Years Experience</div>
                    </div>
                    <div class="rbhu-stat-divider"></div>
                    <div class="rbhu-stat-inline">
                        <div class="rbhu-stat-value">500+</div>
                        <div class="rbhu-stat-label">Products</div>
                    </div>
                    <div class="rbhu-stat-divider"></div>
                    <div class="rbhu-stat-inline">
                        <div class="rbhu-stat-value">8+</div>
                        <div class="rbhu-stat-label">Industries</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="rbhu-hero-scroll-indicator">
            <div class="rbhu-scroll-icon">
                <div class="rbhu-scroll-wheel"></div>
            </div>
            <span>Scroll to explore</span>
