                        </svg>
                    </div>
                    <div class="rbhu-feature-text">
                        <h4>Fast Delivery</h4>
                        <p>Quick dispatch across Goa</p>
                    </div>
                </div>

                <div class="rbhu-feature-item">
                    <div class="rbhu-feature-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M17 8L21 12M21 12L17 16M21 12H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <div class="rbhu-feature-text">
                        <h4>Expert Support</h4>
                        <p>Technical guidance & consultation</p>
                    </div>
                </div>

                <div class="rbhu-feature-item">
                    <div class="rbhu-feature-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
