@{
    ViewData["Title"] = "About RBHU Solutions";
}

<link href="~/css/about.css" rel="stylesheet" />
<div class="rbhu-page-wrapper">
    <!-- Hero Banner -->
    <section class="rbhu-about-hero">
        <div class="rbhu-hero-overlay"></div>
        <div class="container">
            <div class="rbhu-hero-content">
                <span class="rbhu-hero-badge">Excellence Since 2022</span>
                <h1 class="rbhu-hero-title">Industrial Solutions Provider for Goa & Beyond</h1>
                <p class="rbhu-hero-subtitle">Delivering premium pneumatic tools, abrasives, power tools, and safety equipment to industries across India</p>
            </div>
        </div>
    </section>

    <!-- Company Introduction -->
    <section class="rbhu-intro-section">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6">
                    <div class="rbhu-intro-content">
                        <span class="rbhu-section-label">Who We Are</span>
                        <h2 class="rbhu-section-title">RBHU Solutions LLP</h2>
                        <div class="rbhu-divider"></div>
                        <p class="rbhu-intro-text">
                            RBHU Solutions LLP was founded by <strong>Mr. Rupesh Bothra</strong> and <strong>Mr. Aniket Pawashe</strong> to provide
                            industrial solutions to the Goa Industrial area. Our combined expertise brings over <strong>22 years of experience</strong>
                            in the industrial trading and services sector.
                        </p>
                        <p class="rbhu-intro-text">
                            Mr. Rupesh Bothra brings over 12 years of experience, having successfully established businesses in Pune, Kagal,
                            and Kolhapur MIDC areas. His enthusiastic and never-give-up attitude has played a pivotal role in fulfilling client needs.
                        </p>
                        <p class="rbhu-intro-text">
                            Mr. Aniket Pawashe, an MBA graduate with rich corporate and business experience, has established successful businesses
                            in industrial trading over the last decade at Belgaum, Hyderabad, Bangalore, and Hubli. His straightforward approach
                            and problem-solving skills ensure that client expectations are always exceeded.
                        </p>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="rbhu-image-stack">
                        <div class="rbhu-image-main">
                            <img src="~/images/rbhu-facility.jpg" alt="RBHU Solutions Facility" class="img-fluid">
                        </div>
                        <div class="rbhu-stats-card">
                            <div class="rbhu-stat-item">
                                <h3>22+</h3>
                                <p>Years Combined Experience</p>
                            </div>
                            <div class="rbhu-stat-divider"></div>
                            <div class="rbhu-stat-item">
                                <h3>8+</h3>
                                <p>Industries Served</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Founders Section -->
    <section class="rbhu-founders-section">
        <div class="container">
            <div class="text-center mb-5">
                <span class="rbhu-section-label">Leadership</span>
                <h2 class="rbhu-section-title">Meet Our Founders</h2>
            </div>
            <div class="row g-4 justify-content-center">
                <div class="col-lg-5 col-md-6">
                    <div class="rbhu-founder-card">
                        <div class="rbhu-founder-image">
                            <img src="~/images/founders/rupesh-bothra.jpg" alt="Rupesh Bothra">
                            <div class="rbhu-founder-overlay">
                                <a href="tel:9968068454" class="rbhu-founder-contact"><i class="fas fa-phone"></i></a>
                                <a href="mailto:rbhugoa@gmail.com" class="rbhu-founder-contact"><i class="fas fa-envelope"></i></a>
                            </div>
                        </div>
                        <div class="rbhu-founder-info">
                            <h3>Rupesh Bothra</h3>
                            <span class="rbhu-founder-role">Co-Founder & Designated Partner</span>
                            <p>Over 12 years of experience in industrial trading with successful ventures in Pune, Kagal, and Kolhapur MIDC areas.</p>
                            <div class="rbhu-founder-contact-info">
                                <i class="fas fa-phone-alt"></i> +91 9968068454
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5 col-md-6">
                    <div class="rbhu-founder-card">
                        <div class="rbhu-founder-image">
                            <img src="~/images/founders/aniket-pawashe.jpg" alt="Aniket Pawashe">
                            <div class="rbhu-founder-overlay">
                                <a href="tel:9108048901" class="rbhu-founder-contact"><i class="fas fa-phone"></i></a>
                                <a href="mailto:rbhugoa@gmail.com" class="rbhu-founder-contact"><i class="fas fa-envelope"></i></a>
                            </div>
                        </div>
                        <div class="rbhu-founder-info">
                            <h3>Aniket Pawashe</h3>
                            <span class="rbhu-founder-role">Co-Founder & Designated Partner</span>
                            <p>MBA graduate with 10+ years in industrial trading, establishing businesses in Belgaum, Hyderabad, Bangalore, and Hubli.</p>
                            <div class="rbhu-founder-contact-info">
                                <i class="fas fa-phone-alt"></i> +91 9108048901
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="rbhu-cta-section">
        <div class="container">
            <div class="rbhu-cta-content">
                <h2>Ready to Get Started?</h2>
                <p>Let our team of experts help you find the right industrial solutions for your business</p>
                <div class="rbhu-cta-buttons">
                    <a asp-area="" asp-controller="Home" asp-action="Contact" class="rbhu-btn rbhu-btn-primary">
                        Contact Us <i class="fas fa-arrow-right"></i>
                    </a>
                    <a asp-area="" asp-controller="Home" asp-action="Products" class="rbhu-btn rbhu-btn-secondary">
                        View Products <i class="fas fa-boxes"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    /* ==========================================
       ABOUT PAGE - MODERN FLAT THEME
       Keeping Original Structure
       ========================================== */

    .rbhu-page-wrapper {
        background: #fff;
        width: 100%;
        overflow-x: hidden;
    }

    /* ========== HERO SECTION ========== */
    .rbhu-about-hero {
        position: relative;
        padding: 140px 0 80px;
        background: linear-gradient(135deg, #1a1a1a 0%, #2c2c2c 100%);
        overflow: hidden;
    }

    .rbhu-hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: repeating-linear-gradient( 90deg, rgba(255, 255, 255, 0.02) 0px, transparent 1px, transparent 40px, rgba(255, 255, 255, 0.02) 41px );
    }

    .rbhu-hero-content {
        position: relative;
        z-index: 10;
        text-align: center;
        max-width: 800px;
        margin: 0 auto;
        color: #fff;
    }

    .rbhu-hero-badge {
        display: inline-block;
        padding: 8px 20px;
        background: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 0;
        margin-bottom: 24px;
        border: 2px solid #fff;
    }

    .rbhu-hero-title {
        font-size: clamp(32px, 5vw, 56px);
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 20px;
        color: #fff;
    }

    .rbhu-hero-subtitle {
        font-size: 18px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.9);
        max-width: 700px;
        margin: 0 auto;
    }

    /* ========== INTRO SECTION ========== */
    .rbhu-intro-section {
        padding: 100px 0;
        background: #fff;
    }

    .rbhu-intro-content {
        padding-right: 40px;
    }

    .rbhu-section-label {
        display: inline-block;
        padding: 6px 16px;
        background: #f8f9fa;
        color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        border-radius: 0;
        margin-bottom: 16px;
        border-left: 3px solid linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
    }

    .rbhu-section-title {
        font-size: clamp(28px, 4vw, 42px);
        font-weight: 700;
        color: #1a1a1a;
        line-height: 1.2;
        margin-bottom: 20px;
    }

    .rbhu-divider {
        width: 60px;
        height: 3px;
        background: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        margin: 24px 0;
    }

    .rbhu-intro-text {
        font-size: 16px;
        line-height: 1.8;
        color: #495057;
        margin-bottom: 20px;
    }

        .rbhu-intro-text strong {
            color: #1a1a1a;
            font-weight: 600;
        }

    /* Image Stack */
    .rbhu-image-stack {
        position: relative;
    }

    .rbhu-image-main {
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }

        .rbhu-image-main::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: 3px solid linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
            z-index: 1;
        }

        .rbhu-image-main img {
            width: 100%;
            height: auto;
            display: block;
            filter: grayscale(10%);
        }

    /* Stats Card */
    .rbhu-stats-card {
        position: absolute;
        bottom: -30px;
        left: -30px;
        background: #fff;
        padding: 24px 32px;
        display: flex;
        align-items: center;
        gap: 32px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        border-left: 4px solid linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
    }

    .rbhu-stat-item {
        text-align: center;
    }

        .rbhu-stat-item h3 {
            font-size: 36px;
            font-weight: 700;
            color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
            line-height: 1;
            margin-bottom: 8px;
            font-family: 'Roboto Condensed', sans-serif;
        }

        .rbhu-stat-item p {
            font-size: 12px;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
            margin: 0;
        }

    .rbhu-stat-divider {
        width: 2px;
        height: 50px;
        background: #e5e5e5;
    }

    /* ========== FOUNDERS SECTION ========== */
    .rbhu-founders-section {
        padding: 100px 0;
        background: #f8f9fa;
    }

    .rbhu-founder-card {
        background: #fff;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        position: relative;
        transition: box-shadow 0.3s ease;
    }

        .rbhu-founder-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        .rbhu-founder-card:hover::before {
            transform: scaleX(1);
        }

        .rbhu-founder-card:hover {
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
        }

    .rbhu-founder-image {
        position: relative;
        overflow: hidden;
        height: 360px;
        background: #f8f9fa;
    }

        .rbhu-founder-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: grayscale(20%);
            transition: filter 0.3s ease;
        }

    .rbhu-founder-card:hover .rbhu-founder-image img {
        filter: grayscale(0%);
    }

    .rbhu-founder-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .rbhu-founder-card:hover .rbhu-founder-overlay {
        opacity: 1;
    }

    .rbhu-founder-contact {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        font-size: 20px;
        text-decoration: none;
        border-radius: 0;
        border: 2px solid #fff;
        transition: all 0.3s ease;
    }

        .rbhu-founder-contact:hover {
            background: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
            color: #fff;
        }

    /* Founder Info */
    .rbhu-founder-info {
        padding: 32px 28px;
        border-left: 3px solid #f8f9fa;
        transition: border-color 0.3s ease;
    }

    .rbhu-founder-card:hover .rbhu-founder-info {
        border-left-color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
    }

    .rbhu-founder-info h3 {
        font-size: 24px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 8px;
    }

    .rbhu-founder-role {
        display: block;
        font-size: 13px;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 16px;
        font-weight: 600;
    }

    .rbhu-founder-info p {
        font-size: 15px;
        line-height: 1.7;
        color: #495057;
        margin-bottom: 20px;
    }

    .rbhu-founder-contact-info {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        background: #f8f9fa;
        border-left: 3px solid linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        font-size: 15px;
        color: #1a1a1a;
        font-weight: 600;
    }

        .rbhu-founder-contact-info i {
            color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
            font-size: 16px;
        }

    /* ========== CTA SECTION ========== */
    .rbhu-cta-section {
        position: relative;
        padding: 100px 0;
        background: #1a1a1a;
        overflow: hidden;
    }

        .rbhu-cta-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(0,0,0,0.9) 0%, rgba(224,4,32,0.3) 100%);
        }

    .rbhu-cta-content {
        position: relative;
        z-index: 10;
        text-align: center;
        max-width: 800px;
        margin: 0 auto;
        color: #fff;
    }

        .rbhu-cta-content h2 {
            font-size: clamp(28px, 5vw, 48px);
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 20px;
            color: #fff;
        }

        .rbhu-cta-content p {
            font-size: 18px;
            line-height: 1.7;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 40px;
        }

    .rbhu-cta-buttons {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .rbhu-btn {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 16px 32px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        border-radius: 0;
        border: 2px solid;
        transition: all 0.3s ease;
    }

    .rbhu-btn-primary {
        background: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        color: #fff;
        border-color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
    }

        .rbhu-btn-primary:hover {
            background: #fff;
            color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
            text-decoration: none;
        }

    .rbhu-btn-secondary {
        background: transparent;
        color: #fff;
        border-color: #fff;
    }

        .rbhu-btn-secondary:hover {
            background: #fff;
            color: #1a1a1a;
            text-decoration: none;
        }

    /* ========== RESPONSIVE DESIGN ========== */

    /* Tablets */
    @@media (max-width: 991px) {
        .rbhu-about-hero {
            padding: 120px 0 60px;
        }

        .rbhu-intro-section,
        .rbhu-founders-section {
            padding: 80px 0;
        }

        .rbhu-cta-section {
            padding: 80px 0;
        }

        .rbhu-intro-content {
            padding-right: 0;
            margin-bottom: 40px;
        }

        .rbhu-stats-card {
            position: static;
            margin-top: 20px;
        }
    }

    /* Mobile */
    @@media (max-width: 767px) {
        .rbhu-about-hero {
            padding: 100px 0 50px;
        }

        .rbhu-hero-badge {
            font-size: 12px;
            padding: 6px 16px;
        }

        .rbhu-intro-section,
        .rbhu-founders-section {
            padding: 60px 0;
        }

        .rbhu-cta-section {
            padding: 60px 0;
        }

        .rbhu-founder-image {
            height: 300px;
        }

        .rbhu-founder-info {
            padding: 24px 20px;
        }

        .rbhu-cta-buttons {
            flex-direction: column;
            width: 100%;
            padding: 0 20px;
        }

        .rbhu-btn {
            width: 100%;
            justify-content: center;
        }

        .rbhu-stats-card {
            flex-direction: column;
            gap: 20px;
            padding: 20px;
            left: 0;
            bottom: 0;
        }

        .rbhu-stat-divider {
            width: 50px;
            height: 2px;
        }
    }

    /* Small Mobile */
    @@media (max-width: 575px) {
        .rbhu-about-hero {
            padding: 90px 0 40px;
        }

        .rbhu-intro-section,
        .rbhu-founders-section {
            padding: 50px 0;
        }

        .rbhu-founder-image {
            height: 280px;
        }

        .rbhu-founder-info h3 {
            font-size: 20px;
        }

        .rbhu-founder-role {
            font-size: 12px;
        }

        .rbhu-founder-info p {
            font-size: 14px;
        }
    }

    /* Focus Styles */
    a:focus-visible {
        outline: 2px solid #FFA500;
        outline-offset: 2px;
        box-shadow: 0 0 0 4px rgba(255, 165, 0, 0.2);
    }
</style>