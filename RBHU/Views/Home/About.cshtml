@{
    ViewData["Title"] = "About RBHU Solutions";
}

<link href="~/css/about.css" rel="stylesheet" />
<div class="rbhu-page-wrapper">
    <!-- Hero Banner -->
    <section class="rbhu-about-hero">
        <div class="rbhu-hero-overlay"></div>
        <div class="container">
            <div class="rbhu-hero-content">
                <h1 class="rbhu-hero-title">Industrial Solutions Provider for Goa & Beyond</h1>
                <p class="rbhu-hero-subtitle">
                    Delivering premium PPE and Safety Equipment, Abrasives, Pneumatic Tools and Systems, Power Tools and Accessories to industries across India
                </p>
            </div>
        </div>
    </section>

    <!-- Company Introduction -->
    <section class="rbhu-intro-section">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-12">
                    <div class="rbhu-intro-content">
                        <span class="rbhu-section-label">Who We Are</span>
                        <h2 class="rbhu-section-title">RBHU Solutions LLP</h2>
                        <div class="rbhu-divider"></div>
                        <p class="rbhu-intro-text">
                            RBHU Solutions LLP was founded by <strong>Mr. Rupesh Bothra</strong> and <strong>Mr. Aniket Pawashe</strong> to provide
                            industrial solutions to the Goa Industrial area. Our combined expertise brings over <strong>22 years of experience</strong>
                            in the industrial trading and services sector.
                        </p>
                        <p class="rbhu-intro-text">
                            Mr. Rupesh Bothra brings over 12 years of experience, having successfully established businesses in Pune, Kagal,
                            and Kolhapur MIDC areas. His enthusiastic and never-give-up attitude has played a pivotal role in fulfilling client needs.
                        </p>
                        <p class="rbhu-intro-text">
                            Mr. Aniket Pawashe, an MBA graduate with rich corporate and business experience, has established successful businesses
                            in industrial trading over the last decade at Belgaum, Hyderabad, Bangalore, and Hubli. His straightforward approach
                            and problem-solving skills ensure that client expectations are always exceeded.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Founders Section -->
    <section class="rbhu-founders-section">
        <div class="container">
            <div class="text-center mb-5">
                <span class="rbhu-section-label">Leadership</span>
                <h2 class="rbhu-section-title">Meet Our Founders</h2>
                <div class="rbhu-divider mx-auto"></div>
            </div>
            <div class="row g-5 justify-content-center">
                <div class="col-lg-5 col-md-6">
                    <div class="rbhu-founder-card">
                        <div class="rbhu-founder-header">
                            <div class="rbhu-founder-image-wrapper">
                                <div class="rbhu-founder-image-circle">
                                    <img src="~/images/owners/rupesh.jpg" alt="Rupesh Bothra">
                                </div>
                            </div>
                            <div class="rbhu-founder-title-section">
                                <h3>Rupesh Bothra</h3>
                                <span class="rbhu-founder-role">Co-Founder & Designated Partner</span>
                            </div>
                        </div>
                        <div class="rbhu-founder-info">
                            <p>Over 12 years of experience in industrial trading with successful ventures in Pune, Kagal, and Kolhapur MIDC areas.</p>
                            <div class="rbhu-founder-contact-info">
                                <i class="fas fa-phone-alt"></i> +91 9968068454
                            </div>
                            <div class="rbhu-founder-social">
                                <a href="mailto:rbhugoa@gmail.com" class="rbhu-social-link">
                                    <i class="fas fa-envelope"></i>
                                </a>
                                <a href="https://www.linkedin.com/in/rupesh-bothra" target="_blank" class="rbhu-social-link">
                                    <i class="fab fa-linkedin"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5 col-md-6">
                    <div class="rbhu-founder-card">
                        <div class="rbhu-founder-header">
                            <div class="rbhu-founder-image-wrapper">
                                <div class="rbhu-founder-image-circle">
                                    <img src="~/images/owners/aniket.jpg" alt="Aniket Pawashe">
                                </div>
                            </div>
                            <div class="rbhu-founder-title-section">
                                <h3>Aniket Pawashe</h3>
                                <span class="rbhu-founder-role">Co-Founder & Designated Partner</span>
                            </div>
                        </div>
                        <div class="rbhu-founder-info">
                            <p>MBA graduate with 10+ years in industrial trading, establishing businesses in Belgaum, Hyderabad, Bangalore, and Hubli.</p>
                            <div class="rbhu-founder-contact-info">
                                <i class="fas fa-phone-alt"></i> +91 9108048901
                            </div>
                            <div class="rbhu-founder-social">
                                <a href="mailto:rbhugoa@gmail.com" class="rbhu-social-link">
                                    <i class="fas fa-envelope"></i>
                                </a>
                                <a href="https://www.linkedin.com/in/aniket-pawashe-8b478137/" target="_blank" class="rbhu-social-link">
                                    <i class="fab fa-linkedin"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Mission & Vision -->
    <section class="rbhu-mission-vision-section">
        <div class="container">
            <div class="text-center mb-5">
                <span class="rbhu-section-label">Our Purpose</span>
                <h2 class="rbhu-section-title">Mission & Vision</h2>
                <div class="rbhu-divider mx-auto"></div>
            </div>
            <div class="row g-5 justify-content-center">
                <div class="col-lg-5 col-md-6">
                    <div class="rbhu-value-card">
                        <div class="rbhu-value-icon">
                            <i class="fas fa-bullseye"></i>
                        </div>
                        <h3>Our Mission</h3>
                        <div class="rbhu-mini-divider"></div>
                        <p>To provide innovative, high-quality industrial tools and equipment that enhance productivity, safety, and efficiency in manufacturing processes worldwide.</p>
                    </div>
                </div>
                <div class="col-lg-5 col-md-6">
                    <div class="rbhu-value-card">
                        <div class="rbhu-value-icon">
                            <i class="fas fa-eye"></i>
                        </div>
                        <h3>Our Vision</h3>
                        <div class="rbhu-mini-divider"></div>
                        <p>To be the global leader in industrial manufacturing solutions, recognized for innovation, quality, and exceptional customer service in every market we serve.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Values -->
    <section class="rbhu-core-values-section">
        <div class="container">
            <div class="text-center mb-5">
                <span class="rbhu-section-label">Our Principles</span>
                <h2 class="rbhu-section-title">Our Core Values</h2>
                <div class="rbhu-divider mx-auto"></div>
            </div>
            <div class="row g-5 justify-content-center">
                <div class="col-lg-4 col-md-6">
                    <div class="rbhu-core-value-item">
                        <div class="rbhu-core-value-icon">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <h4>Quality First</h4>
                        <div class="rbhu-mini-divider"></div>
                        <p>Uncompromising commitment to quality in every product and service we deliver.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="rbhu-core-value-item">
                        <div class="rbhu-core-value-icon">
                            <i class="fas fa-lightbulb"></i>
                        </div>
                        <h4>Innovation</h4>
                        <div class="rbhu-mini-divider"></div>
                        <p>Continuously evolving and improving our products through cutting-edge technology.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="rbhu-core-value-item">
                        <div class="rbhu-core-value-icon">
                            <i class="fas fa-handshake"></i>
                        </div>
                        <h4>Trust</h4>
                        <div class="rbhu-mini-divider"></div>
                        <p>Building lasting relationships through reliability, transparency, and excellence.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>