@{
    ViewData["Title"] = "Products - RBHU Solutions LLP";
}

<link href="~/css/products.css" rel="stylesheet" />

<!-- Products Page with Professional Bosch Theme -->
<div class="products-wrapper">

    <!-- Hero Section -->
    <section class="products-hero-section">
        <div class="hero-overlay"></div>
        <div class="container">
            <div class="hero-content" data-aos="fade-up">
                <span class="hero-label">Our Product Range</span>
                <h1 class="hero-title">
                    Professional Industrial
                    <span class="title-accent">Tools & Equipment</span>
                </h1>
                <p class="hero-description">
                    Comprehensive range of premium industrial solutions from world-leading manufacturers
                </p>
            </div>
        </div>
    </section>

    <!-- Product Categories Grid -->
    <section class="products-grid-section">
        <div class="container">
            <div class="row g-4">
                <!-- Pneumatic Tools -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="product-card">
                        <a asp-controller="Product" asp-action="Pneumatic" class="card-link">
                            <div class="product-image-container">
                                <img src="~/images/products/pneumatic_general.png" alt="Pneumatic Tools" class="product-image">
                                <div class="image-overlay"></div>
                            </div>
                        </a>
                        <div class="product-content">
                            <div class="product-icon">
                                <i class="fas fa-wind"></i>
                            </div>
                            <h3 class="product-title">
                                <a asp-controller="Product" asp-action="Pneumatic">Pneumatic Tools & Systems</a>
                            </h3>
                            <p class="product-description">
                                High-performance pneumatic tools including air compressors, impact wrenches, and pneumatic drills for industrial applications.
                            </p>
                            <ul class="product-features">
                                <li>Air Impact Wrenches</li>
                                <li>Pneumatic Drills</li>
                                <li>Air Compressors</li>
                                <li>Pneumatic Sanders</li>
                            </ul>
                            <div class="product-badges">
                                <span class="badge badge-primary">Professional Grade</span>
                                <span class="badge badge-success">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Power Tools -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="product-card">
                        <a asp-controller="Product" asp-action="PowerTools" class="card-link">
                            <div class="product-image-container">
                                <img src="~/images/products/power_general2.jpg" alt="Power Tools" class="product-image">
                                <div class="image-overlay"></div>
                            </div>
                        </a>
                        <div class="product-content">
                            <div class="product-icon">
                                <i class="fas fa-bolt"></i>
                            </div>
                            <h3 class="product-title">
                                <a asp-controller="Product" asp-action="PowerTools">Power Tools & Accessories</a>
                            </h3>
                            <p class="product-description">
                                Electric and battery-powered tools designed for heavy-duty industrial use with superior performance and durability.
                            </p>
                            <ul class="product-features">
                                <li>Electric Drills</li>
                                <li>Angle Grinders</li>
                                <li>Circular Saws</li>
                                <li>Impact Drivers</li>
                            </ul>
                            <div class="product-badges">
                                <span class="badge badge-primary">Heavy Duty</span>
                                <span class="badge badge-success">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cutting Tools -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="product-card">
                        <a asp-controller="Product" asp-action="CuttingTools" class="card-link">
                            <div class="product-image-container">
                                <img src="~/images/products/cutting_general.jpg" alt="Cutting Tools" class="product-image">
                                <div class="image-overlay"></div>
                            </div>
                        </a>
                        <div class="product-content">
                            <div class="product-icon">
                                <i class="fas fa-cut"></i>
                            </div>
                            <h3 class="product-title">
                                <a asp-controller="Product" asp-action="CuttingTools">Precision Cutting Tools</a>
                            </h3>
                            <p class="product-description">
                                Precision cutting tools and blades for metal, wood, and composite materials. Built for accuracy and longevity.
                            </p>
                            <ul class="product-features">
                                <li>Carbide End Mills</li>
                                <li>HSS Drill Bits</li>
                                <li>Saw Blades</li>
                                <li>Router Bits</li>
                            </ul>
                            <div class="product-badges">
                                <span class="badge badge-primary">Precision</span>
                                <span class="badge badge-success">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Abrasives -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
                    <div class="product-card">
                        <a asp-controller="Product" asp-action="Abrasives" class="card-link">
                            <div class="product-image-container">
                                <img src="~/images/products/abrasive_general.jpg" alt="Abrasives" class="product-image">
                                <div class="image-overlay"></div>
                            </div>
                        </a>
                        <div class="product-content">
                            <div class="product-icon">
                                <i class="fas fa-circle-notch"></i>
                            </div>
                            <h3 class="product-title">
                                <a asp-controller="Product" asp-action="Abrasives">Industrial Abrasives</a>
                            </h3>
                            <p class="product-description">
                                Industrial-grade abrasive products including grinding wheels, sandpaper, and polishing compounds for surface finishing.
                            </p>
                            <ul class="product-features">
                                <li>Grinding Wheels</li>
                                <li>Sanding Discs</li>
                                <li>Wire Brushes</li>
                                <li>Polishing Compounds</li>
                            </ul>
                            <div class="product-badges">
                                <span class="badge badge-primary">Industrial Grade</span>
                                <span class="badge badge-success">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Safety Products -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="500">
                    <div class="product-card">
                        <a asp-controller="Product" asp-action="SafetyProducts" class="card-link">
                            <div class="product-image-container">
                                <img src="~/images/products/safety_general.jpg" alt="Safety Equipment" class="product-image">
                                <div class="image-overlay"></div>
                            </div>
                        </a>
                        <div class="product-content">
                            <div class="product-icon">
                                <i class="fas fa-hard-hat"></i>
                            </div>
                            <h3 class="product-title">
                                <a asp-controller="Product" asp-action="SafetyProducts">Safety Equipment</a>
                            </h3>
                            <p class="product-description">
                                Comprehensive safety equipment and protective gear to ensure workplace safety and regulatory compliance.
                            </p>
                            <ul class="product-features">
                                <li>Safety Helmets</li>
                                <li>Protective Eyewear</li>
                                <li>Work Gloves</li>
                                <li>Safety Harnesses</li>
                            </ul>
                            <div class="product-badges">
                                <span class="badge badge-primary">Safety First</span>
                                <span class="badge badge-success">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hoses -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="600">
                    <div class="product-card">
                        <a asp-controller="Product" asp-action="Hoses" class="card-link">
                            <div class="product-image-container">
                                <img src="~/images/products/Hoses-general.jpg" alt="Industrial Hoses" class="product-image">
                                <div class="image-overlay"></div>
                            </div>
                        </a>
                        <div class="product-content">
                            <div class="product-icon">
                                <i class="fas fa-cogs"></i>
                            </div>
                            <h3 class="product-title">
                                <a asp-controller="Product" asp-action="Hoses">Industrial Hoses</a>
                            </h3>
                            <p class="product-description">
                                Premium hydraulic and industrial hoses for reliable fluid transfer and high-pressure applications.
                            </p>
                            <ul class="product-features">
                                <li>Hydraulic Hoses</li>
                                <li>Air Hoses</li>
                                <li>Industrial Hoses</li>
                                <li>Hose Fittings</li>
                            </ul>
                            <div class="product-badges">
                                <span class="badge badge-primary">High Pressure</span>
                                <span class="badge badge-success">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Belts -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="700">
                    <div class="product-card">
                        <a asp-controller="Product" asp-action="Belts" class="card-link">
                            <div class="product-image-container">
                                <img src="~/images/products/belts_general.jpg" alt="Power Transmission Belts" class="product-image">
                                <div class="image-overlay"></div>
                            </div>
                        </a>
                        <div class="product-content">
                            <div class="product-icon">
                                <i class="fas fa-sync-alt"></i>
                            </div>
                            <h3 class="product-title">
                                <a asp-controller="Product" asp-action="Belts">Power Transmission Belts</a>
                            </h3>
                            <p class="product-description">
                                High-performance power transmission belts for industrial and automotive applications with superior durability.
                            </p>
                            <ul class="product-features">
                                <li>V-Belts</li>
                                <li>Timing Belts</li>
                                <li>Flat Belts</li>
                                <li>Serpentine Belts</li>
                            </ul>
                            <div class="product-badges">
                                <span class="badge badge-primary">Heavy Duty</span>
                                <span class="badge badge-success">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-highlight-section">
        <div class="container">
            <div class="section-header" data-aos="fade-up">
                <span class="section-label">Why Choose Us</span>
                <h2 class="section-title">
                    Excellence in Every
                    <span class="title-accent">Product</span>
                </h2>
            </div>

            <div class="row g-4 mt-4">
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="feature-highlight-box">
                        <div class="feature-highlight-icon">
                            <i class="fas fa-certificate"></i>
                        </div>
                        <h4>Certified Quality</h4>
                        <p>All products are ISO certified and meet international quality standards</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="feature-highlight-box">
                        <div class="feature-highlight-icon">
                            <i class="fas fa-shipping-fast"></i>
                        </div>
                        <h4>Fast Delivery</h4>
                        <p>Quick and reliable delivery to your doorstep with tracking support</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="feature-highlight-box">
                        <div class="feature-highlight-icon">
                            <i class="fas fa-headset"></i>
                        </div>
                        <h4>Expert Support</h4>
                        <p>Technical assistance and product guidance from our expert team</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
                    <div class="feature-highlight-box">
                        <div class="feature-highlight-icon">
                            <i class="fas fa-medal"></i>
                        </div>
                        <h4>Warranty Coverage</h4>
                        <p>Comprehensive warranty coverage on all our industrial products</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="products-cta-section">
        <div class="cta-background-overlay"></div>
        <div class="container">
            <div class="cta-content" data-aos="fade-up">
                <h2 class="cta-title">
                    Need Custom
                    <span class="title-accent">Industrial Solutions?</span>
                </h2>
                <p class="cta-description">
                    We offer customized industrial tool solutions tailored to your specific requirements
                </p>
                <div class="cta-buttons">
                    <a asp-controller="Home" asp-action="Contact" class="btn-cta-primary">
                        <i class="fas fa-envelope"></i>
                        <span>Contact Us</span>
                    </a>
                    <a asp-controller="Home" asp-action="Offers" class="btn-cta-secondary">
                        <i class="fas fa-tags"></i>
                        <span>View Special Offers</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

</div>
    
                        <style>
    /* ==========================================
       PRODUCTS PAGE - PROFESSIONAL BOSCH THEME
       Clean, Modern, Industrial Excellence
       ========================================== */

    .products-wrapper {
        background: #fff;
        width: 100%;
        overflow-x: hidden;
    }

    /* ========== PRODUCTS HERO SECTION ========== */
    .products-hero-section {
        position: relative;
        padding: 140px 0 80px;
        background: linear-gradient(135deg, #1a1a1a 0%, #2c2c2c 100%);
        overflow: hidden;
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: repeating-linear-gradient( 90deg, rgba(255, 255, 255, 0.02) 0px, transparent 1px, transparent 40px, rgba(255, 255, 255, 0.02) 41px );
    }

    .hero-content {
        position: relative;
        z-index: 10;
        text-align: center;
        max-width: 800px;
        margin: 0 auto;
        color: #fff;
    }

    .hero-label {
        display: inline-block;
        padding: 8px 20px;
        background: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 4px;
        margin-bottom: 24px;
    }

    .hero-title {
        font-size: clamp(32px, 5vw, 56px);
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 20px;
        color: #fff;
    }

    .title-accent {
        color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        display: block;
        margin-top: 8px;
    }

    .hero-description {
        font-size: 18px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.9);
        max-width: 700px;
        margin: 0 auto;
    }

    /* ========== PRODUCTS GRID SECTION ========== */
    .products-grid-section {
        padding: 80px 0;
        background: #fff;
    }

    /* Product Cards - Modern Side Accent Design */
    .product-card {
        background: #fff;
        border: none;
        border-radius: 0;
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        position: relative;
        transition: box-shadow 0.3s ease;
    }

        .product-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
            transform: scaleY(0);
            transform-origin: bottom;
            transition: transform 0.3s ease;
        }

        .product-card:hover {
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        }

            .product-card:hover::before {
                transform: scaleY(1);
            }

    .card-link {
        display: block;
        text-decoration: none;
        position: relative;
    }

    .product-image-container {
        position: relative;
        height: 220px;
        overflow: hidden;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(20%);
        transition: filter 0.3s ease;
    }

    .product-card:hover .product-image {
        filter: grayscale(0%);
    }

    .image-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 60px;
        background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
    }

    /* Product Content */
    .product-content {
        padding: 28px 24px 24px;
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    .product-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        font-size: 22px;
        border-radius: 0;
        margin-bottom: 16px;
        border-left: 3px solid linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        padding-left: 8px;
    }

    .product-card:hover .product-icon {
        background: #fff5f5;
    }

    .product-title {
        font-size: 18px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 12px;
        min-height: 50px;
        line-height: 1.4;
        text-transform: uppercase;
        letter-spacing: -0.5px;
    }

        .product-title a {
            color: #1a1a1a;
            text-decoration: none;
            transition: color 0.3s ease;
        }

            .product-title a:hover {
                color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
            }

    .product-description {
        font-size: 14px;
        color: #6c757d;
        line-height: 1.7;
        margin-bottom: 16px;
        min-height: 75px;
    }

    .product-features {
        list-style: none;
        padding: 12px 16px;
        margin: 0 0 20px;
        min-height: 88px;
        background: #f8f9fa;
        border-radius: 4px;
    }

        .product-features li {
            font-size: 14px;
            color: #495057;
            padding: 6px 0;
            padding-left: 24px;
            position: relative;
            line-height: 1.5;
        }

            .product-features li::before {
                content: '✓';
                position: absolute;
                left: 0;
                color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
                font-weight: bold;
                font-size: 16px;
            }

    /* Product Badges */
    .product-badges {
        margin-top: auto;
        padding-top: 16px;
        border-top: 2px solid #f0f0f0;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .badge {
        padding: 8px 14px;
        font-size: 11px;
        font-weight: 700;
        border-radius: 0;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        border: 2px solid;
    }

    .badge-primary {
        background: #fff;
        color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        border-color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
    }

    .badge-success {
        background: #fff;
        color: #16a34a;
        border-color: #16a34a;
    }

    /* ========== FEATURES HIGHLIGHT SECTION ========== */
    .features-highlight-section {
        padding: 80px 0;
        background: #f8f9fa;
    }

    .section-header {
        text-align: center;
        max-width: 700px;
        margin: 0 auto 60px;
    }

    .section-label {
        display: inline-block;
        padding: 6px 16px;
        background: #fff5f5;
        color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 20px;
        margin-bottom: 16px;
    }

    .section-title {
        font-size: clamp(28px, 4vw, 42px);
        font-weight: 700;
        color: #2c3e50;
        line-height: 1.3;
    }

    .feature-highlight-box {
        background: #fff;
        padding: 36px 24px;
        border: none;
        border-radius: 0;
        text-align: center;
        height: 100%;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        position: relative;
        overflow: hidden;
    }

        .feature-highlight-box::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        .feature-highlight-box:hover::after {
            transform: scaleX(1);
        }

        .feature-highlight-box:hover {
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        }

    .feature-highlight-icon {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        color: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        font-size: 32px;
        border-radius: 0;
        margin: 0 auto 24px;
        border: 3px solid linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
    }

    .feature-highlight-box h4 {
        font-size: 18px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: -0.5px;
    }

    .feature-highlight-box p {
        font-size: 14px;
        color: #6c757d;
        line-height: 1.7;
        margin: 0;
    }

    /* ========== CTA SECTION ========== */
    .products-cta-section {
        position: relative;
        padding: 100px 0;
        background: #1a1a1a;
        overflow: hidden;
    }

    .cta-background-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(0,0,0,0.9) 0%, rgba(224,4,32,0.3) 100%);
    }

    .cta-content {
        position: relative;
        z-index: 10;
        text-align: center;
        max-width: 800px;
        margin: 0 auto;
        color: #fff;
    }

    .cta-title {
        font-size: clamp(28px, 5vw, 48px);
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 20px;
        color: #fff;
    }

    .cta-description {
        font-size: 18px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 40px;
    }

    .cta-buttons {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-cta-primary {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 16px 32px;
        background: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        color: #fff;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

        .btn-cta-primary:hover {
            background: #004F8C;
