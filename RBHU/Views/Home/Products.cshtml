@{
    ViewData["Title"] = "Products - RBHU Solutions LLP";
}

<!-- Products Page with Professional Industrial Theme -->
<div class="products-page-wrapper">

    <!-- Hero Section -->
    <section class="products-hero">
        <div class="hero-background-overlay"></div>
        <div class="container">
            <div class="hero-content-wrapper" data-aos="fade-up">
                <div class="hero-badge">Our Product Range</div>
                <h1 class="hero-main-title">
                    Professional Industrial
                    <span class="title-highlight">Tools & Equipment</span>
                </h1>
                <p class="hero-subtitle">
                    Comprehensive range of premium industrial solutions from world-leading manufacturers
                </p>
            </div>
        </div>
    </section>

    <!-- Product Categories Grid -->
    <section class="products-catalog-section">
        <div class="container">
            <div class="row g-4">
                <!-- Pneumatic Tools -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="product-category-card">
                        <a asp-controller="Product" asp-action="Pneumatic" class="category-card-link">
                            <div class="category-image1-wrapper">
                                <img src="~/images/products/pneumatic_general.png" alt="Pneumatic Tools" class="category-image1">
                                <div class="category-image1-gradient"></div>
                            </div>
                        </a>
                        <div class="category-card-body">
                            <div class="category-icon-wrapper">
                                <i class="fas fa-wind"></i>
                            </div>
                            <h3 class="category-card-title">
                                <a asp-controller="Product" asp-action="Pneumatic">Pneumatic Tools & Systems</a>
                            </h3>
                            <p class="category-card-description">
                                High-performance pneumatic tools including air compressors, impact wrenches, and pneumatic drills for industrial applications.
                            </p>
                            <ul class="category-feature-list">
                                <li>Air Impact Wrenches</li>
                                <li>Pneumatic Drills</li>
                                <li>Air Compressors</li>
                                <li>Pneumatic Sanders</li>
                            </ul>
                            <div class="category-status-badges">
                                <span class="status-badge badge-professional">Professional Grade</span>
                                <span class="status-badge badge-available">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Power Tools -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="product-category-card">
                        <a asp-controller="Product" asp-action="PowerTools" class="category-card-link">
                            <div class="category-image1-wrapper">
                                <img src="~/images/products/power_general2.jpg" alt="Power Tools" class="category-image1">
                                <div class="category-image1-gradient"></div>
                            </div>
                        </a>
                        <div class="category-card-body">
                            <div class="category-icon-wrapper">
                                <i class="fas fa-bolt"></i>
                            </div>
                            <h3 class="category-card-title">
                                <a asp-controller="Product" asp-action="PowerTools">Power Tools & Accessories</a>
                            </h3>
                            <p class="category-card-description">
                                Electric and battery-powered tools designed for heavy-duty industrial use with superior performance and durability.
                            </p>
                            <ul class="category-feature-list">
                                <li>Electric Drills</li>
                                <li>Angle Grinders</li>
                                <li>Circular Saws</li>
                                <li>Impact Drivers</li>
                            </ul>
                            <div class="category-status-badges">
                                <span class="status-badge badge-professional">Heavy Duty</span>
                                <span class="status-badge badge-available">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cutting Tools -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="product-category-card">
                        <a asp-controller="Product" asp-action="CuttingTools" class="category-card-link">
                            <div class="category-image1-wrapper">
                                <img src="~/images/products/cutting_general.jpg" alt="Cutting Tools" class="category-image1">
                                <div class="category-image1-gradient"></div>
                            </div>
                        </a>
                        <div class="category-card-body">
                            <div class="category-icon-wrapper">
                                <i class="fas fa-cut"></i>
                            </div>
                            <h3 class="category-card-title">
                                <a asp-controller="Product" asp-action="CuttingTools">Precision Cutting Tools</a>
                            </h3>
                            <p class="category-card-description">
                                Precision cutting tools and blades for metal, wood, and composite materials. Built for accuracy and longevity.
                            </p>
                            <ul class="category-feature-list">
                                <li>Carbide End Mills</li>
                                <li>HSS Drill Bits</li>
                                <li>Saw Blades</li>
                                <li>Router Bits</li>
                            </ul>
                            <div class="category-status-badges">
                                <span class="status-badge badge-professional">Precision</span>
                                <span class="status-badge badge-available">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Abrasives -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
                    <div class="product-category-card">
                        <a asp-controller="Product" asp-action="Abrasives" class="category-card-link">
                            <div class="category-image1-wrapper">
                                <img src="~/images/products/abrasive_general.jpg" alt="Abrasives" class="category-image1">
                                <div class="category-image1-gradient"></div>
                            </div>
                        </a>
                        <div class="category-card-body">
                            <div class="category-icon-wrapper">
                                <i class="fas fa-circle-notch"></i>
                            </div>
                            <h3 class="category-card-title">
                                <a asp-controller="Product" asp-action="Abrasives">Industrial Abrasives</a>
                            </h3>
                            <p class="category-card-description">
                                Industrial-grade abrasive products including grinding wheels, sandpaper, and polishing compounds for surface finishing.
                            </p>
                            <ul class="category-feature-list">
                                <li>Grinding Wheels</li>
                                <li>Sanding Discs</li>
                                <li>Wire Brushes</li>
                                <li>Polishing Compounds</li>
                            </ul>
                            <div class="category-status-badges">
                                <span class="status-badge badge-professional">Industrial Grade</span>
                                <span class="status-badge badge-available">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Safety Products -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="500">
                    <div class="product-category-card">
                        <a asp-controller="Product" asp-action="SafetyProducts" class="category-card-link">
                            <div class="category-image1-wrapper">
                                <img src="~/images/products/safety_general.jpg" alt="Safety Equipment" class="category-image1">
                                <div class="category-image1-gradient"></div>
                            </div>
                        </a>
                        <div class="category-card-body">
                            <div class="category-icon-wrapper">
                                <i class="fas fa-hard-hat"></i>
                            </div>
                            <h3 class="category-card-title">
                                <a asp-controller="Product" asp-action="SafetyProducts">Safety Equipment</a>
                            </h3>
                            <p class="category-card-description">
                                Comprehensive safety equipment and protective gear to ensure workplace safety and regulatory compliance.
                            </p>
                            <ul class="category-feature-list">
                                <li>Safety Helmets</li>
                                <li>Protective Eyewear</li>
                                <li>Work Gloves</li>
                                <li>Safety Harnesses</li>
                            </ul>
                            <div class="category-status-badges">
                                <span class="status-badge badge-professional">Safety First</span>
                                <span class="status-badge badge-available">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hoses -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="600">
                    <div class="product-category-card">
                        <a asp-controller="Product" asp-action="Hoses" class="category-card-link">
                            <div class="category-image1-wrapper">
                                <img src="~/images/products/Hoses-general.jpg" alt="Industrial Hoses" class="category-image1">
                                <div class="category-image1-gradient"></div>
                            </div>
                        </a>
                        <div class="category-card-body">
                            <div class="category-icon-wrapper">
                                <i class="fas fa-cogs"></i>
                            </div>
                            <h3 class="category-card-title">
                                <a asp-controller="Product" asp-action="Hoses">Industrial Hoses</a>
                            </h3>
                            <p class="category-card-description">
                                Premium hydraulic and industrial hoses for reliable fluid transfer and high-pressure applications.
                            </p>
                            <ul class="category-feature-list">
                                <li>Hydraulic Hoses</li>
                                <li>Air Hoses</li>
                                <li>Industrial Hoses</li>
                                <li>Hose Fittings</li>
                            </ul>
                            <div class="category-status-badges">
                                <span class="status-badge badge-professional">High Pressure</span>
                                <span class="status-badge badge-available">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Belts -->
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="700">
                    <div class="product-category-card">
                        <a asp-controller="Product" asp-action="Belts" class="category-card-link">
                            <div class="category-image1-wrapper">
                                <img src="~/images/products/belts_general.jpg" alt="Power Transmission Belts" class="category-image1">
                                <div class="category-image1-gradient"></div>
                            </div>
                        </a>
                        <div class="category-card-body">
                            <div class="category-icon-wrapper">
                                <i class="fas fa-sync-alt"></i>
                            </div>
                            <h3 class="category-card-title">
                                <a asp-controller="Product" asp-action="Belts">Power Transmission Belts</a>
                            </h3>
                            <p class="category-card-description">
                                High-performance power transmission belts for industrial and automotive applications with superior durability.
                            </p>
                            <ul class="category-feature-list">
                                <li>V-Belts</li>
                                <li>Timing Belts</li>
                                <li>Flat Belts</li>
                                <li>Serpentine Belts</li>
                            </ul>
                            <div class="category-status-badges">
                                <span class="status-badge badge-professional">Heavy Duty</span>
                                <span class="status-badge badge-available">In Stock</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Value Proposition Section -->
    <section class="value-proposition-section">
        <div class="container">
            <div class="section-header-center" data-aos="fade-up">
                <div class="section-tag">Why Choose Us</div>
                <h2 class="section-main-title">
                    Excellence in Every
                    <span class="title-highlight">Product</span>
                </h2>
                <p class="section-description">
                    Your trusted partner for premium industrial tools and equipment
                </p>
            </div>

            <div class="row g-4 mt-4">
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="value-prop-card">
                        <div class="value-icon-container">
                            <i class="fas fa-certificate"></i>
                        </div>
                        <h4 class="value-card-title">Certified Quality</h4>
                        <p class="value-card-text">All products are ISO certified and meet international quality standards</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="value-prop-card">
                        <div class="value-icon-container">
                            <i class="fas fa-shipping-fast"></i>
                        </div>
                        <h4 class="value-card-title">Fast Delivery</h4>
                        <p class="value-card-text">Quick and reliable delivery to your doorstep with tracking support</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="value-prop-card">
                        <div class="value-icon-container">
                            <i class="fas fa-headset"></i>
                        </div>
                        <h4 class="value-card-title">Expert Support</h4>
                        <p class="value-card-text">Technical assistance and product guidance from our expert team</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
                    <div class="value-prop-card">
                        <div class="value-icon-container">
                            <i class="fas fa-medal"></i>
                        </div>
                        <h4 class="value-card-title">Warranty Coverage</h4>
                        <p class="value-card-text">Comprehensive warranty coverage on all our industrial products</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Call to Action Section -->
    <section class="products-cta-section">
        <div class="cta-overlay"></div>
        <div class="container">
            <div class="cta-content-wrapper" data-aos="fade-up">
                <h2 class="cta-main-title">
                    Need Custom
                    <span class="title-highlight">Industrial Solutions?</span>
                </h2>
                <p class="cta-subtitle">
                    We offer customized industrial tool solutions tailored to your specific requirements
                </p>
                <div class="cta-action-buttons">
                    <a asp-controller="Home" asp-action="Contact" class="cta-btn cta-btn-primary">
                        <i class="fas fa-envelope"></i>
                        <span>Contact Us</span>
                    </a>
                    <a asp-controller="Home" asp-action="Offers" class="cta-btn cta-btn-secondary">
                        <i class="fas fa-tags"></i>
                        <span>View Special Offers</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

</div>

<style>
    /* ==========================================
       PRODUCTS PAGE - PROFESSIONAL STYLING
       Clean, Modern, Industrial B2B Design
       ========================================== */

    .products-page-wrapper {
        background: var(--white);
        width: 100%;
        overflow-x: hidden;
    }

    /* ========== HERO SECTION ========== */
    .products-hero {
        position: relative;
        padding: 120px 0 70px;
        background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 50%, #1a1a1a 100%);
        overflow: hidden;
    }

    .hero-background-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.03) 0px, transparent 1px, transparent 40px, rgba(255, 255, 255, 0.03) 41px), repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.03) 0px, transparent 1px, transparent 40px, rgba(255, 255, 255, 0.03) 41px);
        opacity: 0.5;
    }

    .hero-content-wrapper {
        position: relative;
        z-index: 10;
        text-align: center;
        max-width: 850px;
        margin: 0 auto;
    }

    .hero-badge {
        display: inline-block;
        padding: 10px 24px;
        background: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        color: var(--white);
        font-family: 'Inter', sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        border-radius: 4px;
        margin-bottom: 28px;
        box-shadow: 0 4px 12px rgba(0, 102, 179, 0.3);
    }

    .hero-main-title {
        font-family: 'Poppins', sans-serif;
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 24px;
        color: var(--white);
    }

    .title-highlight {
        display: block;
        background: linear-gradient(135deg, #21a0a0 0%, #5ce1e6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-top: 8px;
    }

    .hero-subtitle {
        font-family: 'Inter', sans-serif;
        font-size: 1.125rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.9);
        max-width: 650px;
        margin: 0 auto;
    }

    /* ========== PRODUCTS CATALOG SECTION ========== */
    .products-catalog-section {
        padding: 80px 0;
        background: var(--white);
    }

    /* Product Category Cards */
    .product-category-card {
        background: var(--white);
        border-radius: 8px;
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        position: relative;
    }

        .product-category-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
            transform: scaleY(0);
            transform-origin: bottom;
            transition: transform 0.3s ease;
        }

        .product-category-card:hover {
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.15);
            transform: translateY(-4px);
        }

            .product-category-card:hover::before {
                transform: scaleY(1);
            }

    .category-card-link {
        display: block;
        text-decoration: none;
    }

    .category-image1-wrapper {
        position: relative;
        height: 220px;
        overflow: hidden;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .category-image1 {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .product-category-card:hover .category-image1 {
        transform: scale(1.08);
    }

    .category-image1-gradient {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 80px;
        background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
        pointer-events: none;
    }

    /* Category Card Body */
    .category-card-body {
        padding: 28px 24px 24px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .category-icon-wrapper {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--gray-100) 0%, var(--gray-200) 100%);
        color: var(--bosch-red);
        font-size: 26px;
        border-radius: 8px;
        margin-bottom: 18px;
        border: 2px solid var(--bosch-red);
        transition: all 0.3s ease;
    }

    .product-category-card:hover .category-icon-wrapper {
        background: linear-gradient(135deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
        color: var(--white);
        transform: rotate(5deg) scale(1.05);
    }

    .category-card-title {
        font-family: 'Poppins', sans-serif;
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--gray-900);
        margin-bottom: 14px;
        min-height: 54px;
        line-height: 1.4;
        letter-spacing: -0.02em;
    }

        .category-card-title a {
            color: var(--gray-900);
            text-decoration: none;
            transition: color 0.3s ease;
        }

            .category-card-title a:hover {
                color: var(--bosch-red);
            }

    .category-card-description {
        font-family: 'Inter', sans-serif;
        font-size: 0.9375rem;
        color: var(--gray-600);
        line-height: 1.7;
        margin-bottom: 18px;
        min-height: 80px;
    }

    .category-feature-list {
        list-style: none;
        padding: 14px 18px;
        margin: 0 0 20px;
        min-height: 96px;
        background: var(--gray-50);
        border-radius: 6px;
        border-left: 3px solid var(--bosch-red);
    }

        .category-feature-list li {
            font-family: 'Inter', sans-serif;
            font-size: 0.875rem;
            color: var(--gray-700);
            padding: 6px 0 6px 26px;
            position: relative;
            line-height: 1.5;
        }

            .category-feature-list li::before {
                content: '✓';
                position: absolute;
                left: 0;
                color: var(--bosch-red);
                font-weight: bold;
                font-size: 16px;
            }

    /* Category Status Badges */
    .category-status-badges {
        margin-top: auto;
        padding-top: 18px;
        border-top: 2px solid var(--gray-200);
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .status-badge {
        padding: 8px 16px;
        font-family: 'Inter', sans-serif;
        font-size: 0.6875rem;
        font-weight: 700;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        border: 2px solid;
        transition: all 0.3s ease;
    }

    .badge-professional {
        background: var(--white);
        color: var(--bosch-red);
        border-color: var(--bosch-red);
    }

    .badge-available {
        background: var(--white);
        color: #16a34a;
        border-color: #16a34a;
    }

    .product-category-card:hover .badge-professional {
        background: var(--bosch-red);
        color: var(--white);
    }

    .product-category-card:hover .badge-available {
        background: #16a34a;
        color: var(--white);
    }

    /* ========== VALUE PROPOSITION SECTION ========== */
    .value-proposition-section {
        padding: 80px 0;
        background: linear-gradient(135deg, var(--gray-50) 0%, var(--white) 100%);
    }

    .section-header-center {
        text-align: center;
        max-width: 750px;
        margin: 0 auto 50px;
    }

    .section-tag {
        display: inline-block;
        padding: 8px 20px;
        background: rgba(0, 102, 179, 0.1);
        color: var(--bosch-red);
        font-family: 'Inter', sans-serif;
        font-size: 0.8125rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        border-radius: 20px;
        margin-bottom: 18px;
    }

    .section-main-title {
        font-family: 'Poppins', sans-serif;
        font-size: clamp(1.75rem, 4vw, 2.625rem);
        font-weight: 700;
        color: var(--gray-900);
        line-height: 1.3;
        margin-bottom: 16px;
    }

    .section-description {
        font-family: 'Inter', sans-serif;
        font-size: 1rem;
        color: var(--gray-600);
        line-height: 1.7;
        margin: 0;
    }

    .value-prop-card {
        background: var(--white);
        padding: 38px 28px;
        border-radius: 8px;
        text-align: center;
        height: 100%;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }

        .value-prop-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--bosch-red) 0%, var(--bosch-red-light) 100%);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        .value-prop-card:hover {
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.15);
            transform: translateY(-6px);
        }

            .value-prop-card:hover::after {
                transform: scaleX(1);
            }

    .value-icon-container {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--gray-100) 0%, var(--gray-200) 100%);
        color: var(--bosch-red);
        font-size: 36px;
        border-radius: 50%;
        margin: 0 auto 24px;
        border: 3px solid var(--bosch-red);
        transition: all 0.3s ease;
