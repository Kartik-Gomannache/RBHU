                                <label for="Company" class="form-label">Company Name</label>
                                <input id="Company" name="Company" class="form-control" placeholder="Enter your company name" />
                                <div class="invalid-feedback"></div>
                            </div>

                            <div class="mb-3">
                                <label for="Subject" class="form-label">Subject *</label>
                                <select id="Subject" name="Subject" class="form-control">
                                    <option value="">Select Subject</option>
                                    <option value="Product Inquiry">Product Inquiry</option>
                                    <option value="Bulk Order">Bulk Order</option>
                                    <option value="Technical Support">Technical Support</option>
                                    <option value="Partnership Opportunity">Partnership Opportunity</option>
                                    <option value="Warranty Claim">Warranty Claim</option>
                                    <option value="Other">Other</option>
                                </select>
                                <div class="invalid-feedback"></div>
                            </div>

                            <div class="mb-4">
                                <label for="Message" class="form-label">Message *</label>
                                <textarea id="Message" name="Message" class="form-control" rows="5" placeholder="Please describe your requirements in detail..."></textarea>
                                <div class="invalid-feedback"></div>
                            </div>

                            <button type="button" id="submitBtn" class="btn btn-submit btn-primary" onclick="sendContactEmail()">
